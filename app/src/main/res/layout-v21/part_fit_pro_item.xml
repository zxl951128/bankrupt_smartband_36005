<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:id="@+id/ll_item_bottom"
        android:background="@color/white"
        android:paddingLeft="35dp"
        android:paddingRight="25dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/rl_item_title"
        android:elevation="3dp">
        <cn.ginshell.bong.ui.widget.FitIndicatorView
            android:id="@+id/indicator_view"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"/>
        <View
            android:id="@+id/advice_line"
            android:layout_marginTop="5dp"
            style="@style/DividerLine"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="20dp"
                android:textColor="@color/red_1"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="6dp"
                android:text="@string/icon_tips"
                style="@style/ItemIconText"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/black"
                android:id="@+id/tv_advice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:text="体重很标准哦~记得三"
                android:lineSpacingMultiplier="1.2"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl_item_title"
        android:background="@drawable/selector_btn_white"
        android:paddingLeft="15dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:translationZ="3dp">
        <ImageView
            android:id="@+id/item_iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/fit_icon_bmi"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:id="@+id/item_tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="脂肪"
            android:layout_toRightOf="@+id/item_iv_logo"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:id="@+id/item_tv_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="23.4"
            android:layout_toRightOf="@+id/item_tv_name"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/black"
            android:id="@+id/item_tv_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="%"
            android:layout_toRightOf="@+id/item_tv_value"
            android:layout_alignBottom="@+id/item_tv_value"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/item_tv_state"
            android:background="@drawable/f_state_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/f_normal"
            android:layout_toRightOf="@+id/item_tv_unit"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_right_data"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/item_tv_state">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/item_tv_right_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="蛋白量"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/black"
                android:id="@+id/item_tv_right_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="23.4"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/black"
                android:layout_gravity="bottom"
                android:id="@+id/item_tv_right_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="kg"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/item_down_or_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:src="@drawable/bth_dropdown"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <View
            android:id="@+id/item_line"
            android:layout_marginLeft="32dp"
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </RelativeLayout>
</RelativeLayout>
