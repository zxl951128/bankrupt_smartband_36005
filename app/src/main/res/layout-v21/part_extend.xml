<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:textSize="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:text="@string/dis_yly"
            style="@style/CommonText.Black"/>
        <HorizontalScrollView
            android:layout_gravity="center_horizontal"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/discover_width">
                    <ImageView
                        android:id="@+id/iv_group"
                        android:background="@drawable/circle_discover_bg"
                        android:padding="1px"
                        android:layout_width="@dimen/extend_img_width"
                        android:layout_height="@dimen/extend_img_width"
                        android:layout_marginTop="11dp"
                        android:src="@drawable/icon_group_img"/>
                    <TextView
                        android:textSize="13dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/group"
                        style="@style/CommonText.Black"/>
                </LinearLayout>
                <cn.ginshell.bong.ui.view.report.BubbleTipView
                    android:id="@+id/bubble_tip_view"
                    android:visibility="invisible"
                    android:layout_width="80dp"
                    android:layout_height="22dp"
                    android:layout_marginLeft="-60dp"
                    android:layout_toRightOf="@+id/ll_dragon"
                    android:translationZ="1dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_dragon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/discover_width"
                    android:layout_toRightOf="@+id/ll_group">
                    <ImageView
                        android:id="@+id/iv_dragon"
                        android:background="@drawable/circle_discover_bg"
                        android:padding="1px"
                        android:layout_width="@dimen/extend_img_width"
                        android:layout_height="@dimen/extend_img_width"
                        android:layout_marginTop="11dp"
                        android:src="@drawable/icon_pet"
                        android:layout_centerHorizontal="true"/>
                    <TextView
                        android:textSize="13dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/bong_dragon"
                        android:layout_below="@+id/iv_dragon"
                        android:layout_centerHorizontal="true"
                        style="@style/CommonText.Black"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_bububao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/discover_width"
                    android:layout_toRightOf="@+id/ll_dragon">
                    <ImageView
                        android:id="@+id/iv_bububao"
                        android:background="@drawable/circle_discover_bg"
                        android:padding="1px"
                        android:layout_width="@dimen/extend_img_width"
                        android:layout_height="@dimen/extend_img_width"
                        android:layout_marginTop="11dp"
                        android:src="@drawable/icon_bububao"/>
                    <TextView
                        android:textSize="13dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/dis_bububao"
                        style="@style/CommonText.Black"/>
                </LinearLayout>
            </RelativeLayout>
        </HorizontalScrollView>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:textSize="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/dis_fls"
            style="@style/CommonText.Black"/>
        <ImageView
            android:id="@+id/img_fls"
            android:background="@color/white_c"
            android:padding="1px"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/default_discover_activity"
            android:scaleType="centerCrop"
            android:layout_weight="1"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
