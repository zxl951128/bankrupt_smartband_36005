<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_top"
        android:background="@color/blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:id="@+id/tv_measure_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="今天 08:45"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <cn.ginshell.bong.ui.view.RunningTextView
                android:textSize="70dp"
                android:textColor="@color/white"
                android:id="@+id/tv_running_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.0"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="bottom"
                android:id="@+id/tv_w_unit"
                android:paddingBottom="15dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:text="@string/f_jin_unit"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="60dp"
            android:layout_centerHorizontal="true">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    android:id="@+id/no_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/fit_p_score"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/no_score"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="20dp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_score_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="99"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/white"
                        android:gravity="bottom"
                        android:paddingBottom="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="2dp"
                        android:text="@string/fit_p_score_unit"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    android:id="@+id/no_tv_weight_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/f_fit_change"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/no_tv_weight_change"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="20dp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_change_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+2"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/white"
                        android:gravity="bottom"
                        android:id="@+id/tv_change_unit"
                        android:paddingBottom="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="2dp"
                        android:text="@string/f_jin_unit"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white"
                    android:id="@+id/no_tv_bmi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/fit_p_bmi_change"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/no_tv_bmi"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="@dimen/fit_t_first_size"
                        android:textColor="@color/white"
                        android:id="@+id/tv_bmi_change_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+1"/>
                    <TextView
                        android:textSize="@dimen/fit_pro_small_size"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:layout_marginBottom="3dp"
                        android:text="%"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/round_white_bg"
        android:paddingLeft="12dp"
        android:paddingTop="5dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="-40dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="15dp"
        android:layout_below="@+id/ll_top"
        android:elevation="6dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/fit_icon_bmi"/>
            <TextView
                android:textSize="@dimen/fit_t_third_size"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="BMI"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/black"
                android:id="@+id/tv_bmi_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="23.4"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_bmi_state"
                android:background="@drawable/f_state_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/f_normal"/>
        </LinearLayout>
        <cn.ginshell.bong.ui.widget.FitIndicatorView
            android:id="@+id/bmi_indicator_view"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="3dp"/>
        <View
            android:layout_marginTop="3dp"
            style="@style/DividerLine"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="20dp"
                android:textColor="@color/red_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="5dp"
                android:text="@string/icon_tips"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/black"
                android:id="@+id/tv_bmi_advice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="@string/bmi_d_intro"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
