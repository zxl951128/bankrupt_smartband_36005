<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="16dp"
        android:textColor="@color/selector_text_black_click"
        android:id="@+id/tv_active_record"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:layout_marginTop="10dp"
        android:text="@string/f_active_record"
        style="@style/BlackTextView"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/red_1"
        android:id="@+id/tv_go_bind"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:text="@string/bind_fit"
        android:drawableLeft="@drawable/icon_add_red"
        android:drawablePadding="5dp"
        android:layout_alignParentRight="true"
        style="@style/BlackTextView"/>
    <TextView
        android:enabled="false"
        android:textSize="13dp"
        android:textColor="@color/white"
        android:gravity="center_vertical"
        android:id="@+id/iv_connect"
        android:background="@drawable/selector_fit_ble_state"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginTop="17dp"
        android:layout_marginRight="15dp"
        android:text="@string/f_state_connected"
        android:drawableLeft="@drawable/bluetooth_white"
        android:drawablePadding="5dp"
        android:layout_alignParentRight="true"/>
    <cn.ginshell.bong.ui.view.SemiCircleProgressView
        android:id="@+id/semi_circle_progress_view"
        android:layout_width="280dp"
        android:layout_height="160dp"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_center"
        android:paddingTop="40dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="11dp"
            android:gravity="center"
            android:id="@+id/tv_measure_time"
            android:text="13:40"
            style="@style/BlackTextView"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <cn.ginshell.bong.ui.view.RunningTextView
                android:textSize="55dp"
                android:textColor="@color/blue"
                android:id="@+id/running_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/black"
                android:gravity="bottom"
                android:id="@+id/tv_running_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/f_kg_unit"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="224dp"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/rl_bmi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/white_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BMI"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/fit_t_first_size"
                    android:textColor="@color/black"
                    android:id="@+id/tv_bmi_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:layout_below="@+id/tv_bmi_title"
                    android:layout_centerHorizontal="true"/>
            </LinearLayout>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_fit_state"
                android:background="@drawable/f_state_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/f_normal"
                android:layout_toRightOf="@+id/rl_bmi"
                android:layout_alignBottom="@+id/rl_bmi"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:layout_alignParentRight="true">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/white_3"
                    android:id="@+id/tv_change_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/f_fit_change"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="@dimen/fit_t_first_size"
                        android:textColor="@color/black"
                        android:id="@+id/tv_change_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/black"
                        android:gravity="bottom"
                        android:paddingBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="3dp"
                        android:layout_marginRight="3dp"
                        android:text="@string/f_kg_unit"/>
                    <ImageView
                        android:id="@+id/iv_change_img_tip"
                        android:visibility="gone"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/fit_weight_increase"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="340dp"
            android:layout_height="25dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/black"
                android:id="@+id/tv_start_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="-- Kg"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/black"
                android:id="@+id/tv_goal_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
