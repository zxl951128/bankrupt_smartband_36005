<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="@dimen/title_size"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        android:text="@string/ble_connect_error"
        style="@style/BleErrorText"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ble_error_1"
        style="@style/BleErrorText"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ble_error_2"
        style="@style/BleErrorText"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ble_error_3"
        style="@style/BleErrorText"/>
    <TextView
        android:textColor="@color/bong_color"
        android:id="@+id/ble_error_still"
        android:layout_marginTop="8dp"
        android:text="@string/ble_error_still"
        style="@style/BleErrorText"/>
    <TextView
        android:textColor="@color/bong_color"
        android:gravity="right"
        android:id="@+id/ble_error_confirm"
        android:layout_marginTop="10dp"
        android:text="@string/confirm"
        style="@style/BleErrorText"/>
</LinearLayout>
