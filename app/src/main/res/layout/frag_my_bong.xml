<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/black_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/part_actionbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/set_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_model_margin">
                <ImageView
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <RelativeLayout
                    android:clickable="true"
                    style="@style/SetItem">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/icon_no_disturb"
                        android:text="@string/icon_no_disturb"
                        style="@style/ItemIconText.Yellow"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_set_no_disturb"
                        android:layout_toRightOf="@+id/icon_no_disturb"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.White"/>
                    <com.kyleduo.switchbutton.SwitchButton
                        android:id="@+id/no_disturb_switch"
                        android:padding="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/MaterialDesignStyle"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_disturb"
                    android:background="@drawable/selector_set_item_bg"
                    android:clickable="true"
                    android:layout_marginLeft="30dp"
                    style="@style/SetItem">
                    <ImageView
                        android:background="@color/set_split_line"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginLeft="15dp"
                        android:layout_alignParentTop="true"/>
                    <TextView
                        android:id="@+id/tv_no_disturb_time"
                        android:layout_marginLeft="15dp"
                        android:text="@string/default_time_period_value"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.Yellow"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="@string/card_set_no_disturb_time"
                        android:layout_toRightOf="@+id/tv_no_disturb_time"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.White"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/white"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                </RelativeLayout>
                <ImageView
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/set_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_model_margin">
                <ImageView
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <RelativeLayout
                    android:clickable="true"
                    style="@style/SetItem">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/icon_shock_switch"
                        android:text="@string/icon_shock"
                        style="@style/ItemIconText.Yellow"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_set_shock"
                        android:layout_toRightOf="@+id/icon_shock_switch"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.White"/>
                    <com.kyleduo.switchbutton.SwitchButton
                        android:id="@+id/shock_switch"
                        android:padding="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/MaterialDesignStyle"/>
                </RelativeLayout>
                <ImageView
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
            </LinearLayout>
            <TextView
                android:textSize="13dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="@dimen/card_describe_margin"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="6dp"
                android:text="@string/card_set_shock_tip"
                android:singleLine="false"
                style="@style/CommonText.Tip"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/set_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_model_margin">
                <ImageView
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <RelativeLayout
                    android:id="@+id/rl_wear_choose"
                    android:background="@drawable/selector_set_item_bg"
                    android:clickable="true"
                    style="@style/SetItem">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/icon_wear_choose"
                        android:text="@string/icon_wear"
                        style="@style/ItemIconText.Yellow"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_set_wear_choose"
                        android:layout_toRightOf="@+id/icon_wear_choose"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.White"/>
                    <TextView
                        android:id="@+id/tv_wear_choose"
                        android:layout_marginRight="15dp"
                        android:text="@string/set_left_hand"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.White"/>
                </RelativeLayout>
                <ImageView
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/set_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_model_margin">
                <ImageView
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <RelativeLayout
                    android:id="@+id/rl_open_course"
                    android:background="@drawable/selector_set_item_bg"
                    android:clickable="true"
                    style="@style/SetItem">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/icon_open_course"
                        android:text="@string/icon_guide"
                        style="@style/ItemIconText.Yellow"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_set_open_course"
                        android:layout_toRightOf="@+id/icon_open_course"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.White"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/white"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                </RelativeLayout>
                <ImageView
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
            </LinearLayout>
            <TextView
                android:textSize="13dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="@dimen/card_describe_margin"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="6dp"
                android:text="@string/card_set_open_course_tip"
                android:singleLine="false"
                style="@style/CommonText.Tip"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/set_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_model_margin"
                android:layout_marginBottom="@dimen/item_model_margin">
                <ImageView
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <RelativeLayout
                    android:id="@+id/rl_firmware_update"
                    android:background="@drawable/selector_set_item_bg"
                    android:clickable="true"
                    style="@style/SetItem">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/iv_firmware_update"
                        android:text="@string/icon_upgrade"
                        style="@style/ItemIconText.Yellow"/>
                    <TextView
                        android:id="@+id/tv_sys_update"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_bong_firmware_update"
                        android:layout_toRightOf="@+id/iv_firmware_update"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.White"/>
                    <ImageView
                        android:id="@+id/iv_update_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:src="@drawable/update_new_version"
                        android:layout_toRightOf="@+id/tv_sys_update"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="15dp"
                        android:id="@+id/tv_sys_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toLeftOf="@+id/iv_left_more"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.White"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/white"
                        android:id="@+id/iv_left_more"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                    <ImageView
                        android:background="@color/set_split_line"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_toRightOf="@+id/iv_firmware_update"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_restart"
                    android:background="@drawable/selector_set_item_bg"
                    android:clickable="true"
                    style="@style/SetItem">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/iv_restart"
                        android:text="@string/icon_restart"
                        style="@style/ItemIconText.Yellow"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_bong_restart"
                        android:layout_toRightOf="@+id/iv_restart"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.White"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/white"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                    <ImageView
                        android:background="@color/set_split_line"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_toRightOf="@+id/iv_restart"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_unbind"
                    android:background="@drawable/selector_set_item_bg"
                    android:clickable="true"
                    style="@style/SetItem">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/iv_unbind_img"
                        android:text="@string/icon_unbind"
                        style="@style/ItemIconText.Yellow"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_bong_unbind"
                        android:layout_toRightOf="@+id/iv_unbind_img"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.White"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/white"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                </RelativeLayout>
                <ImageView
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
