<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/frag_gesture_control_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_left"
            android:tag="binding_1"
            style="@style/TitleLeft"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_right"
            style="@style/TitleRight"/>
        <TextView
            android:id="@+id/title_center"
            android:text="@string/gesture_control_name"
            style="@style/TitleCenter"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="200dp">
        <ImageView
            android:background="@drawable/b3_setting_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/img_gesture_control"
            android:background="@drawable/anim_gesture_control"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textColor="@color/black_bg_80"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="30dp"
        android:text="@string/gesture_control"
        style="@style/SetItemTipText"/>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout style="@style/ReminderItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gesture_rise_wrist"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/rise_wrist_on_off"
                android:padding="16px"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_gesture_time"
            android:visibility="gone"
            android:clickable="true"
            style="@style/SetItem.Padding.Click">
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentTop="true"/>
            <TextView
                android:id="@+id/tv_wrist_time"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/CommonText.Green"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textColor="@color/black"
                android:id="@+id/ic_wrist"
                android:text="@string/icon_forward"
                android:layout_marginStart="5dp"
                android:layout_alignParentEnd="true"
                style="@style/ItemIconTextRight"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_wrist_screen"
                android:layout_alignBaseline="@+id/tv_wrist_time"
                android:layout_alignBottom="@+id/tv_wrist_time"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/tv_wrist_time"
                style="@style/CommonText.ItemBlack"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
</LinearLayout>
