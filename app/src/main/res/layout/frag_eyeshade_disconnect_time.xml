<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/frag_eyeshade_disconnect_time_0"
    android:background="@color/dialog_fragment_back_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/close"
        android:tag="binding_1"
        android:paddingTop="5dp"
        android:paddingRight="8dp"
        android:clickable="true"
        android:layout_width="@dimen/common_item_height"
        android:layout_height="@dimen/common_item_height"
        android:text="@string/icon_close"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/eyeshade_disconnect_tips"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="30dp"
        android:layout_below="@+id/close"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tips_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="@string/eyeshade_disconnect_question"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/tips_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"/>
        <ImageView
            android:id="@+id/tips_img"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/eyeshade_disconnect_bg"
            android:layout_weight="1"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/finish_respiting"
            android:tag="binding_2"
            android:paddingBottom="30dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/finish_respiting"/>
    </LinearLayout>
</RelativeLayout>
