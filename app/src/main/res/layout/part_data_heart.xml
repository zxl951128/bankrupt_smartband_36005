<?xml version="1.0" encoding="utf-8"?>
<cn.ginshell.bong.ui.view.report.InterceptLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/ill_heart_report"
    android:background="@drawable/selector_white_to_black_light"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">
    <ImageView xmlns:android="http://schemas.android.com/apk/res/android"
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/report_title_bar_height">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp">
            <TextView
                android:textSize="@dimen/data_main_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_heart"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/heart_rate_color"
                android:id="@+id/tv_heart_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75 次/分钟"
                style="@style/CommonText.ItemBlack"/>
        </LinearLayout>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textColor="@color/sport_x_text"
            android:layout_marginLeft="15dp"
            android:text="@string/icon_forward"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/ItemIconTextRight"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_sport_bar_height"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="5dp">
        <com.github.mikephil.charting.charts.CombinedChart
            android:id="@+id/heart_chart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_sport_bar_height"/>
        <ImageView
            android:id="@+id/iv_no_pic_heart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_sport_cover_height"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/pic_hr"/>
    </RelativeLayout>
    <ImageView
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
</cn.ginshell.bong.ui.view.report.InterceptLinearLayout>
