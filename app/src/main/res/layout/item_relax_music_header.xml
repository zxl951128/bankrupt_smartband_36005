<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/item_relax_music_header_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="12dp"
        android:id="@+id/introduce_channel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="15dp"
        android:text="@string/introduce_channel"/>
    <RelativeLayout
        android:id="@+id/intelligent_music_rela"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_below="@+id/introduce_channel">
        <FrameLayout
            android:background="@drawable/intelligent_music"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:text="@string/channel_intelligent_tips"/>
        </FrameLayout>
        <TextView
            android:textSize="14dp"
            android:id="@+id/songs_num"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nt_music_count"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textColor="@color/purple_bg"
            android:id="@+id/intelligent_music_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/intelligent_music"
            android:layout_above="@+id/songs_num"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/back_img"
        android:background="@drawable/intelligent_music_rect2"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginRight="15dp"
        android:layout_below="@+id/introduce_channel"
        android:layout_alignStart="@+id/introduce_channel"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/finish_img"
        android:background="@drawable/intelligent_music_rect3"
        android:visibility="invisible"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginRight="15dp"
        android:text="@string/icon_finish"
        android:layout_below="@+id/introduce_channel"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="12dp"
        android:id="@+id/more_channel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="15dp"
        android:text="@string/my_channel"
        android:layout_below="@+id/back_img"/>
</RelativeLayout>
