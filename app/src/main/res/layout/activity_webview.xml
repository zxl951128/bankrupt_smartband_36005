<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/green_1"
        style="@style/CommonTitle">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/icon_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/back"
            android:paddingLeft="@dimen/bong_pro_common_padding"
            android:paddingRight="@dimen/bong_pro_common_padding"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/icon_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/share"
            android:paddingLeft="@dimen/bong_pro_common_padding"
            android:paddingRight="@dimen/bong_pro_common_padding"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/icon_share"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="@dimen/title_size"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/bong"
            android:lines="1"
            android:layout_toLeftOf="@+id/share"
            android:layout_toRightOf="@+id/back"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/part_no_data"/>
        <FrameLayout
            android:id="@+id/web_view_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:progressDrawable="@drawable/progressbar_webview"
            style="?android:attr/progressBarStyleHorizontal"/>
    </FrameLayout>
</LinearLayout>
