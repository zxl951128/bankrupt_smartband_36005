<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View xmlns:android="http://schemas.android.com/apk/res/android"
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/item_margin_height"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:clickable="true"
            style="@style/SetItem.Padding">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/icon_no_disturb"
                android:text="@string/icon_no_disturb"
                style="@style/ItemIconText.Green"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_set_no_disturb"
                android:layout_toRightOf="@+id/icon_no_disturb"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/no_disturb_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_disturb"
            android:clickable="true"
            style="@style/SetItem.Padding.Click">
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="43dp"/>
            <TextView
                android:id="@+id/tv_no_disturb_time"
                android:layout_marginLeft="43dp"
                android:layout_centerVertical="true"
                style="@style/CommonText.Green"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/bong_2s_no_disturb_time"
                android:layout_toRightOf="@+id/tv_no_disturb_time"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textColor="@color/black"
                android:layout_marginLeft="5dp"
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                style="@style/ItemIconTextRight"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <TextView
        android:layout_marginTop="@dimen/card_describe_margin"
        android:layout_marginBottom="@dimen/common_item_height"
        android:text="@string/my_bong_disturb_tip"
        style="@style/SetItemTipText"/>
</merge>
