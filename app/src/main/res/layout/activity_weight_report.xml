<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/activity_weight_report_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        android:background="@color/blue"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_left"
            style="@style/TitleLeft"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_right"
            android:visibility="invisible"
            android:text="@string/icon_share"
            style="@style/TitleRight"/>
        <TextView
            android:id="@+id/title_center"
            android:text="@string/weight_report"
            style="@style/TitleCenter"/>
    </RelativeLayout>
    <cn.ginshell.bong.ui.view.report.PagerCheckTabStrip
        android:id="@+id/tabs"
        android:background="@color/blue"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/title"/>
    <cn.ginshell.bong.ui.view.report.NoLongPressViewPager
        android:id="@+id/view_pager"
        android:background="@color/blue"
        android:paddingTop="10dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="185dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/gray_light_f1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <ImageView
                android:background="@color/green_1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:background="@color/green_2"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <cn.ginshell.bong.ui.view.report.DatePickerScrollview
                android:id="@+id/datePicker"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="15dp"
                android:textColor="@color/white_3"
                android:gravity="center"
                android:id="@+id/icon_left"
                android:layout_width="10dp"
                android:layout_height="40dp"
                android:layout_marginLeft="5dp"
                android:text="@string/icon_page_left"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="15dp"
                android:textColor="@color/white_3"
                android:gravity="center"
                android:id="@+id/icon_right"
                android:layout_width="10dp"
                android:layout_height="40dp"
                android:layout_marginRight="5dp"
                android:text="@string/icon_page_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <ImageView
                    android:background="@color/user_item_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <ImageView
                        android:id="@+id/iv_weight"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginLeft="15dp"
                        android:src="@drawable/icon_weight_blue"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="16dp"
                        android:id="@+id/tv_weight_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:text="@string/daily_weight"
                        android:layout_toRightOf="@+id/iv_weight"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.ItemBlack"/>
                    <TextView
                        android:textSize="16dp"
                        android:id="@+id/tv_weight_percent_before"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="15dp"
                        android:text="@string/compare_with_before"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.ItemBlack"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:textSize="28dp"
                        android:textColor="@color/blue"
                        android:id="@+id/tv_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:text="- -"
                        style="@style/CommonText.ItemBlack"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/blue"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="@string/weight_unit"
                        android:layout_toRightOf="@+id/tv_weight"
                        android:layout_alignBottom="@+id/tv_weight"
                        style="@style/CommonText.ItemBlack"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/sport_percent_up"
                        android:id="@+id/iv_weight_up_or_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="15dp"
                        android:text="@string/icon_arrow_up"
                        android:includeFontPadding="false"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/sport_percent_up"
                        android:id="@+id/tv_weight_percent"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="2dp"
                        android:text="@string/sport_percent_unit"
                        android:layout_toLeftOf="@+id/iv_weight_up_or_down"
                        android:layout_alignBottom="@+id/tv_weight"
                        style="@style/CommonText.ItemBlack"/>
                    <TextView
                        android:textSize="28dp"
                        android:textColor="@color/sport_percent_up"
                        android:id="@+id/tv_weight_change_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- -"
                        android:layout_toLeftOf="@+id/tv_weight_percent"
                        style="@style/CommonText.ItemBlack"/>
                </RelativeLayout>
                <ImageView
                    android:background="@color/user_item_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="8dp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <ImageView
                        android:id="@+id/iv_bfp"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginLeft="15dp"
                        android:src="@drawable/icon_fat_blue"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="16dp"
                        android:id="@+id/tv_bfp_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="@string/daily_bfp"
                        android:layout_toRightOf="@+id/iv_bfp"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.ItemBlack"/>
                    <TextView
                        android:textSize="16dp"
                        android:id="@+id/tv_bfp_percent_before"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="15dp"
                        android:text="@string/compare_with_before"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.ItemBlack"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:textSize="28dp"
                        android:textColor="@color/blue_light"
                        android:id="@+id/tv_bfp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:text="- -"
                        style="@style/CommonText.ItemBlack"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/blue_light"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="@string/sport_percent_unit"
                        android:layout_toRightOf="@+id/tv_bfp"
                        android:layout_alignBottom="@+id/tv_bfp"
                        style="@style/CommonText.ItemBlack"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/sport_percent_up"
                        android:id="@+id/iv_bfp_up_or_down"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="15dp"
                        android:text="@string/icon_arrow_up"
                        android:includeFontPadding="false"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/sport_percent_up"
                        android:id="@+id/tv_bfp_percent"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="2dp"
                        android:text="@string/sport_percent_unit"
                        android:layout_toLeftOf="@+id/iv_bfp_up_or_down"
                        android:layout_alignBottom="@+id/tv_bfp_change_percent"
                        style="@style/CommonText.ItemBlack"/>
                    <TextView
                        android:textSize="28dp"
                        android:textColor="@color/sport_percent_up"
                        android:id="@+id/tv_bfp_change_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- -"
                        android:layout_toLeftOf="@+id/tv_bfp_percent"
                        style="@style/CommonText.ItemBlack"/>
                </RelativeLayout>
                <ImageView
                    android:background="@color/user_item_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
