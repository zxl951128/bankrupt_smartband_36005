<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/stub_verify_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center"
        android:id="@+id/tv_verify_send_tip"
        android:text="@string/verify_code_sent_to_phone"
        xmlns:ns1="http://schemas.android.com/apk/res-auto" 
        ns1:layout_constraintLeft_toLeftOf="parent"
        xmlns:ns2="http://schemas.android.com/apk/res-auto" 
        ns2:layout_constraintRight_toRightOf="parent"
        xmlns:ns3="http://schemas.android.com/apk/res-auto" 
        ns3:layout_constraintTop_toTopOf="parent"
        style="@style/TextViewTip"/>
    <TextView
        android:textSize="@dimen/fit_tip_size"
        android:textColor="@color/white"
        android:id="@+id/tv_verify_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_horizontal_margin"
        android:layout_marginTop="10dp"
        android:text="@string/register_verification_code"
        xmlns:ns4="http://schemas.android.com/apk/res-auto" 
        ns4:layout_constraintBottom_toTopOf="@+id/et_verify"
        xmlns:ns5="http://schemas.android.com/apk/res-auto" 
        ns5:layout_constraintLeft_toLeftOf="@+id/et_verify"
        xmlns:ns6="http://schemas.android.com/apk/res-auto" 
        ns6:layout_constraintTop_toBottomOf="@+id/tv_verify_send_tip"/>
    <android.support.v7.widget.AppCompatEditText
        android:id="@+id/et_verify"
        android:paddingLeft="@dimen/common_horizontal_margin"
        android:paddingRight="80dp"
        android:digits="0123456789"
        android:inputType="number"
        android:imeOptions="actionNext"
        xmlns:ns7="http://schemas.android.com/apk/res-auto" 
        ns7:layout_constraintLeft_toLeftOf="parent"
        xmlns:ns8="http://schemas.android.com/apk/res-auto" 
        ns8:layout_constraintRight_toRightOf="parent"
        xmlns:ns9="http://schemas.android.com/apk/res-auto" 
        ns9:layout_constraintTop_toBottomOf="@+id/tv_verify_tip"
        style="@style/AccountEditor">
        <requestFocus/>
    </android.support.v7.widget.AppCompatEditText>
    <cn.iwgang.countdownview.CountdownView
        android:id="@+id/countdown_resend"
        android:background="@null"
        android:paddingLeft="@dimen/common_horizontal_margin"
        android:paddingRight="@dimen/common_horizontal_margin"
        android:visibility="visible"
        android:clickable="false"
        android:layout_width="60dp"
        android:layout_height="0dp"
        xmlns:ns10="http://schemas.android.com/apk/res-auto" 
        ns10:isHideTimeBackground="true"
        xmlns:ns11="http://schemas.android.com/apk/res-auto" 
        ns11:isShowDay="false"
        xmlns:ns12="http://schemas.android.com/apk/res-auto" 
        ns12:isShowHour="false"
        xmlns:ns13="http://schemas.android.com/apk/res-auto" 
        ns13:isShowMillisecond="false"
        xmlns:ns14="http://schemas.android.com/apk/res-auto" 
        ns14:isShowMinute="false"
        xmlns:ns15="http://schemas.android.com/apk/res-auto" 
        ns15:isShowSecond="true"
        xmlns:ns16="http://schemas.android.com/apk/res-auto" 
        ns16:isTimeTextBold="true"
        xmlns:ns17="http://schemas.android.com/apk/res-auto" 
        ns17:layout_constraintBottom_toBottomOf="@+id/et_verify"
        xmlns:ns18="http://schemas.android.com/apk/res-auto" 
        ns18:layout_constraintRight_toRightOf="@+id/et_verify"
        xmlns:ns19="http://schemas.android.com/apk/res-auto" 
        ns19:layout_constraintTop_toTopOf="@+id/et_verify"
        xmlns:ns20="http://schemas.android.com/apk/res-auto" 
        ns20:suffixGravity="bottom"
        xmlns:ns21="http://schemas.android.com/apk/res-auto" 
        ns21:suffixSecond="s"
        xmlns:ns22="http://schemas.android.com/apk/res-auto" 
        ns22:suffixTextColor="@color/white"
        xmlns:ns23="http://schemas.android.com/apk/res-auto" 
        ns23:suffixTextSize="@dimen/common_text_size"
        xmlns:ns24="http://schemas.android.com/apk/res-auto" 
        ns24:timeTextColor="@color/white"
        xmlns:ns25="http://schemas.android.com/apk/res-auto" 
        ns25:timeTextSize="17dp"/>
    <TextView
        android:textSize="@dimen/common_text_size"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_resend"
        android:tag="binding_1"
        android:paddingLeft="@dimen/common_horizontal_margin"
        android:paddingRight="@dimen/common_horizontal_margin"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/resend_verify_code"
        xmlns:ns26="http://schemas.android.com/apk/res-auto" 
        ns26:layout_constraintBottom_toBottomOf="@+id/et_verify"
        xmlns:ns27="http://schemas.android.com/apk/res-auto" 
        ns27:layout_constraintRight_toRightOf="@+id/et_verify"
        xmlns:ns28="http://schemas.android.com/apk/res-auto" 
        ns28:layout_constraintTop_toTopOf="@+id/et_verify"/>
</android.support.constraint.ConstraintLayout>
