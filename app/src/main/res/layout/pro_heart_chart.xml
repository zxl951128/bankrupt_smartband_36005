<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/rl_heart"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="35dp">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/ll_heart_tip"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="15dp">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/pro_heart_icon_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            android:text="@string/icon_h_hr"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:text="@string/heart_change"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="(bpm)"/>
    </LinearLayout>
    <cn.ginshell.bong.ui.view.pro.ProLineChart
        android:id="@+id/heart_rate_chart"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:layout_marginLeft="@dimen/pro_chart_common_padding"
        android:layout_below="@+id/ll_heart_data"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_heart_data"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3"
        android:layout_below="@+id/ll_heart_tip">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="22dp"
                android:textColor="@color/black"
                android:id="@+id/min_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_value"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_low"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="22dp"
                android:textColor="@color/black"
                android:id="@+id/avg_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_value"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/average_heart_rate"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="22dp"
                android:textColor="@color/black"
                android:id="@+id/max_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_value"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_high"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/time_span"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5dp"
        android:layout_below="@+id/heart_rate_chart">
        <TextView
            android:textSize="9dp"
            android:textColor="@color/pro_xaxis_text_color"
            android:id="@+id/start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:text="@string/default_time_value"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="9dp"
            android:textColor="@color/pro_xaxis_text_color"
            android:id="@+id/end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="@string/default_time_value"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/heart_tip"
        android:paddingLeft="@dimen/bong_content_margin_left"
        android:paddingRight="@dimen/bong_content_margin_left"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="30dp"
        android:weightSum="5"
        android:layout_below="@+id/heart_rate_chart">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/view_warm_up"
                android:background="@drawable/bg_corner_heart_chart"
                android:layout_width="@dimen/sleep_pro_indicator_wide"
                android:layout_height="@dimen/sleep_pro_indicator_size"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/pro_heart_warm_up"
                style="@style/CommonText.Tip"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/view_fat"
                android:background="@drawable/bg_corner_heart_chart"
                android:layout_width="@dimen/sleep_pro_indicator_wide"
                android:layout_height="@dimen/sleep_pro_indicator_size"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/pro_heart_fat"
                style="@style/CommonText.Tip"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/view_heart"
                android:background="@drawable/bg_corner_heart_chart"
                android:layout_width="@dimen/sleep_pro_indicator_wide"
                android:layout_height="@dimen/sleep_pro_indicator_size"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/pro_heart_heart"
                style="@style/CommonText.Tip"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/view_power"
                android:background="@drawable/bg_corner_heart_chart"
                android:layout_width="@dimen/sleep_pro_indicator_wide"
                android:layout_height="@dimen/sleep_pro_indicator_size"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/pro_heart_power"
                style="@style/CommonText.Tip"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <View
                android:id="@+id/view_extremity"
                android:background="@drawable/bg_corner_heart_chart"
                android:layout_width="@dimen/sleep_pro_indicator_wide"
                android:layout_height="@dimen/sleep_pro_indicator_size"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/pro_heart_extremity"
                style="@style/CommonText.Tip"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_en_heart_tip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="10dp"
        android:layout_below="@+id/heart_rate_chart">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <View
                    android:id="@+id/view_en_warm_up"
                    android:background="@drawable/bg_corner_heart_chart"
                    android:layout_width="@dimen/sleep_pro_indicator_wide"
                    android:layout_height="@dimen/sleep_pro_indicator_size"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/pro_heart_warm_up"
                    style="@style/CommonText.Tip"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <View
                    android:id="@+id/view_en_fat"
                    android:background="@drawable/bg_corner_heart_chart"
                    android:layout_width="@dimen/sleep_pro_indicator_wide"
                    android:layout_height="@dimen/sleep_pro_indicator_size"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/pro_heart_fat"
                    style="@style/CommonText.Tip"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <View
                    android:id="@+id/view_en_heart"
                    android:background="@drawable/bg_corner_heart_chart"
                    android:layout_width="@dimen/sleep_pro_indicator_wide"
                    android:layout_height="@dimen/sleep_pro_indicator_size"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/pro_heart_heart"
                    style="@style/CommonText.Tip"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="50dp"
            android:weightSum="2">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <View
                    android:id="@+id/view_en_power"
                    android:background="@drawable/bg_corner_heart_chart"
                    android:layout_width="@dimen/sleep_pro_indicator_wide"
                    android:layout_height="@dimen/sleep_pro_indicator_size"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/pro_heart_power"
                    style="@style/CommonText.Tip"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <View
                    android:id="@+id/view_en_extremity"
                    android:background="@drawable/bg_corner_heart_chart"
                    android:layout_width="@dimen/sleep_pro_indicator_wide"
                    android:layout_height="@dimen/sleep_pro_indicator_size"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/pro_heart_extremity"
                    style="@style/CommonText.Tip"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/below_line"
        android:background="#80cccccc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="1px"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/heart_tip"/>
    <View
        android:id="@+id/en_below_line"
        android:background="#80cccccc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="1px"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/ll_en_heart_tip"/>
</RelativeLayout>
