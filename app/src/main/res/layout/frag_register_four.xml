<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:background="@drawable/bg_gradient_green"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/iv_close"
        android:text="@string/icon_back"
        android:layout_alignParentLeft="true"
        style="@style/CloseButton"/>
    <RelativeLayout
        android:id="@+id/rl_high"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/iv_close"
        style="@style/CommonItem.Click">
        <TextView
            android:layout_marginLeft="5dp"
            android:text="@string/register_high_name"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <TextView
            android:gravity="center"
            android:id="@+id/et_high_input"
            android:text="@string/register_default_height"
            android:layout_toLeftOf="@+id/tv_high_unit"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <TextView
            android:id="@+id/tv_high_unit"
            android:layout_marginRight="10dp"
            android:text="@string/bong_unit_cm"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <View
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_weight"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/rl_high"
        style="@style/CommonItem.Click">
        <TextView
            android:layout_marginLeft="5dp"
            android:text="@string/register_weight_name"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <TextView
            android:gravity="center"
            android:id="@+id/et_weight_input"
            android:text="@string/register_default_weight"
            android:layout_toLeftOf="@+id/tv_weight_unit"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <TextView
            android:id="@+id/tv_weight_unit"
            android:layout_marginRight="10dp"
            android:text="@string/bong_unit_kg"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <View
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_birthday"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/rl_weight"
        style="@style/CommonItem.Click">
        <TextView
            android:layout_marginLeft="5dp"
            android:text="@string/register_birthday_name"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <TextView
            android:gravity="center"
            android:id="@+id/et_birthday_input"
            android:layout_marginLeft="10dp"
            android:text="@string/register_default_year"
            android:layout_toLeftOf="@+id/tv_birthday_unit"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <TextView
            android:id="@+id/tv_birthday_unit"
            android:layout_marginRight="10dp"
            android:text="@string/bong_unit_year"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <View
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <android.support.v7.widget.AppCompatButton
        android:gravity="center"
        android:id="@+id/btn_register_next"
        android:clickable="true"
        android:layout_marginTop="10dp"
        android:text="@string/register_step_next"
        android:layout_alignParentBottom="true"
        style="@style/RelativeNextBtn"/>
</RelativeLayout>
