<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/physical_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="@dimen/physical_top_height">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/left"
            android:background="@drawable/selector_set_item_bg"
            android:clickable="true"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="@dimen/common_title_height"
            android:layout_alignParentLeft="true">
            <TextView
                android:textSize="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stop"
                style="@style/CommonText.White"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_voice"
            android:background="@drawable/anim_voice_animation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/iv_voice_mute"
            android:background="@drawable/voice_mute"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <cn.ginshell.bong.ui.view.TimerDownTextView
                android:textSize="@dimen/physical_timer_size"
                android:id="@+id/timer_down_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02:00"
                style="@style/CommonText.White"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <cn.ginshell.bong.ui.view.StepView
                    android:id="@+id/step_view_1"
                    android:layout_width="@dimen/physical_step_size"
                    android:layout_height="@dimen/physical_step_size"/>
                <cn.ginshell.bong.ui.view.StepView
                    android:id="@+id/step_view_2"
                    android:layout_width="@dimen/physical_step_size"
                    android:layout_height="@dimen/physical_step_size"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"/>
                <cn.ginshell.bong.ui.view.StepView
                    android:id="@+id/step_view_3"
                    android:layout_width="@dimen/physical_step_size"
                    android:layout_height="@dimen/physical_step_size"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <cn.ginshell.bong.ui.view.ProgressView
            android:id="@+id/progress_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/physical_progress_height"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_contain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/ll_child_step"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/frag_physical_step"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_child_rest"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/frag_physical_rest"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
