<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/fragment_account_base_0"
    android:background="@drawable/bg_gradient_green"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/close"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/icon_close"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        style="@style/TopLeftIconButton"/>
    <TextView
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/set_login"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        xmlns:ns1="http://schemas.android.com/apk/res-auto" 
        ns1:layout_constraintLeft_toLeftOf="parent"
        xmlns:ns2="http://schemas.android.com/apk/res-auto" 
        ns2:layout_constraintRight_toRightOf="parent"
        xmlns:ns3="http://schemas.android.com/apk/res-auto" 
        ns3:layout_constraintTop_toTopOf="parent"
        style="@style/TitleTextView.White"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content_pan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        xmlns:ns4="http://schemas.android.com/apk/res-auto" 
        ns4:layout_constraintLeft_toLeftOf="parent"
        xmlns:ns5="http://schemas.android.com/apk/res-auto" 
        ns5:layout_constraintRight_toRightOf="parent"
        xmlns:ns6="http://schemas.android.com/apk/res-auto" 
        ns6:layout_constraintTop_toBottomOf="@+id/title">
        <ViewStub
            android:id="@+id/view_stub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/error_tip"
            style="@style/ErrorTip"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/part_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        xmlns:ns7="http://schemas.android.com/apk/res-auto" 
        ns7:layout_constraintBottom_toBottomOf="parent"
        xmlns:ns8="http://schemas.android.com/apk/res-auto" 
        ns8:layout_constraintLeft_toLeftOf="parent"
        xmlns:ns9="http://schemas.android.com/apk/res-auto" 
        ns9:layout_constraintRight_toRightOf="parent"/>
</android.support.constraint.ConstraintLayout>
