<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/green_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20dp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="@string/tab_device"
            android:layout_centerHorizontal="true"
            style="@style/CommonText.White"/>
        <TextView
            android:textSize="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/bind_no_device"
            android:layout_centerHorizontal="true"
            style="@style/CommonText.White"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:src="@drawable/bind_product"
            android:scaleType="fitXY"/>
    </LinearLayout>
    <TextView
        android:textSize="24dp"
        android:id="@+id/tip1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/bind_new_device"
        android:layout_above="@+id/tip2"
        android:layout_centerHorizontal="true"
        style="@style/CommonText.Black"/>
    <TextView
        android:textSize="12dp"
        android:gravity="center_vertical"
        android:id="@+id/tip2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="@string/bind_new_ble_tip"
        android:drawablePadding="10dp"
        android:layout_above="@+id/btn_bong_search"
        android:layout_centerHorizontal="true"
        android:drawableStart="@drawable/icon_bluetooth"
        style="@style/CommonText.Black"/>
    <TextView
        android:gravity="center"
        android:id="@+id/btn_bong_search"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginBottom="25dp"
        android:text="@string/add_new_device"
        android:layout_alignParentBottom="true"
        style="@style/BorderButtonGreen"/>
</RelativeLayout>
