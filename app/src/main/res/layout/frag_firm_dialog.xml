<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/frag_firm_dialog_0"
    android:background="@drawable/bg_corner_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_respite_dfu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/firmware_update"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_update"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp">
                <View
                    android:background="@drawable/bg_circle_purple"
                    android:layout_width="5dp"
                    android:layout_height="5dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/firmware_update_version"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="12.34"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp">
                <View
                    android:background="@drawable/bg_circle_purple"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="5dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:id="@+id/tv_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="30dp"/>
            </LinearLayout>
            <View
                android:background="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="1px"
                android:layout_marginTop="40dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <View
                    android:id="@+id/line"
                    android:background="@color/gray"
                    android:layout_width="1px"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/cancel"
                    android:layout_alignRight="@+id/line"
                    android:layout_alignParentLeft="true"/>
                <TextView
                    android:textColor="@color/purple_action_bar_bg"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_immediately_update"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/immediately_update"
                    android:layout_alignLeft="@+id/line"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_update_ing"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/black"
                android:paddingBottom="40dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/firmware_update_ing_tip"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_update_success"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_current_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:background="@color/gray"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="20dp"
                android:textColor="#3b1c69"
                android:gravity="center"
                android:id="@+id/tv_ok"
                android:paddingTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/update_ok"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_update_fail"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:text="@string/firmware_update_fail_tip"/>
            <View
                android:background="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="1px"
                android:layout_marginTop="40dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <View
                    android:id="@+id/line2"
                    android:background="@color/gray"
                    android:layout_width="1px"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_next"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/firmware_update_next"
                    android:layout_alignRight="@+id/line2"
                    android:layout_alignParentLeft="true"/>
                <TextView
                    android:textColor="@color/purple_action_bar_bg"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_try"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/firmware_update_try"
                    android:layout_alignLeft="@+id/line2"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
