<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:background="@drawable/round_white_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="40dp">
        <TextView
            android:textSize="18dp"
            android:textColor="@color/bong_color"
            android:id="@+id/nps_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="25dp"
            android:text="@string/nps_title_not_satisfy"/>
        <EditText
            android:textSize="14dp"
            android:gravity="top|left"
            android:id="@+id/nps_advice"
            android:background="@drawable/round_stroke_bg"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="30dp"
            android:hint="@string/nps_sorry_hint"
            android:maxLength="999"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@drawable/selector_btn_normal"
                android:padding="10dp"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:layout_weight="1"/>
            <View
                android:background="@color/white_c"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/bong_color"
                android:gravity="center"
                android:id="@+id/confirm"
                android:background="@drawable/selector_btn_normal"
                android:padding="10dp"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/confirm"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
