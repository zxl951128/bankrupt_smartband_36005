<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/frag_wake_up_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bigkoo.pickerview.TimePickerView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/time_picker_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/action_bar_common"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_title_height">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/title_left"
            android:tag="binding_1"
            android:background="@drawable/selector_btn_normal"
            android:clickable="true"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:gravity="center"
            android:id="@+id/title_right"
            android:background="@drawable/selector_btn_normal"
            android:visibility="invisible"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="20dp"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:text="@string/wake"
            android:lines="1"
            android:layout_toLeftOf="@+id/title_right"
            android:layout_toRightOf="@+id/title_left"
            android:layout_centerInParent="true"
            style="@style/CommonText"/>
        <View
            android:id="@+id/line"
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/img"
        android:background="#fafafa"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_below="@+id/action_bar_common"/>
    <ImageView
        android:id="@+id/line1"
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_below="@+id/img"/>
    <RelativeLayout
        android:id="@+id/wake_up_rela"
        android:background="@color/white"
        android:clickable="true"
        android:layout_below="@+id/line1"
        style="@style/SetItem.TransportClick">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="18dp"
            android:textColor="@color/purple_action_bar_bg"
            android:gravity="center"
            android:id="@+id/wake_up_img"
            android:layout_width="@dimen/common_item_height"
            android:layout_height="@dimen/common_item_height"
            android:text="@string/icon_wakeup"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/intelligent_wake"
            android:layout_toRightOf="@+id/wake_up_img"
            android:layout_centerVertical="true"
            style="@style/CommonText.ItemPurple"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/intelligent_wake_switch"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/MaterialDesignStyle2"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/line2"
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_below="@+id/wake_up_rela"/>
    <LinearLayout
        android:id="@+id/linear"
        android:background="#fafafa"
        android:layout_below="@+id/line2"
        style="@style/SetItem">
        <TextView
            android:textSize="12dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/item_margin_left"
            android:layout_marginTop="10dp"
            android:text="@string/intelligent_wake_tips"
            android:layout_weight="3"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/sport_bar_bottom"
            android:tag="binding_2"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:text="@string/know_more"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_alarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linear">
        <ImageView
            android:id="@+id/line3"
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/alarm_rela"
            android:background="@color/white"
            android:clickable="true"
            android:layout_below="@+id/line3"
            style="@style/SetItem.TransportClick">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="18dp"
                android:textColor="@color/purple_action_bar_bg"
                android:gravity="center"
                android:id="@+id/alarm_clock_img"
                android:layout_width="@dimen/common_item_height"
                android:layout_height="@dimen/common_item_height"
                android:text="@string/icon_clock"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_clock"
                android:layout_toRightOf="@+id/alarm_clock_img"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemPurple"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/alarm_clock_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle2"/>
        </RelativeLayout>
        <View
            android:id="@+id/close_alarm_line"
            android:background="@color/user_item_line"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_below="@+id/alarm_rela"/>
        <View
            android:id="@+id/open_alarm_line"
            android:background="@color/user_item_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="15dp"
            android:layout_below="@+id/alarm_rela"/>
        <TextView
            android:textSize="12dp"
            android:id="@+id/wake_up_tips"
            android:paddingLeft="@dimen/item_margin_left"
            android:paddingTop="10dp"
            android:paddingBottom="15dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intelligent_wake_up_tips"/>
        <RelativeLayout
            android:id="@+id/time_rela"
            android:tag="binding_3"
            android:background="@drawable/selector_btn_purple"
            android:visibility="gone"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:text="@string/time"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemPurple"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textColor="@color/black"
                android:id="@+id/icon_alarm_arrows"
                android:layout_marginLeft="5dp"
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                style="@style/ItemIconTextRight"/>
            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="18dp"
                android:text="12:00"
                android:layout_toLeftOf="@+id/icon_alarm_arrows"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemPurple"/>
        </RelativeLayout>
        <View
            android:id="@+id/time_bottom_line"
            android:background="@color/user_item_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_below="@+id/time_rela"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_ring"
        android:background="@drawable/selector_btn_purple"
        android:visibility="visible"
        android:clickable="true"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/ll_alarm"
        style="@style/SetItem.TransportClick">
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:text="@string/ring"
            android:layout_alignBottom="@+id/icon_ring_arrows"
            android:layout_marginStart="18dp"
            android:layout_alignParentStart="true"
            style="@style/CommonText.ItemPurple"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textColor="@color/black"
            android:id="@+id/icon_ring_arrows"
            android:layout_marginLeft="5dp"
            android:text="@string/icon_forward"
            style="@style/ItemIconTextRight"/>
        <TextView
            android:id="@+id/ring_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="18dp"
            android:layout_toLeftOf="@+id/icon_ring_arrows"
            android:layout_centerVertical="true"
            style="@style/CommonText.ItemPurple"/>
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
