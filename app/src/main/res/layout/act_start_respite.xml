<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/act_start_respite_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Purple">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title_left"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_close"
            android:layout_alignParentLeft="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title_right"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_list_sleep"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/respite"
            android:lines="1"
            android:layout_toLeftOf="@+id/title_right"
            android:layout_toRightOf="@+id/title_left"
            android:layout_centerInParent="true"
            style="@style/CommonText"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/image_background"
        android:background="@color/purple_action_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_patch"
        android:layout_above="@+id/clock_and_music"
        android:layout_below="@+id/action_bar_common"/>
    <RelativeLayout
        android:id="@+id/clock_and_music"
        android:background="@color/purple_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_awaken"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="22dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:paddingTop="10dp"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:text="@string/icon_wakeup"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:paddingTop="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wake"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/intelligent_wake_rect"
            android:background="@drawable/intelligent_wake_rect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_toRightOf="@+id/ll_awaken"/>
        <ImageView
            android:id="@+id/intelligent_wake_rect_true2"
            android:background="@drawable/intelligent_wake_true_rect2"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="16dp"
            android:layout_toRightOf="@+id/ll_awaken"/>
        <ImageView
            android:id="@+id/intelligent_wake_false_rect"
            android:background="@drawable/intelligent_wake_false_rect"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="16dp"
            android:layout_toRightOf="@+id/ll_awaken"/>
        <ImageView
            android:id="@+id/intelligent_wake_false_rect2"
            android:background="@drawable/intelligent_wake_false_rect2"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="24dp"
            android:layout_toRightOf="@+id/ll_awaken"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:layout_alignParentRight="true">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="21dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:paddingTop="10dp"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:text="@string/icon_music"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:paddingTop="4dp"
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:text="@string/music"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:id="@+id/start_respite_back"
        android:background="@drawable/respite_circle2"
        android:clickable="true"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="25dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/start_respite"
        android:background="@drawable/respite_circle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="30dp"
        android:text="@string/start"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
