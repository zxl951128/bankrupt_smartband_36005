<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/frag_eyeshade_calendar_view_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:id="@+id/date_bar"
        android:background="@color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_title_height">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/green_2"
            android:gravity="center"
            android:id="@+id/title_left"
            android:tag="binding_1"
            android:layout_width="@dimen/common_item_height"
            android:layout_height="@dimen/common_item_height"
            android:text="@string/icon_close"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/title_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calendar"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/green_2"
            android:gravity="center"
            android:id="@+id/return_today"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:text="@string/go_today"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/date_bar_rela"
        android:background="@color/common_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/date_bar">
        <TextView
            android:textSize="18dp"
            android:textColor="@color/black"
            android:id="@+id/date_bar_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <android.support.v4.view.ViewPager
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_below="@+id/date_bar_rela"/>
    <View
        android:id="@+id/line"
        android:background="@color/white_c"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_below="@+id/viewpager"/>
    <RelativeLayout
        android:id="@+id/calendar_container"
        android:background="@color/common_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/line"/>
</RelativeLayout>
