<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fit_p_goal"
            android:layout_centerVertical="true"/>
        <TextView
            android:id="@+id/btn_change_goal"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fit_p_goal_change"
            android:layout_alignParentRight="true"
            style="@style/BorderButtonGreen"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp">
            <ImageView
                android:id="@+id/no_kg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:src="@drawable/fit_icon_weight"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="24dp"
                android:textColor="@color/red_1"
                android:id="@+id/tv_cur_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:layout_toRightOf="@+id/no_kg"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white_6"
                android:id="@+id/tv_cur_weight_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="8dp"
                android:text="@string/f_jin_unit"
                android:layout_toRightOf="@+id/tv_cur_weight"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fit_p_cur_weight"
                android:layout_toRightOf="@+id/no_kg"
                android:layout_below="@+id/tv_cur_weight"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"/>
        <RelativeLayout
            android:id="@+id/rl_no_goal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/red_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goal_no_set"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_goal"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/no_loss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:src="@drawable/fit_icon_loseweight"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="24dp"
                android:textColor="@color/red_1"
                android:id="@+id/tv_lose_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="105"
                android:layout_toRightOf="@+id/no_loss"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white_6"
                android:id="@+id/iv_lose_weight_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="8dp"
                android:text="@string/f_jin_unit"
                android:layout_toRightOf="@+id/tv_lose_weight"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white_6"
                android:id="@+id/iv_lost_weight_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fit_p_change_weight"
                android:layout_toRightOf="@+id/no_loss"
                android:layout_below="@+id/tv_lose_weight"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
