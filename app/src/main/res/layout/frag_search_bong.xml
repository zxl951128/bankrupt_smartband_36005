<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/black_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:background="@null"
        style="@style/CommonTitle">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/left"
            android:background="@drawable/selector_set_item_bg"
            android:clickable="true"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="@dimen/common_title_height"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <TextView
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stop"
                android:lines="1"
                style="@style/CommonText.White"/>
        </LinearLayout>
        <TextView
            android:textSize="20dp"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/find_bong"
            android:lines="1"
            android:layout_centerInParent="true"
            style="@style/CommonText.White"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/right"
            android:background="@drawable/selector_set_item_bg"
            android:clickable="true"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="@dimen/common_title_height"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="18dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_info"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_vibrate"
            android:background="@drawable/anim_vibrate_bong"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:layout_marginRight="15dp"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/iv_no_vibrate"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/wristband_unlink"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <cn.ginshell.bong.ui.view.FindBongView
                android:id="@+id/find_bong_view"
                android:layout_width="@dimen/fit_search_view_size"
                android:layout_height="@dimen/fit_search_view_size"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/tv_find_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/find_device_tip1"
                style="@style/CommonText.White"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_signal_tip"
                android:background="@drawable/bg_corner_green"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="visible"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:text="@string/signal_power"
                style="@style/CommonText.White"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_dbm"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="30dp"
                    android:ellipsize="end"
                    android:id="@+id/tv_dbm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_value"
                    android:lines="1"
                    style="@style/CommonText.White"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rssi_unit"
                    android:lines="1"
                    style="@style/CommonText.White"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
