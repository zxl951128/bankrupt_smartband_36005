<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            style="@style/SetItem">
            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/f_my_fit"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:background="@color/white"
            style="@style/SetItem">
            <ImageView
                android:id="@+id/no_icon_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_weight_green"
                style="@style/ItemIconText"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/f_fit_weight_unit"
                android:layout_toRightOf="@+id/no_icon_weight"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/radio_group"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:weightSum="2"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <RadioButton
                    android:textSize="12dp"
                    android:textColor="@color/selector_black_white_checked"
                    android:gravity="center"
                    android:id="@+id/radioBtn_jin"
                    android:background="@drawable/selector_fit_radio_left"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:button="@null"
                    android:text="@string/f_jin_unit"
                    android:layout_weight="1"/>
                <RadioButton
                    android:textSize="12dp"
                    android:textColor="@color/selector_black_white_checked"
                    android:gravity="center"
                    android:id="@+id/radioBtn_kg"
                    android:background="@drawable/selector_fit_radio_right"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:text="@string/f_kg_unit"
                    android:layout_weight="1"/>
            </RadioGroup>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin"
        android:layout_marginBottom="@dimen/item_model_margin">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/rl_firmware_update"
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            style="@style/SetItem">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/iv_firmware_update"
                android:text="@string/icon_upgrade"
                android:includeFontPadding="false"
                style="@style/ItemIconText"/>
            <TextView
                android:id="@+id/tv_sys_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_bong_firmware_update"
                android:layout_toRightOf="@+id/iv_firmware_update"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <View
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@+id/tv_sys_update"
                android:layout_centerVertical="true"
                style="@style/RedPoint"/>
            <TextView
                android:textSize="15dp"
                android:id="@+id/tv_sys_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/iv_left_more"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textColor="@color/black"
                android:id="@+id/iv_left_more"
                android:layout_marginLeft="5dp"
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/ItemIconTextRight"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_toRightOf="@+id/iv_firmware_update"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_fit_tip"
            android:background="@drawable/selector_btn_white"
            android:visibility="visible"
            android:clickable="true"
            style="@style/SetItem">
            <ImageView
                android:id="@+id/iv_tip"
                android:layout_width="wrap_content"
                android:src="@drawable/icon_fit_tips"
                style="@style/ItemIconText"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fit_user_guide"
                android:layout_toRightOf="@+id/iv_tip"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_toRightOf="@+id/iv_tip"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_unbind"
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            style="@style/SetItem">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/iv_unbind_img"
                android:text="@string/icon_unbind"
                style="@style/ItemIconText"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_bong_unbind"
                android:layout_toRightOf="@+id/iv_unbind_img"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
