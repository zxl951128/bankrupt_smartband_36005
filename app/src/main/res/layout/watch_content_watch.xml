<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="8dp"
        android:text="@string/plate_set"
        style="@style/SetItemTipText"/>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout style="@style/SetItemGroup">
        <RelativeLayout
            android:id="@+id/watch_plate"
            android:clickable="true"
            style="@style/SetItem.Padding.Click">
            <ImageView
                android:id="@+id/plate_icon"
                android:src="@drawable/watch_clock"
                style="@style/SetItemImgIcon"/>
            <LinearLayout
                android:id="@+id/plate_text_pan"
                android:layout_toRightOf="@+id/plate_icon"
                style="@style/SetItemTextPan">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_plate"
                    style="@style/SetItemTitle"/>
                <TextView
                    android:text="@string/plate_desc"
                    style="@style/SetItemDesc"/>
            </LinearLayout>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textColor="@color/black"
                android:layout_marginLeft="5dp"
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                style="@style/ItemIconTextRight"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignLeft="@+id/plate_text_pan"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout style="@style/SetItem.Padding">
            <ImageView
                android:id="@+id/weather_icon"
                android:src="@drawable/watch_weather"
                style="@style/SetItemImgIcon"/>
            <LinearLayout
                android:id="@+id/weather_text_pan"
                android:layout_toRightOf="@+id/weather_icon"
                style="@style/SetItemTextPan">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weather_title"
                    style="@style/SetItemTitle"/>
                <TextView
                    android:text="@string/weather_desc"
                    style="@style/SetItemDesc"/>
            </LinearLayout>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/weather_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignLeft="@+id/weather_text_pan"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout style="@style/SetItem.Padding">
            <ImageView
                android:id="@+id/sport_icon"
                android:src="@drawable/watch_sporttype"
                style="@style/SetItemImgIcon"/>
            <LinearLayout
                android:id="@+id/sport_text_pan"
                android:layout_toRightOf="@+id/sport_icon"
                style="@style/SetItemTextPan">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_sport"
                    style="@style/SetItemTitle"/>
                <TextView
                    android:text="@string/sport_desc"
                    style="@style/SetItemDesc"/>
            </LinearLayout>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/sport_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignLeft="@+id/sport_text_pan"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout style="@style/SetItem.Padding">
            <ImageView
                android:id="@+id/ch_icon"
                android:src="@drawable/watch_hr"
                style="@style/SetItemImgIcon"/>
            <LinearLayout
                android:id="@+id/ch_text_pan"
                android:layout_toRightOf="@+id/ch_icon"
                style="@style/SetItemTextPan">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_heart_title"
                    style="@style/SetItemTitle"/>
                <TextView
                    android:text="@string/ch_desc"
                    style="@style/SetItemDesc"/>
            </LinearLayout>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/ch_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignLeft="@+id/ch_text_pan"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout style="@style/SetItem.Padding">
            <ImageView
                android:id="@+id/timer_icon"
                android:src="@drawable/watch_timer"
                style="@style/SetItemImgIcon"/>
            <LinearLayout
                android:id="@+id/timer_text_pan"
                android:layout_toRightOf="@+id/timer_icon"
                style="@style/SetItemTextPan">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timer"
                    style="@style/SetItemTitle"/>
                <TextView
                    android:text="@string/timer_desc"
                    style="@style/SetItemDesc"/>
            </LinearLayout>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/timer_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
</merge>
