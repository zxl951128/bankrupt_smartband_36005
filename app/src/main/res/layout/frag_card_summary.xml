<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/black_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/part_actionbar"/>
    <RelativeLayout
        android:padding="@dimen/card_top_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/white_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_tip"/>
        <ImageView
            android:background="@color/btn_bg_yellow"
            android:padding="1px"
            android:layout_width="@dimen/card_img_width"
            android:layout_height="@dimen/card_img_height"
            android:src="@drawable/card_img_summary"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/set_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <ImageView
            android:background="@color/set_split_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:clickable="true"
            android:layout_marginLeft="15dp"
            style="@style/SetItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_set_smart"
                android:layout_centerVertical="true"
                style="@style/CommonText.White"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/smart_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/set_split_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="@dimen/card_describe_margin"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="6dp"
        android:text="@string/card_set_summary_tip"
        android:singleLine="false"
        style="@style/CommonText.Tip"/>
</LinearLayout>
