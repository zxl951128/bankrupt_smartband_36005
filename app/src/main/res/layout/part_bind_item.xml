<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_bong"
            android:background="@drawable/selector_btn_white"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bind_item_height">
            <ImageView
                android:id="@+id/device_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bind_icon_2p"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="bong 3"/>
        </LinearLayout>
        <View
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_fit"
            android:background="@drawable/selector_btn_white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bind_item_height">
            <ImageView
                android:id="@+id/fit_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bind_icon_2p"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/fit_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="bong Fit"/>
        </LinearLayout>
        <View
            android:id="@+id/ll_fit_line"
            android:visibility="gone"
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_add"
            android:background="@drawable/selector_btn_white"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bind_item_height">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_add"/>
            <TextView
                android:textColor="@color/green_1"
                android:id="@+id/tv_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/bind_fit"/>
        </LinearLayout>
        <View
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
</LinearLayout>
