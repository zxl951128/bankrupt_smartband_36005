<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/iv_close"
        style="@style/CloseButton"/>
    <RelativeLayout
        android:id="@+id/rl_password"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/iv_close"
        style="@style/CommonItem">
        <TextView
            android:id="@+id/tv_password"
            android:layout_marginLeft="5dp"
            android:text="@string/register_password"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <EditText
            android:id="@+id/et_password"
            android:paddingLeft="5dp"
            android:layout_marginLeft="10dp"
            android:maxLength="20"
            android:layout_toRightOf="@+id/tv_password"
            android:layout_centerVertical="true"
            android:inputType="textPassword"
            style="@style/CommonEditText"/>
        <View
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_marginTop="15dp"
        android:layout_below="@+id/rl_password"
        style="@style/CommonItem">
        <TextView
            android:id="@+id/tv_password_repeat"
            android:layout_marginLeft="5dp"
            android:text="@string/register_password_repeat"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <EditText
            android:id="@+id/et_password_repeat"
            android:paddingLeft="5dp"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/tv_password_repeat"
            android:layout_centerVertical="true"
            android:inputType="textPassword"
            style="@style/CommonEditText"/>
        <View
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <Button
        android:id="@+id/btn_register_next"
        android:text="@string/register_step_next"
        android:layout_alignParentBottom="true"
        style="@style/StyleButtonYellow"/>
</RelativeLayout>
