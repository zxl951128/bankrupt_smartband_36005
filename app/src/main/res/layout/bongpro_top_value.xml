<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="wrap_content"
    android:layout_height="61dp">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textColor="@color/white"
        android:id="@+id/top_icon"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="5dp"
        android:text="@string/icon_distance"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textSize="60dp"
        android:textColor="@color/white"
        android:id="@+id/top_value"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/icon_8"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/white"
        android:id="@+id/unit_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kilo_meter"/>
</LinearLayout>
