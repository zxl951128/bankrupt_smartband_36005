<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView xmlns:android="http://schemas.android.com/apk/res/android"
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <ImageView
            android:id="@+id/iv_step"
            android:layout_width="15dp"
            android:layout_height="22dp"
            android:layout_marginLeft="15dp"
            android:src="@drawable/sport_steps"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/sport_steps"
            android:layout_toRightOf="@+id/iv_step"
            style="@style/CommonText.ItemBlack"/>
        <TextView
            android:textSize="16dp"
            android:id="@+id/tv_step_percent_before"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="@string/compare_with_before"
            android:layout_alignParentRight="true"
            style="@style/CommonText.ItemBlack"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">
        <TextView
            android:textSize="28dp"
            android:textColor="@color/green_3"
            android:id="@+id/tv_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="14567"
            style="@style/CommonText.ItemBlack"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/green_3"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/sport_steps_unit"
            android:layout_toRightOf="@+id/tv_steps"
            android:layout_alignBottom="@+id/tv_steps"
            style="@style/CommonText.ItemBlack"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textColor="@color/sport_percent_up"
            android:id="@+id/iv_step_up_or_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="@string/icon_arrow_up"
            android:includeFontPadding="false"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/sport_percent_up"
            android:id="@+id/tv_step_percent"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:text="@string/sport_percent_unit"
            android:layout_toLeftOf="@+id/iv_step_up_or_down"
            android:layout_alignBottom="@+id/tv_steps"
            style="@style/CommonText.ItemBlack"/>
        <TextView
            android:textSize="28dp"
            android:textColor="@color/sport_percent_up"
            android:id="@+id/tv_step_change_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8.3"
            android:layout_toLeftOf="@+id/tv_step_percent"
            style="@style/CommonText.ItemBlack"/>
    </RelativeLayout>
    <ImageView
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="8dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <ImageView
            android:id="@+id/iv_power"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="15dp"
            android:src="@drawable/sport_energy"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/sport_power"
            android:layout_toRightOf="@+id/iv_power"
            style="@style/CommonText.ItemBlack"/>
        <TextView
            android:textSize="16dp"
            android:id="@+id/tv_power_percent_before"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="@string/compare_with_before"
            android:layout_alignParentRight="true"
            style="@style/CommonText.ItemBlack"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">
        <TextView
            android:textSize="28dp"
            android:textColor="@color/bong_color"
            android:id="@+id/tv_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="856"
            style="@style/CommonText.ItemBlack"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/bong_color"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/sport_power_unit"
            android:layout_toRightOf="@+id/tv_power"
            android:layout_alignBottom="@+id/tv_power"
            style="@style/CommonText.ItemBlack"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textColor="@color/sport_percent_up"
            android:id="@+id/iv_power_up_or_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="@string/icon_arrow_up"
            android:includeFontPadding="false"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/sport_percent_up"
            android:id="@+id/tv_power_percent"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:text="@string/sport_percent_unit"
            android:layout_toLeftOf="@+id/iv_power_up_or_down"
            android:layout_alignBottom="@+id/tv_power_change_percent"
            style="@style/CommonText.ItemBlack"/>
        <TextView
            android:textSize="28dp"
            android:textColor="@color/sport_percent_up"
            android:id="@+id/tv_power_change_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5.6"
            android:layout_toLeftOf="@+id/tv_power_percent"
            style="@style/CommonText.ItemBlack"/>
    </RelativeLayout>
    <ImageView
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_device_tip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="15dp"/>
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="65dp">
            <LinearLayout
                android:gravity="center"
                android:background="@color/red_1"
                android:layout_width="50dp"
                android:layout_height="match_parent">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="30dp"
                    android:textColor="@color/white"
                    android:text="@string/icon_tips"
                    style="@style/ItemIconText"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/fit_tip_size"
                android:gravity="start|center_vertical"
                android:id="@+id/tv_device"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="20dp"
                android:singleLine="false"
                android:layout_weight="1"
                style="@style/CommonText.ItemBlack"/>
        </LinearLayout>
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <ImageView
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="15dp"/>
    </LinearLayout>
</LinearLayout>
