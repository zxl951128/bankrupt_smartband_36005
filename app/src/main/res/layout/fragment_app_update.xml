<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="1">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="@dimen/title_size"
        android:textColor="@color/bong_color"
        android:gravity="center"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/found_new_version"/>
    <View
        android:background="@color/bong_color"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp">
        <LinearLayout
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/new_version_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/update_new_version"
                style="@style/CommonText.Update"/>
            <TextView
                android:layout_marginTop="13dp"
                android:text="@string/update_content"
                style="@style/CommonText.Update"/>
            <TextView
                android:theme="@style/CommonText.Update"
                android:ellipsize="none"
                android:id="@+id/update_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="15dp"
                android:maxLines="50"
                android:singleLine="false"/>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:text="@string/update_app_tip"
        android:singleLine="false"
        style="@style/CommonText.Update"/>
    <android.support.v7.widget.AppCompatCheckBox
        android:theme="@style/MyCheckBox"
        android:textSize="@dimen/text_common_tip_size"
        android:textColor="@color/white_tip"
        android:id="@+id/ignore_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="@string/ignore_version"/>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <TextView
            android:textSize="@dimen/common_text_size"
            android:textColor="@color/gray"
            android:gravity="center"
            android:id="@+id/next_time"
            android:background="@drawable/selector_btn_normal"
            android:padding="10dp"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/update_later"
            android:layout_weight="1"/>
        <View
            android:background="@color/white_c"
            android:layout_width="1px"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/common_text_size"
            android:textColor="@color/bong_color"
            android:gravity="center"
            android:id="@+id/update"
            android:background="@drawable/selector_btn_normal"
            android:padding="10dp"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/update_rigth_now"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
