<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/black_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/tab_bar"
        layout="@layout/part_actionbar"/>
    <RelativeLayout
        android:id="@+id/rl_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/tab_bar">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/my_bong_update_img"
            android:id="@+id/iv_update_img"
            android:text="@string/icon_upgrade"
            android:layout_centerHorizontal="true"
            style="@style/CommonIconText"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/iv_update_img"
            android:layout_centerHorizontal="true">
            <TextView
                android:textColor="@color/white_tip"
                android:id="@+id/tv_update_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_firmware_name"
                style="@style/CommonText.White"/>
            <TextView
                android:textColor="@color/white_tip"
                android:id="@+id/tv_old_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/default_value"
                style="@style/CommonText.White"/>
            <TextView
                android:id="@+id/tv_to"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/arrow_right"
                style="@style/CommonText.White"/>
            <TextView
                android:id="@+id/tv_new_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/default_value"
                style="@style/CommonText.White"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_update_des"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="15dp"
        android:layout_above="@+id/tv_update_tip"
        android:layout_below="@+id/rl_top">
        <TextView
            android:textColor="@color/white_tip"
            android:text="@string/update_new_function"
            style="@style/CommonText.White"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_update_contain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
        </ScrollView>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:id="@+id/tv_update_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="15dp"
        android:text="@string/update_tip"
        android:singleLine="false"
        android:layout_above="@+id/ll_bottom"
        android:lineSpacingMultiplier="1.2"
        style="@style/CommonText.Tip"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true">
        <cn.ginshell.bong.ui.view.NumberProgressBar
            android:id="@+id/number_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            style="@style/NumberProgressBar_Yellow"/>
    </LinearLayout>
</RelativeLayout>
