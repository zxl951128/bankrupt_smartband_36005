<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/rl_heart"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="35dp">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/ll_pace_tip"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="15dp">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/pro_pace_statistic_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            android:text="@string/icon_pace_tip"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:text="@string/pace_statistics"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/unit_min_km"/>
    </LinearLayout>
    <cn.ginshell.bong.ui.view.pro.ProPaceChart
        android:id="@+id/pace_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bong_pro_common_padding"
        android:layout_marginTop="24dp"
        android:layout_marginRight="@dimen/bong_pro_common_padding"
        android:layout_below="@+id/ll_pace_data"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_pace_data"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3"
        android:layout_below="@+id/ll_pace_tip">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="22dp"
                android:textColor="@color/black"
                android:id="@+id/min_pace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_value"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/min_pace"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="22dp"
                android:textColor="@color/black"
                android:id="@+id/avg_pace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_value"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/average_pace"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="22dp"
                android:textColor="@color/black"
                android:id="@+id/max_pace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_value"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/max_pace"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/pace_tip"
        android:paddingLeft="@dimen/bong_content_margin_left"
        android:paddingRight="@dimen/bong_content_margin_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="30dp"
        android:layout_below="@+id/pace_chart">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/view_pace_best"
                    android:background="@drawable/bg_corner_heart_chart"
                    android:layout_width="@dimen/sleep_pro_indicator_wide"
                    android:layout_height="@dimen/sleep_pro_indicator_size"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/pro_pace_best"
                    style="@style/CommonText.Tip"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="48dp">
                <View
                    android:id="@+id/view_pace_ordinary"
                    android:background="@drawable/bg_corner_heart_chart"
                    android:layout_width="@dimen/sleep_pro_indicator_wide"
                    android:layout_height="@dimen/sleep_pro_indicator_size"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/pro_pace_ordinary"
                    style="@style/CommonText.Tip"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_more_pace"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="44dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="22dp"
        android:layout_below="@+id/pace_tip"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white_6"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/more_pace"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="10dp"
            android:textColor="@color/white_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="@string/icon_forward"/>
    </LinearLayout>
    <View
        android:id="@+id/pace_line"
        android:background="#80cccccc"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="1px"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/ll_more_pace"/>
</RelativeLayout>
