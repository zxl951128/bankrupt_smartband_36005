<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/rl_parent"
    android:background="@color/pro_sport_top_color"
    android:layout_width="match_parent"
    android:layout_height="120dp">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="30dp"
        android:layout_alignParentLeft="true">
        <TextView
            android:textSize="30dp"
            android:textColor="@color/white"
            android:id="@+id/tv_sport_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/out_run"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="5dp"
            android:text="@string/default_time_period_value"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/bong_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="8dp"
            android:text="share_through_device bongOO"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginRight="30dp"
        android:layout_alignParentRight="true">
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/user_img"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/user_img_default"
            android:scaleType="fitXY"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:layout_gravity="right"
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="用户名"
            android:layout_toRightOf="@+id/user_img"
            android:layout_alignTop="@+id/user_img"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white"
            android:id="@+id/describe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/share_describe"
            android:layout_below="@+id/user_name"
            android:layout_alignLeft="@+id/user_name"/>
    </LinearLayout>
</RelativeLayout>
