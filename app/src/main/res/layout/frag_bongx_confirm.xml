<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:background="@color/green_1"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <TextView
            android:textSize="18dp"
            android:id="@+id/tv_bind_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bind_near_device"
            android:layout_centerInParent="true"
            style="@style/CommonText.White"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_product_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/set_2p_1"
                android:scaleType="centerInside"
                android:layout_centerInParent="true"
                android:scaleX="0.8"
                android:scaleY="0.8"/>
            <ImageView
                android:id="@+id/iv_bongx_shock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/anim_bongx_shock"
                android:scaleType="centerInside"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/green_4"
            android:id="@+id/tv_is_ensure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/bind_is_device_shock"
            style="@style/CommonText.Black"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:weightSum="5">
        <TextView
            android:gravity="center"
            android:id="@+id/btn_no"
            android:layout_width="0dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="8dp"
            android:text="@string/set_no"
            android:layout_weight="1.7"
            style="@style/BorderButtonGreenLight"/>
        <TextView
            android:gravity="center"
            android:id="@+id/btn_yes"
            android:layout_width="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="15dp"
            android:text="@string/set_yes"
            android:layout_weight="3.2"
            style="@style/BorderButtonGreen"/>
    </LinearLayout>
</LinearLayout>
