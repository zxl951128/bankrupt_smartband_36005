<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View xmlns:android="http://schemas.android.com/apk/res/android"
        android:background="@drawable/fade_sport"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sport_bar_bg_height2"/>
    <RelativeLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/left"
            android:paddingRight="5dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="@string/icon_back"/>
        <TextView
            android:textSize="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_sport"
            android:layout_centerInParent="true"
            style="@style/CommonText.White"/>
    </RelativeLayout>
    <cn.ginshell.bong.ui.view.report.PagerCheckTabStrip
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="-5dp"
        android:layout_below="@+id/title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/tabs"/>
</RelativeLayout>
