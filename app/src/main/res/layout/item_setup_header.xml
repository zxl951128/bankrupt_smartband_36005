<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/set_top"
        android:background="@drawable/selector_btn_white"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="18dp"
            android:id="@+id/tv_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="@string/set_bind_bongx2"
            android:layout_centerVertical="true"
            style="@style/CommonText"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:layout_marginLeft="5dp"
            android:layout_toRightOf="@+id/tv_product_name"
            android:layout_centerVertical="true"
            style="@style/RedPoint"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/item_icon_text_size"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="@string/icon_forward"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/common_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="26dp"
            android:textColor="@color/green_1"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="5dp"
            android:text="@string/icon_card"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:text="@string/card_flow_value"
            style="@style/CommonText"/>
    </LinearLayout>
</LinearLayout>
