<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="horizontal"
    android:id="@+id/group_content"
    android:tag="layout/item_group_rec_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/group_icon"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginLeft="15dp"
        android:layout_centerVertical="true"
        xmlns:ns1="http://schemas.android.com/apk/res-auto" 
        ns1:placeholderImage="@drawable/img_group_official"
        xmlns:ns2="http://schemas.android.com/apk/res-auto" 
        ns2:roundAsCircle="true"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingLeft="15dp"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_toRightOf="@+id/group_icon">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:ellipsize="start"
            android:id="@+id/group_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="华东跑渣群"
            android:maxLines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white_9"
            android:ellipsize="start"
            android:id="@+id/group_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-3dp"
            android:text="1223人"
            android:maxLines="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/contain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:layout_alignParentBottom="true"
        style="@style/DividerLine"/>
</RelativeLayout>
