<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white_f7"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:background="@color/green_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_title_height">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/current_user"
            android:padding="5dp"
            android:visibility="visible"
            android:layout_width="@dimen/common_title_height"
            android:layout_height="@dimen/common_title_height"
            xmlns:ns1="http://schemas.android.com/apk/res-auto" 
            ns1:placeholderImage="@mipmap/appicon"
            xmlns:ns2="http://schemas.android.com/apk/res-auto" 
            ns2:roundAsCircle="true"/>
        <ImageView
            android:id="@+id/family_tip"
            android:padding="5dp"
            android:visibility="invisible"
            android:layout_width="@dimen/common_title_height"
            android:layout_height="@dimen/common_title_height"
            android:layout_marginLeft="-28dp"
            android:src="@drawable/anim_focus"
            android:layout_toRightOf="@+id/current_user"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_report"
            android:layout_centerInParent="true"
            style="@style/CommonText.White"/>
    </RelativeLayout>
    <View style="@style/DividerLine"/>
    <include layout="@layout/part_data_no_bind"/>
    <include layout="@layout/part_report_bottom"/>
</LinearLayout>
