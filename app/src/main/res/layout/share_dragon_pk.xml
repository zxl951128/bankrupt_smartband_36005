<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/share_dragon_pk_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:tag="binding_1"
        android:background="@color/dragon_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:paddingTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_horizontal_margin"
            android:layout_marginRight="@dimen/common_horizontal_margin">
            <ImageView
                android:id="@+id/user_img"
                android:layout_width="@dimen/share_head_image_size"
                android:layout_height="@dimen/share_head_image_size"
                android:src="@drawable/user_img_default"
                android:scaleType="fitXY"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textSize="24dp"
                android:textColor="@color/white"
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="4dp"
                android:text="Bong"
                android:layout_toRightOf="@+id/user_img"
                android:layout_alignTop="@+id/user_img"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/white"
                android:id="@+id/describe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/share_describe"
                android:layout_below="@+id/user_name"
                android:layout_alignLeft="@+id/user_name"/>
        </RelativeLayout>
        <android.support.constraint.ConstraintLayout
            android:background="@drawable/pk_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_horizontal_margin"
            android:layout_marginTop="15dp"
            android:layout_marginRight="@dimen/common_horizontal_margin"
            android:layout_marginBottom="15dp">
            <TextView
                android:id="@+id/add_exp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="30dp"
                android:text="EXP: +500"
                xmlns:ns1="http://schemas.android.com/apk/res-auto" 
                ns1:layout_constraintLeft_toRightOf="@+id/dragon"
                xmlns:ns2="http://schemas.android.com/apk/res-auto" 
                ns2:layout_constraintRight_toRightOf="parent"
                xmlns:ns3="http://schemas.android.com/apk/res-auto" 
                ns3:layout_constraintTop_toTopOf="@+id/dragon"
                style="@style/DragonPkTextView.Add"/>
            <ImageView
                android:id="@+id/dragon"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="70dp"
                android:src="@drawable/dragon_lv1"
                xmlns:ns4="http://schemas.android.com/apk/res-auto" 
                ns4:layout_constraintLeft_toLeftOf="parent"
                xmlns:ns5="http://schemas.android.com/apk/res-auto" 
                ns5:layout_constraintRight_toLeftOf="@+id/add_exp"
                xmlns:ns6="http://schemas.android.com/apk/res-auto" 
                ns6:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/add_atk"
                android:text="ATK: +500"
                xmlns:ns7="http://schemas.android.com/apk/res-auto" 
                ns7:layout_constraintLeft_toLeftOf="@+id/add_exp"
                xmlns:ns8="http://schemas.android.com/apk/res-auto" 
                ns8:layout_constraintRight_toRightOf="@+id/add_exp"
                xmlns:ns9="http://schemas.android.com/apk/res-auto" 
                ns9:layout_constraintTop_toBottomOf="@+id/add_exp"
                style="@style/DragonPkTextView.Add"/>
            <TextView
                android:id="@+id/add_def"
                android:text="EXP: +500"
                xmlns:ns10="http://schemas.android.com/apk/res-auto" 
                ns10:layout_constraintLeft_toLeftOf="@+id/add_atk"
                xmlns:ns11="http://schemas.android.com/apk/res-auto" 
                ns11:layout_constraintRight_toRightOf="@+id/add_atk"
                xmlns:ns12="http://schemas.android.com/apk/res-auto" 
                ns12:layout_constraintTop_toBottomOf="@+id/add_atk"
                style="@style/DragonPkTextView.Add"/>
            <TextView
                android:id="@+id/add_luk"
                android:layout_marginBottom="0dp"
                android:text="EXP: +500"
                xmlns:ns13="http://schemas.android.com/apk/res-auto" 
                ns13:layout_constraintLeft_toLeftOf="@+id/add_def"
                xmlns:ns14="http://schemas.android.com/apk/res-auto" 
                ns14:layout_constraintRight_toRightOf="@+id/add_def"
                xmlns:ns15="http://schemas.android.com/apk/res-auto" 
                ns15:layout_constraintTop_toBottomOf="@+id/add_def"
                style="@style/DragonPkTextView.Add"/>
            <TextView
                android:textSize="18dp"
                android:id="@+id/hp_bg"
                android:background="@drawable/pk_tb2"
                android:paddingLeft="15dp"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="0dp"
                android:text="HP : "
                xmlns:ns16="http://schemas.android.com/apk/res-auto" 
                ns16:layout_constraintLeft_toLeftOf="@+id/dragon"
                xmlns:ns17="http://schemas.android.com/apk/res-auto" 
                ns17:layout_constraintRight_toRightOf="@+id/add_luk"
                xmlns:ns18="http://schemas.android.com/apk/res-auto" 
                ns18:layout_constraintTop_toBottomOf="@+id/dragon"
                style="@style/DragonPkTextView.Add"/>
            <cn.ginshell.bong.ui.view.ShareProgress
                android:id="@+id/hp_progress"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginLeft="60dp"
                android:layout_marginRight="15dp"
                xmlns:ns19="http://schemas.android.com/apk/res-auto" 
                ns19:layout_constraintBottom_toBottomOf="@+id/hp_bg"
                xmlns:ns20="http://schemas.android.com/apk/res-auto" 
                ns20:layout_constraintLeft_toLeftOf="@+id/hp_bg"
                xmlns:ns21="http://schemas.android.com/apk/res-auto" 
                ns21:layout_constraintRight_toRightOf="@+id/hp_bg"
                xmlns:ns22="http://schemas.android.com/apk/res-auto" 
                ns22:layout_constraintTop_toTopOf="@+id/hp_bg"
                xmlns:ns23="http://schemas.android.com/apk/res-auto" 
                ns23:progress="0.6"/>
            <TextView
                android:id="@+id/name1"
                android:layout_width="0dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="5dp"
                android:text="Player1"
                xmlns:ns24="http://schemas.android.com/apk/res-auto" 
                ns24:layout_constraintLeft_toRightOf="@+id/atk_row"
                xmlns:ns25="http://schemas.android.com/apk/res-auto" 
                ns25:layout_constraintRight_toLeftOf="@+id/name2"
                xmlns:ns26="http://schemas.android.com/apk/res-auto" 
                ns26:layout_constraintTop_toBottomOf="@+id/hp_bg"
                style="@style/DragonPkTextView.Attr"/>
            <TextView
                android:id="@+id/name2"
                android:layout_width="0dp"
                android:layout_marginLeft="5dp"
                android:text="Player2"
                xmlns:ns27="http://schemas.android.com/apk/res-auto" 
                ns27:layout_constraintLeft_toRightOf="@+id/name1"
                xmlns:ns28="http://schemas.android.com/apk/res-auto" 
                ns28:layout_constraintRight_toRightOf="@+id/hp_bg"
                xmlns:ns29="http://schemas.android.com/apk/res-auto" 
                ns29:layout_constraintTop_toTopOf="@+id/name1"
                style="@style/DragonPkTextView.Attr"/>
            <TextView
                android:id="@+id/atk_row"
                android:text="@string/atk_value"
                xmlns:ns30="http://schemas.android.com/apk/res-auto" 
                ns30:layout_constraintLeft_toLeftOf="@+id/dragon"
                xmlns:ns31="http://schemas.android.com/apk/res-auto" 
                ns31:layout_constraintTop_toBottomOf="@+id/name1"
                style="@style/DragonPkTextView.ValueName"/>
            <TextView
                android:id="@+id/cri_row"
                android:text="@string/cri_value"
                xmlns:ns32="http://schemas.android.com/apk/res-auto" 
                ns32:layout_constraintLeft_toLeftOf="@+id/atk_row"
                xmlns:ns33="http://schemas.android.com/apk/res-auto" 
                ns33:layout_constraintTop_toBottomOf="@+id/atk_row"
                style="@style/DragonPkTextView.ValueName"/>
            <TextView
                android:id="@+id/eva_row"
                android:layout_marginBottom="50dp"
                android:text="@string/eva_value"
                xmlns:ns34="http://schemas.android.com/apk/res-auto" 
                ns34:layout_constraintBottom_toBottomOf="parent"
                xmlns:ns35="http://schemas.android.com/apk/res-auto" 
                ns35:layout_constraintLeft_toLeftOf="@+id/cri_row"
                xmlns:ns36="http://schemas.android.com/apk/res-auto" 
                ns36:layout_constraintTop_toBottomOf="@+id/cri_row"
                style="@style/DragonPkTextView.ValueName"/>
            <TextView
                android:id="@+id/atk1"
                android:text="123"
                xmlns:ns37="http://schemas.android.com/apk/res-auto" 
                ns37:layout_constraintLeft_toLeftOf="@+id/name1"
                xmlns:ns38="http://schemas.android.com/apk/res-auto" 
                ns38:layout_constraintRight_toRightOf="@+id/name1"
                xmlns:ns39="http://schemas.android.com/apk/res-auto" 
                ns39:layout_constraintTop_toTopOf="@+id/atk_row"
                style="@style/DragonPkTextView.Value"/>
            <TextView
                android:id="@+id/cri1"
                android:text="123"
                xmlns:ns40="http://schemas.android.com/apk/res-auto" 
                ns40:layout_constraintLeft_toLeftOf="@+id/name1"
                xmlns:ns41="http://schemas.android.com/apk/res-auto" 
                ns41:layout_constraintRight_toRightOf="@+id/name1"
                xmlns:ns42="http://schemas.android.com/apk/res-auto" 
                ns42:layout_constraintTop_toTopOf="@+id/cri_row"
                style="@style/DragonPkTextView.Value"/>
            <TextView
                android:id="@+id/eva1"
                android:text="123"
                xmlns:ns43="http://schemas.android.com/apk/res-auto" 
                ns43:layout_constraintLeft_toLeftOf="@+id/name1"
                xmlns:ns44="http://schemas.android.com/apk/res-auto" 
                ns44:layout_constraintRight_toRightOf="@+id/name1"
                xmlns:ns45="http://schemas.android.com/apk/res-auto" 
                ns45:layout_constraintTop_toTopOf="@+id/eva_row"
                style="@style/DragonPkTextView.Value"/>
            <TextView
                android:id="@+id/atk2"
                android:text="123"
                xmlns:ns46="http://schemas.android.com/apk/res-auto" 
                ns46:layout_constraintLeft_toLeftOf="@+id/name2"
                xmlns:ns47="http://schemas.android.com/apk/res-auto" 
                ns47:layout_constraintRight_toRightOf="@+id/name2"
                xmlns:ns48="http://schemas.android.com/apk/res-auto" 
                ns48:layout_constraintTop_toTopOf="@+id/atk_row"
                style="@style/DragonPkTextView.Value"/>
            <TextView
                android:id="@+id/cri2"
                android:text="123"
                xmlns:ns49="http://schemas.android.com/apk/res-auto" 
                ns49:layout_constraintLeft_toLeftOf="@+id/name2"
                xmlns:ns50="http://schemas.android.com/apk/res-auto" 
                ns50:layout_constraintRight_toRightOf="@+id/name2"
                xmlns:ns51="http://schemas.android.com/apk/res-auto" 
                ns51:layout_constraintTop_toTopOf="@+id/cri_row"
                style="@style/DragonPkTextView.Value"/>
            <TextView
                android:id="@+id/eva2"
                android:text="123"
                xmlns:ns52="http://schemas.android.com/apk/res-auto" 
                ns52:layout_constraintLeft_toLeftOf="@+id/name2"
                xmlns:ns53="http://schemas.android.com/apk/res-auto" 
                ns53:layout_constraintRight_toRightOf="@+id/name2"
                xmlns:ns54="http://schemas.android.com/apk/res-auto" 
                ns54:layout_constraintTop_toTopOf="@+id/eva_row"
                style="@style/DragonPkTextView.Value"/>
        </android.support.constraint.ConstraintLayout>
        <include layout="@layout/share_footer"/>
    </LinearLayout>
</ScrollView>
