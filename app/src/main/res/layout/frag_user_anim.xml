<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/user_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/actionbar_green"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rl_sport_goal"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/register_goal_sport"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_sport_input"
                android:text="@string/register_default_sport"
                android:layout_toLeftOf="@+id/tv_sport_unit"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_sport_unit"
                android:layout_marginRight="10dp"
                android:text="@string/register_unit_daka"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/rl_sleep_goal"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/register_goal_sleep"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:gravity="center"
                android:id="@+id/et_sleep_input"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="@string/register_default_sleep"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/rl_step_goal"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_goal_step"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:gravity="center"
                android:id="@+id/et_step_input"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="8000"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
