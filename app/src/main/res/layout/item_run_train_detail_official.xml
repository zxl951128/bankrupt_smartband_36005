<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/item_run_train_detail_official_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_weight="3">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/official_time"
            android:background="@drawable/run_train_gray_circle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="5\10min"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/official_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/fast_walk_name"
            android:layout_weight="2"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white_3"
            android:layout_gravity="center"
            android:id="@+id/official_speed_relax"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/relax_speed"
            android:layout_weight="1"/>
        <LinearLayout
            android:layout_gravity="center"
            android:id="@+id/ll_number"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="25dp"
                android:textColor="@color/white_3"
                android:gravity="right"
                android:layout_gravity="center"
                android:id="@+id/official_speed_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/value_null"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white_3"
                android:gravity="right"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=" km/h"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/small_circle"
        android:background="@drawable/run_train_gray_small_circle"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="10dp"/>
</LinearLayout>
