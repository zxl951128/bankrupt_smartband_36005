<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/title"
        android:background="@color/green_1"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/left"
            android:paddingRight="5dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="@string/icon_back"/>
        <TextView
            android:textSize="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bind_near_device"
            android:layout_centerInParent="true"
            style="@style/CommonText.White"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_title_refresh"
        android:background="@color/white_f7"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/title">
        <com.wang.avi.AVLoadingIndicatorView
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_marginRight="15dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            xmlns:ns1="http://schemas.android.com/apk/res-auto" 
            ns1:indicatorColor="@color/green_2"
            xmlns:ns2="http://schemas.android.com/apk/res-auto" 
            ns2:indicatorName="BallPulseIndicator"/>
        <View
            android:background="@color/white_9"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_title_refresh"/>
    <ViewSwitcher
        android:id="@+id/ble_view_switch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title"
        android:foregroundGravity="center">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/phone"/>
            <cn.ginshell.bong.ui.view.LineLoadingView
                android:id="@+id/lineLoadingView"
                android:layout_width="10dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:src="@drawable/bong_device"/>
            <TextView
                android:textSize="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/bind_new_near_bong"
                style="@style/CommonText.Black"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="50dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:src="@drawable/bong_device_error"/>
                <TextView
                    android:textSize="14dp"
                    android:id="@+id/tv_find_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/bind_not_found_bong"
                    style="@style/CommonText.Black"/>
            </LinearLayout>
            <TextView
                android:id="@+id/btn_search_again"
                android:layout_marginLeft="30dp"
                android:layout_marginRight="30dp"
                android:layout_marginBottom="50dp"
                android:text="@string/bind_search_again"
                android:layout_alignParentBottom="true"
                style="@style/BorderButtonGreen"/>
        </RelativeLayout>
    </ViewSwitcher>
</RelativeLayout>
