<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="horizontal"
    android:id="@+id/item"
    android:tag="layout/item_home_sleep_0"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/sleep"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="@dimen/item_margin_top"
            android:layout_marginBottom="@dimen/item_margin_bottom">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="@dimen/item_icon_size"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_h_sleep"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sleep"/>
        </LinearLayout>
        <cn.ginshell.bong.ui.home.StageResultView
            android:id="@+id/result_view"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginLeft="15dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="15dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.75">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="22dp"
                android:textColor="@color/sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="5dp"
                android:text="@string/icon_h_deepsleep"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/black"
                android:id="@+id/hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/black"
                android:id="@+id/hour_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hour"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/black"
                android:id="@+id/min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/black"
                android:id="@+id/min_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minute"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="15dp">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="12dp"
                android:textColor="@color/sleep"
                android:gravity="center"
                android:id="@+id/star_one"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/icon_h_start_full"
                android:layout_weight="1"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="12dp"
                android:textColor="@color/sleep"
                android:gravity="center"
                android:id="@+id/star_two"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/icon_h_start_full"
                android:layout_weight="1"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="12dp"
                android:textColor="@color/sleep"
                android:gravity="center"
                android:id="@+id/star_three"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/icon_h_start_full"
                android:layout_weight="1"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="12dp"
                android:textColor="@color/sleep"
                android:gravity="center"
                android:id="@+id/star_four"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/icon_h_start_full"
                android:layout_weight="1"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="12dp"
                android:textColor="@color/sleep"
                android:gravity="center"
                android:id="@+id/star_five"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/icon_h_start_full"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textSize="16dp"
        android:gravity="center"
        android:id="@+id/more_icon"
        android:background="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="10dp"
        android:text="@string/icon_forward"/>
</LinearLayout>
