<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:background="@drawable/bg_gradient_green"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/rl_logo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:layout_below="@+id/iv_close">
        <RelativeLayout
            android:id="@+id/rl_user_img"
            android:background="@drawable/user_bg"
            android:padding="1dp"
            android:layout_width="121dp"
            android:layout_height="121dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/iv_user_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/default_user_img"
                android:scaleType="fitXY"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RadioGroup
            android:orientation="horizontal"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:weightSum="2"
            android:layout_below="@+id/rl_user_img"
            android:layout_centerHorizontal="true">
            <RadioButton
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/radioBtn_male"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:button="@null"
                android:text="@string/set_male"
                android:drawableTop="@drawable/cb_user_male"
                android:drawablePadding="5dp"
                android:layout_weight="1"/>
            <RadioButton
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/radioBtn_female"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:button="@null"
                android:text="@string/set_female"
                android:drawableTop="@drawable/cb_user_female"
                android:drawablePadding="5dp"
                android:layout_weight="1"/>
        </RadioGroup>
    </RelativeLayout>
    <RelativeLayout
        android:layout_marginTop="15dp"
        android:layout_below="@+id/rl_logo"
        style="@style/CommonItem">
        <TextView
            android:id="@+id/tv_nick_name"
            android:layout_marginLeft="5dp"
            android:text=""
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <EditText
            android:id="@+id/et_nick_input"
            android:paddingLeft="5dp"
            android:layout_marginLeft="10dp"
            android:maxLines="1"
            android:layout_toRightOf="@+id/tv_nick_name"
            android:layout_centerVertical="true"
            android:inputType="text"
            style="@style/CommonEditText"/>
        <View
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <android.support.v7.widget.AppCompatButton
        android:gravity="center"
        android:id="@+id/btn_register_next"
        android:clickable="true"
        android:layout_marginTop="10dp"
        android:text="@string/register_step_next"
        android:layout_alignParentBottom="true"
        style="@style/RelativeNextBtn"/>
</RelativeLayout>
