<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:background="@drawable/bg_gradient_green"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/iv_close"
        android:text="@string/icon_back"
        style="@style/CloseButton"/>
    <RelativeLayout
        android:id="@+id/rl_activity"
        android:visibility="gone"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/iv_close"
        style="@style/CommonItem.Click">
        <TextView
            android:layout_marginLeft="5dp"
            android:text="@string/register_goal_activity"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <TextView
            android:gravity="center"
            android:id="@+id/et_activity_input"
            android:text="@string/register_default_activity"
            android:layout_toLeftOf="@+id/tv_activity_unit"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <TextView
            android:id="@+id/tv_activity_unit"
            android:layout_marginRight="10dp"
            android:text="@string/register_unit_fenzhong"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <View
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_sport"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/rl_activity"
        style="@style/CommonItem.Click">
        <TextView
            android:layout_marginLeft="5dp"
            android:text="@string/register_goal_sport"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <TextView
            android:id="@+id/tv_sport_unit"
            android:layout_marginRight="10dp"
            android:text="@string/register_unit_daka"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <View
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:gravity="center"
            android:id="@+id/et_sport_input"
            android:text="@string/register_default_sport"
            android:layout_alignBaseline="@+id/tv_sport_unit"
            android:layout_alignBottom="@+id/tv_sport_unit"
            android:layout_toStartOf="@+id/tv_sport_unit"
            style="@style/CommonText.White"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_sleep"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/rl_sport"
        style="@style/CommonItem.Click">
        <TextView
            android:layout_marginLeft="5dp"
            android:text="@string/register_goal_sleep"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <TextView
            android:gravity="center"
            android:id="@+id/et_sleep_input"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="@string/register_default_sleep"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <View
            android:background="@color/gray_light_f1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <android.support.v7.widget.AppCompatButton
        android:gravity="center"
        android:id="@+id/btn_register_next"
        android:clickable="true"
        android:layout_marginTop="10dp"
        android:text="@string/register_complete"
        android:layout_alignParentBottom="true"
        style="@style/RelativeNextBtn"/>
</RelativeLayout>
