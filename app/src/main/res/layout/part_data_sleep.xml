<?xml version="1.0" encoding="utf-8"?>
<cn.ginshell.bong.ui.view.report.InterceptLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/ill_sleep_report"
    android:background="@drawable/selector_white_to_black_light"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">
    <ImageView xmlns:android="http://schemas.android.com/apk/res/android"
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="@dimen/report_title_bar_height">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp">
            <TextView
                android:textSize="@dimen/data_main_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_sleep_title"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/sleep_bg_bottom"
                android:id="@+id/tv_sleep_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 小时 25 分钟"
                style="@style/CommonText.ItemBlack"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_sleep_badge_contain"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/no_icon_sleep_goto"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textColor="@color/sport_x_text"
            android:id="@+id/no_icon_sleep_goto"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="15dp"
            android:text="@string/icon_forward"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/ItemIconTextRight"/>
    </RelativeLayout>
    <cn.ginshell.bong.ui.view.report.ReportSleepChart
        android:id="@+id/sleep_chart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_sport_bar_height"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="5dp"/>
    <ImageView
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
</cn.ginshell.bong.ui.view.report.InterceptLinearLayout>
