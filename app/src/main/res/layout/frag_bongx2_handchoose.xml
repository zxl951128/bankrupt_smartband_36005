<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:background="@color/green_1"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <TextView
            android:textSize="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bind_x2_title"
            android:layout_centerInParent="true"
            style="@style/CommonText.White"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="22dp"
            android:gravity="center"
            android:id="@+id/tip1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/set_choose_hand"
            style="@style/CommonText.Black"/>
        <RadioGroup
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/tip1"
            android:layout_centerHorizontal="true">
            <RadioButton
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/radioBtn_left"
                android:background="@drawable/selector_radio_yellow"
                android:layout_width="@dimen/radio_width"
                android:layout_height="@dimen/radio_height"
                android:layout_marginRight="10dp"
                android:button="@null"
                android:text="@string/set_left_hand"
                android:drawablePadding="5dp"/>
            <RadioButton
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/radioBtn_right"
                android:background="@drawable/selector_radio_yellow"
                android:layout_width="@dimen/radio_width"
                android:layout_height="@dimen/radio_height"
                android:layout_marginLeft="10dp"
                android:button="@null"
                android:text="@string/set_right_hand"
                android:drawablePadding="5dp"/>
        </RadioGroup>
        <Button
            android:layout_gravity="bottom"
            android:id="@+id/btn_complete"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="20dp"
            android:text="@string/set_confirm"
            android:layout_alignParentBottom="true"
            style="@style/StyledButtonGreen"/>
    </RelativeLayout>
</LinearLayout>
