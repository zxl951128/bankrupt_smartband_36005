<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/part_gps_sport_top"
    android:background="@color/pro_sport_top_color"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_alignParentTop="true">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/pro_data_number_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/left_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/pro_data_name_size"
            android:textColor="@color/white_60"
            android:gravity="center"
            android:id="@+id/left_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kilometer_distance"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/pro_data_number_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/center_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/pro_data_name_size"
            android:textColor="@color/white_60"
            android:gravity="center"
            android:id="@+id/center_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_time"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/pro_data_number_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/right_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/pro_data_name_size"
            android:textColor="@color/white_60"
            android:gravity="center"
            android:id="@+id/right_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/expend_energy"/>
    </LinearLayout>
</LinearLayout>
