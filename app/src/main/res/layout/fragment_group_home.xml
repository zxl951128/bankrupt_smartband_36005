<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/fragment_group_home_0"
    android:background="@color/white_f2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:tag="binding_1"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/group_title"
            android:lines="1"
            android:layout_centerInParent="true"
            style="@style/CommonText"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/icon_add_group"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_add"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/group"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14dp"
                        android:gravity="center"
                        android:id="@+id/tv_scan_group"
                        android:background="@color/white_f0"
                        android:paddingLeft="5dp"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/group_search_id"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/img_search"
                        android:layout_marginStart="20dp"/>
                    <ImageView
                        android:id="@+id/iv_scan"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_margin="15dp"
                        android:src="@drawable/img_scan"
                        android:scaleType="fitXY"/>
                </LinearLayout>
                <View style="@style/DividerLine"/>
                <View
                    android:layout_marginTop="15dp"
                    style="@style/DividerLine"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="36dp">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="@color/black"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:text="@string/group_my"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="@color/green_1"
                            android:gravity="center"
                            android:id="@+id/tv_expand_group"
                            android:paddingLeft="15dp"
                            android:paddingRight="15dp"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/group_expand_all"/>
                    </LinearLayout>
                    <View style="@style/DividerLine"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/no_group"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/group_no_group"/>
                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/my_group_list"
                        android:paddingBottom="12dp"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <View style="@style/DividerLine"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_recommend"
                    android:background="@color/white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp">
                    <View style="@style/DividerLine"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginLeft="15dp"
                        android:text="@string/group_recommend"/>
                    <View style="@style/DividerLine"/>
                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/recommend_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/no_data"
                android:background="@color/white_f2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="120dp"
                    android:src="@drawable/nodata"/>
                <TextView
                    android:textSize="@dimen/common_text_size"
                    android:textColor="@color/green_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="150dp"
                    android:text="@string/check_network_config"/>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
