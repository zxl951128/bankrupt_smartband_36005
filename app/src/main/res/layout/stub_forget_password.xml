<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/stub_forget_password_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="@dimen/fit_tip_size"
        android:textColor="@color/white"
        android:id="@+id/phone_num_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_horizontal_margin"
        android:text="@string/phone_number"
        xmlns:ns1="http://schemas.android.com/apk/res-auto" 
        ns1:layout_constraintLeft_toLeftOf="@+id/country_code"
        xmlns:ns2="http://schemas.android.com/apk/res-auto" 
        ns2:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/common_text_size"
        android:textColor="@color/green_1"
        android:gravity="center"
        android:id="@+id/country_code"
        android:tag="binding_1"
        android:background="@color/white"
        android:paddingLeft="15dp"
        android:paddingTop="10dp"
        android:paddingRight="15dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_horizontal_margin"
        android:layout_marginTop="8dp"
        android:minWidth="60dp"
        android:layout_marginStart="@dimen/common_horizontal_margin"
        xmlns:ns3="http://schemas.android.com/apk/res-auto" 
        ns3:layout_constraintLeft_toLeftOf="parent"
        xmlns:ns4="http://schemas.android.com/apk/res-auto" 
        ns4:layout_constraintTop_toBottomOf="@+id/phone_num_tip"/>
    <android.support.v7.widget.AppCompatEditText
        android:id="@+id/login_name"
        android:inputType="phone"
        xmlns:ns5="http://schemas.android.com/apk/res-auto" 
        ns5:layout_constraintBaseline_toBaselineOf="@+id/country_code"
        xmlns:ns6="http://schemas.android.com/apk/res-auto" 
        ns6:layout_constraintLeft_toRightOf="@+id/country_code"
        xmlns:ns7="http://schemas.android.com/apk/res-auto" 
        ns7:layout_constraintRight_toRightOf="parent"
        style="@style/AccountEditor.Phone">
        <requestFocus/>
    </android.support.v7.widget.AppCompatEditText>
</android.support.constraint.ConstraintLayout>
