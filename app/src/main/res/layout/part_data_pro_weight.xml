<?xml version="1.0" encoding="utf-8"?>
<cn.ginshell.bong.ui.view.report.InterceptLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/ill_weight_report"
    android:tag="layout/part_data_pro_weight_0"
    android:background="@drawable/selector_white_to_black_light"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fit_p_report"
            android:layout_centerVertical="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textColor="@color/black"
            android:text="@string/icon_forward"
            android:layout_alignParentRight="true"
            style="@style/ItemIconTextRight"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_sport_bar_height"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp">
        <cn.ginshell.bong.report.weight.WeightChart
            android:id="@+id/weight_chart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_sport_bar_height"/>
        <ImageView
            android:id="@+id/iv_no_pic_weight"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_sport_cover_height"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/pic_weight"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="-10dp"
        android:layout_marginRight="8dp">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white_6"
            android:id="@+id/tv_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8/19"
            android:layout_centerVertical="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="11dp"
            android:textColor="@color/black"
            android:id="@+id/tv_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9/19"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</cn.ginshell.bong.ui.view.report.InterceptLinearLayout>
