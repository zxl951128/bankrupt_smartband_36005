<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/action_bar_common"
    android:background="@color/title_bg"
    style="@style/CommonTitle.Transparent">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="20dp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/title_left"
        android:background="@drawable/selector_btn_normal"
        android:layout_width="@dimen/common_title_width"
        android:layout_height="match_parent"
        android:text="@string/icon_back"
        android:layout_alignParentLeft="true"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textSize="20dp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/title_right"
        android:background="@drawable/selector_btn_normal"
        android:layout_width="@dimen/common_title_width"
        android:layout_height="match_parent"
        android:text="@string/icon_back"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="20dp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:lines="1"
        android:layout_toLeftOf="@+id/title_right"
        android:layout_toRightOf="@+id/title_left"
        android:layout_centerInParent="true"
        style="@style/CommonText"/>
</RelativeLayout>
