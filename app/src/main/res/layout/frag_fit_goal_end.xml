<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:background="@color/green_1"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title_left"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/selector_text_normal"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/fit_goal"
            android:lines="1"
            android:layout_weight="1"
            style="@style/CommonText"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/selector_text_normal"
            android:gravity="center"
            android:background="@drawable/selector_btn_normal"
            android:visibility="invisible"
            android:layout_width="@dimen/title_btn_width"
            android:layout_height="match_parent"
            android:text="@string/fit_edit"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            android:text="@string/fit_g_w_end"
            android:layout_above="@+id/ll_goal"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp">
                <TextView
                    android:textSize="60dp"
                    android:textColor="@color/red_1"
                    android:gravity="center"
                    android:id="@+id/tv_weight_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/red_1"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/f_kg_unit"
                    android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f_bmi"/>
                    <TextView
                        android:textSize="20dp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_bmi_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:text="23.4"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/item_tv_state"
                        android:background="@drawable/f_state_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/f_normal"/>
                </LinearLayout>
            </LinearLayout>
            <cn.ginshell.bong.ui.widget.HorizontalRulerView
                android:id="@+id/fit_weight_ruler"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_centerInParent="true"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_next"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:minWidth="140dp"
            android:text="@string/fit_goal_over"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            style="@style/BorderButtonGreen"/>
    </RelativeLayout>
</LinearLayout>
