<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:background="@color/green_1"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title_left"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/selector_text_normal"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/fit_goal"
            android:lines="1"
            android:layout_weight="1"
            style="@style/CommonText"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/selector_text_normal"
            android:gravity="center"
            android:background="@drawable/selector_btn_normal"
            android:visibility="invisible"
            android:layout_width="@dimen/title_btn_width"
            android:layout_height="match_parent"
            android:text="@string/fit_edit"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp"
            android:text="@string/fit_goal_ad"
            android:layout_above="@+id/ll_goal"
            android:layout_centerHorizontal="true"
            android:lineSpacingMultiplier="1.3"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <RadioGroup
                android:orientation="vertical"
                android:id="@+id/radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/rb_loss"
                    android:button="@null"
                    android:text="@string/fit_goal_loss"
                    style="@style/SelectTextView"/>
                <RadioButton
                    android:id="@+id/rb_body"
                    android:button="@null"
                    android:text="@string/fit_goal_body"
                    style="@style/SelectTextView"/>
                <RadioButton
                    android:id="@+id/rb_muscle"
                    android:button="@null"
                    android:text="@string/fit_goal_muscle"
                    style="@style/SelectTextView"/>
            </RadioGroup>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
