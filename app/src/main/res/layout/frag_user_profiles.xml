<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/user_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/actionbar_green"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_top"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <ImageView
            android:background="@color/user_item_line"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:clickable="true"
            android:layout_height="@dimen/user_img_item_height"
            style="@style/SetItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_profile_photo"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <RelativeLayout
                android:id="@+id/rl_user_img"
                android:background="@drawable/user_bg"
                android:padding="1px"
                android:layout_width="@dimen/user_profile_img_size"
                android:layout_height="@dimen/user_profile_img_size"
                android:layout_toLeftOf="@+id/tv_right_more"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/iv_user_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/user_img_default"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="14dp"
                android:id="@+id/tv_right_more"
                android:layout_marginLeft="10dp"
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                style="@style/ItemIconTextRight"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:id="@+id/p_nick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_profile_nick"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <EditText
                android:gravity="center"
                android:id="@+id/et_user_nick"
                android:background="@null"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@+id/p_nick"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:id="@+id/p_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_profile_bong_id"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <EditText
                android:textColorHint="@color/user_item_tip"
                android:gravity="center"
                android:id="@+id/et_user_bong_id"
                android:background="@null"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="15dp"
                android:hint="@string/user_bong_id_hint"
                android:layout_toRightOf="@+id/p_id"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:id="@+id/bong_id_tip"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="15dp"
        android:text="@string/user_bong_id_tip"
        android:singleLine="false"
        style="@style/CommonText.Tip"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/rl_user_sex"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_profile_sex"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_user_sex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:text="@string/set_female"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_user_high"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/register_high_name"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_user_high"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_value"
                android:layout_toLeftOf="@+id/tv_user_high_unit"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_user_high_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:text="@string/bong_unit_cm"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_user_weight"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_profile_weight"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_user_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/tv_user_weight_unit"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_user_weight_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:text="@string/bong_unit_kg"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_user_birth"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_profile_birth"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_user_birth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/tv_user_birth_unit"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_user_birth_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:text="@string/bong_unit_year"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
