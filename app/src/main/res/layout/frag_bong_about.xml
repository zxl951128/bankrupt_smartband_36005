<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/user_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/actionbar_green"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:id="@+id/tv_app_version"
                android:layout_marginLeft="15dp"
                android:text="@string/user_about_app_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_app"
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@+id/tv_app_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_firm"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:id="@+id/tv_firm_version"
                android:layout_marginLeft="15dp"
                android:text="@string/user_about_firm_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_firm"
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@+id/tv_firm_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_font"
            android:visibility="gone"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:id="@+id/tv_font_version"
                android:layout_marginLeft="15dp"
                android:text="@string/user_about_font_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_font"
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@+id/tv_font_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_build_time"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:id="@+id/tv_build_time_version"
                android:layout_marginLeft="15dp"
                android:text="@string/user_about_build_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_build_time"
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@+id/tv_build_time_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_environment"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:id="@+id/tv_environment_version"
                android:layout_marginLeft="15dp"
                android:text="@string/user_about_environment_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_environment"
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@+id/tv_environment_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_mac"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:id="@+id/tv_mac_version"
                android:layout_marginLeft="15dp"
                android:text="@string/user_about_mac_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_mac"
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@+id/tv_mac_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_fit_mac"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:id="@+id/tv_fit_mac_version"
                android:layout_marginLeft="15dp"
                android:text="@string/f_version_mac"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_fit_mac"
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@+id/tv_fit_mac_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:id="@+id/tv_algorithm_version"
                android:layout_marginLeft="15dp"
                android:text="@string/algorithm_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:id="@+id/tv_algorithm"
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@+id/tv_algorithm_version"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
