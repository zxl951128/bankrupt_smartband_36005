<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/rl_title_bar"
    style="@style/CommonTitle.Black">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center"
        android:id="@+id/left"
        android:background="@drawable/selector_set_item_bg"
        android:clickable="true"
        android:layout_width="@dimen/common_title_width"
        android:layout_height="@dimen/common_title_height"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:id="@+id/icon_left"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_back"/>
    </LinearLayout>
    <TextView
        android:textSize="20dp"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bong"
        android:lines="1"
        android:layout_toLeftOf="@+id/right"
        android:layout_toRightOf="@+id/left"
        android:layout_centerInParent="true"
        style="@style/CommonText.White"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/right"
        android:background="@drawable/selector_set_item_bg"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="@dimen/common_title_width"
        android:layout_height="@dimen/common_title_height"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:id="@+id/icon_right"
            android:paddingLeft="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_close"/>
    </LinearLayout>
    <View
        android:background="@color/bong_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
