<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:id="@+id/setting_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <RelativeLayout
            android:id="@+id/rl_my_bongx"
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_bong">
            <ImageView
                android:id="@+id/img_setting_device"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/b3_setting_device"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toRightOf="@+id/img_setting_device">
                <TextView
                    android:textSize="20dp"
                    android:textColor="@color/black"
                    android:id="@+id/bong_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的 bong4"
                    style="@style/CommonText"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/system_update_reminder"
                    android:background="@drawable/update_version_bg"
                    android:padding="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/system_update_reminder"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="@dimen/item_icon_text_size"
                    android:textColor="@color/black"
                    android:id="@+id/forward_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:id="@+id/charging"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/icon_charging"
                    android:layout_toLeftOf="@+id/forward_img"
                    android:layout_centerVertical="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_toLeftOf="@+id/charging">
                    <cn.ginshell.bong.ui.view.BatteryView
                        android:layout_gravity="center"
                        android:id="@+id/battery_view"
                        android:layout_width="12dp"
                        android:layout_height="26dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:id="@+id/battery_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </RelativeLayout>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/device_desc_setting"
                style="@style/DeviceDescTip"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <RelativeLayout
                    android:id="@+id/bong3_plate"
                    android:background="@drawable/selector_btn_white"
                    android:clickable="false"
                    style="@style/SetItem.Padding">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/icon_bong3_plate"
                        android:text="@string/icon_plate"
                        style="@style/ItemIconText.Green"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bong_plate"
                        android:layout_toRightOf="@+id/icon_bong3_plate"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.ItemBlack"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/black"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                    <View
                        android:background="@color/white_c"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_toRightOf="@+id/icon_bong3_plate"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_bong4_screen"
                    android:background="@drawable/selector_btn_white"
                    android:clickable="false"
                    style="@style/SetItem.Padding">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/icon_bong4_screen"
                        android:text="@string/icon_fitbit"
                        style="@style/ItemIconText.Green"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/black"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                    <View
                        android:background="@color/white_c"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_toRightOf="@+id/icon_bong4_screen"
                        android:layout_alignParentBottom="true"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bong3_screen_display"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/icon_bong4_screen"
                        style="@style/CommonText.ItemBlack"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_screen"
                    android:background="@drawable/selector_btn_white"
                    android:visibility="visible"
                    android:clickable="true"
                    style="@style/SetItem">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/icon_screen"
                        android:layout_marginLeft="24dp"
                        android:text="@string/icon_screen"
                        style="@style/ItemIconText.Green"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_display"
                        android:layout_toRightOf="@+id/icon_screen"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.ItemBlack"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/black"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="27dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                    <View
                        android:id="@+id/bong3hr_hidden_line"
                        android:background="@color/white_c"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_toRightOf="@+id/icon_screen"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/gesture_control"
                    android:background="@drawable/selector_btn_white"
                    android:clickable="true"
                    style="@style/SetItem">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/icon_gesture"
                        android:layout_marginLeft="24dp"
                        android:text="@string/icon_hand"
                        style="@style/ItemIconText.Green"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/black"
                        android:id="@+id/iconTextView"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="27dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gesture_control_name"
                        android:layout_alignTop="@+id/iconTextView"
                        android:layout_alignBottom="@+id/iconTextView"
                        android:layout_toEndOf="@+id/icon_gesture"
                        style="@style/CommonText.ItemBlack"/>
                </RelativeLayout>
            </LinearLayout>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
        <TextView
            android:text="@string/device_desc_healthy"
            style="@style/DeviceDescTip"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_heart_all"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <RelativeLayout
                android:id="@+id/rl_auto_heart_monitor"
                android:clickable="true"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/auto_no_icon_heart"
                    android:text="@string/icon_cracked_heart"
                    style="@style/ItemIconText.Green"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_smart_heart"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/auto_no_icon_heart"
                    style="@style/CommonText.ItemBlack"/>
                <View
                    android:id="@+id/auto_heart"
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/auto_no_icon_heart"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_heart_monitor"
                android:clickable="true"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_heart"
                    android:text="@string/icon_measure"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_heart"
                    android:layout_toRightOf="@+id/no_icon_heart"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/no_icon_heart"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_exercise_remind"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_exercise"
                    android:text="@string/icon_sedentary"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_sit_remind"
                    android:layout_toRightOf="@+id/no_icon_exercise"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:id="@+id/exercise_line"
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/no_icon_exercise"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_sleep_remind"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/ic_icon_sleep"
                    android:text="@string/icon_sleep_remind"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sleep_remind"
                    android:layout_toRightOf="@+id/ic_icon_sleep"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
            </RelativeLayout>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_toRightOf="@+id/no_icon_alarm"
                android:layout_alignParentBottom="true"/>
        </LinearLayout>
        <TextView
            android:text="@string/life_helper"
            style="@style/DeviceDescTip"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_alarm"
                android:clickable="true"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_alarm"
                    android:text="@string/icon_alarm"
                    style="@style/ItemIconText.Green"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:id="@+id/iconTextView2"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/no_icon_alarm"
                    android:layout_alignParentBottom="true"/>
                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_alarm"
                    android:layout_alignTop="@+id/iconTextView2"
                    android:layout_alignBottom="@+id/iconTextView2"
                    android:layout_toEndOf="@+id/no_icon_alarm"
                    style="@style/CommonText.ItemBlack"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_message"
                android:visibility="visible"
                android:clickable="true"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_message"
                    android:text="@string/icon_notification"
                    style="@style/ItemIconText.Green"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/no_icon_message"
                    android:layout_alignParentBottom="true"/>
                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/message_title"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/no_icon_message"
                    style="@style/CommonText.ItemBlack"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_tel_notification"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/icon_tel"
                    android:text="@string/icon_phone_call"
                    style="@style/ItemIconText.Green"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_tel"
                    android:layout_toRightOf="@+id/icon_tel"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/icon_tel"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_no_disturb"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/ic_no_disturb"
                    android:text="@string/icon_sleep"
                    style="@style/ItemIconText.Green"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_set_no_disturb"
                    android:layout_toRightOf="@+id/ic_no_disturb"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/ic_no_disturb"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_search"
                android:clickable="true"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_search"
                    android:text="@string/icon_find_bong"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_search"
                    android:layout_toRightOf="@+id/no_icon_search"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginBottom="30dp"/>
    </LinearLayout>
</ScrollView>
