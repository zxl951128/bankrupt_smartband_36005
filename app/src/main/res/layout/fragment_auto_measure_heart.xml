<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/fragment_auto_measure_heart_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_left"
            android:tag="binding_1"
            style="@style/TitleLeft"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_right"
            style="@style/TitleRight"/>
        <TextView
            android:id="@+id/title_center"
            android:text="@string/auto_measure_heart"
            style="@style/TitleCenter"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@drawable/b3_setting_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/b3_setting_heart"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/black_bg_80"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp"
            android:text="@string/auto_heart_measure"/>
    </RelativeLayout>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <RelativeLayout
        android:background="@color/white"
        android:clickable="false"
        style="@style/SetItem.Padding">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_measure_heart"
            android:layout_centerVertical="true"
            style="@style/CommonText.ItemBlack"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/sb_smart_heart"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/MaterialDesignStyle"/>
    </RelativeLayout>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_monitor"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_routine"
            android:background="@drawable/selector_btn_white"
            style="@style/SetItem.Padding">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_heart_routine"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textColor="@color/black"
                android:id="@+id/routine_state_monitor"
                android:layout_marginLeft="5dp"
                android:text="@string/icon_forward"
                style="@style/ItemIconTextRight"/>
            <TextView
                android:textSize="14dp"
                android:id="@+id/tv_routine_state_monitor"
                android:text="@string/auto_heart_routine_value"
                android:layout_toLeftOf="@+id/routine_state_monitor"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
