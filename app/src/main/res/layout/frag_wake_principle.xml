<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/frag_wake_principle_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        android:background="@color/purple_action_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_title_height">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title_left"
            android:tag="binding_1"
            android:background="@drawable/selector_btn_normal"
            android:clickable="true"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:gravity="center"
            android:id="@+id/title_right"
            android:background="@drawable/selector_btn_normal"
            android:visibility="invisible"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:text="@string/intelligent_wake_principle"
            android:lines="1"
            android:layout_toLeftOf="@+id/title_right"
            android:layout_toRightOf="@+id/title_left"
            android:layout_centerInParent="true"
            style="@style/CommonText"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:background="@color/purple_action_bar_bg"
                android:paddingLeft="20dp"
                android:paddingTop="30dp"
                android:paddingRight="20dp"
                android:paddingBottom="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/intelligent_wake_principle1"/>
            <TextView
                android:textSize="14sp"
                android:paddingLeft="40dp"
                android:paddingTop="30dp"
                android:paddingRight="40dp"
                android:paddingBottom="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/intelligent_wake_principle2"/>
            <ImageView
                android:id="@+id/pic_1"
                android:background="@drawable/wake_chart_1_ch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"/>
            <TextView
                android:textSize="14sp"
                android:paddingLeft="40dp"
                android:paddingTop="30dp"
                android:paddingRight="40dp"
                android:paddingBottom="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/intelligent_wake_principle3"/>
            <ImageView
                android:id="@+id/pic_2"
                android:background="@drawable/wake_chart_2_ch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
