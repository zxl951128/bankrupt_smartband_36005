<?xml version="1.0" encoding="utf-8"?>
<io.codetail.widget.RevealFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/fragment_sport_detail_0"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/rl_second_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/map_view_pan"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:id="@+id/rl_map_top"
            android:background="@color/black_bg_60"
            android:paddingTop="25dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="96dp">
            <TextView
                android:textSize="45dp"
                android:id="@+id/tv_small_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="0.0"
                style="@style/CommonText.White"/>
            <TextView
                android:textSize="11dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/sport_kilo_unit"
                android:layout_toRightOf="@+id/tv_small_top"
                android:layout_alignBottom="@+id/tv_small_top"
                style="@style/CommonText.WhiteTip"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:layout_alignParentRight="true">
                <cn.ginshell.bong.ui.view.TimerTextView
                    android:textSize="20dp"
                    android:id="@+id/tv_small_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/default_time_value"
                    style="@style/CommonText.White"/>
                <cn.ginshell.bong.ui.view.GpsVew
                    android:id="@+id/gps_small_signal"
                    android:layout_width="55dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:id="@+id/gps_weak_tip"
            android:background="@color/green_2"
            android:paddingLeft="5dp"
            android:paddingTop="10dp"
            android:paddingRight="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="82dp"
            android:layout_marginRight="15dp"
            android:text="@string/sport_gps_week"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_map_fuc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="60dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true">
            <ImageView
                android:id="@+id/iv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="35dp"
                android:src="@drawable/selector_map_location"/>
            <ImageView
                android:id="@+id/iv_reduce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/selector_map_reduce"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_foreground"
        android:background="@color/black_bg_90"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/tv_cursor"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/sport_map_cursor"
            android:scaleType="center"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="1">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                style="@style/CommonText.White"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <ImageView
                    android:id="@+id/iv_ble_disconnect"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:src="@drawable/ble_disconnect"/>
                <cn.ginshell.bong.ui.view.GpsVew
                    android:id="@+id/gps_signal"
                    android:visibility="gone"
                    android:layout_width="55dp"
                    android:layout_height="20dp"/>
            </LinearLayout>
            <cn.ginshell.bong.widget.AutofitTextView
                android:textSize="76dp"
                android:gravity="center"
                android:id="@+id/tv_top"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.0"
                style="@style/CommonText.White"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.45">
                    <cn.ginshell.bong.ui.view.TimerTextView
                        android:textSize="60dp"
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_time_value"
                        style="@style/CommonText.White"/>
                    <TextView
                        android:textSize="11dp"
                        android:gravity="center"
                        android:text="@string/sport_time_unit"
                        style="@style/CommonText.WhiteTip"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/top_left"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.45">
                    <TextView
                        android:textSize="24dp"
                        android:id="@+id/tv_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--&apos;--&apos;&apos;"
                        style="@style/CommonText.White"/>
                    <TextView
                        android:textSize="11dp"
                        android:gravity="center"
                        android:minWidth="80dp"
                        android:text="@string/sport_speed_unit"
                        style="@style/CommonText.WhiteTip"/>
                </LinearLayout>
            </LinearLayout>
            <cn.ginshell.bong.widget.HeartLevelView
                android:id="@+id/heat_level_view"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:id="@+id/tv_heart_suggestion"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sport_suggestion_1"
                android:maxLines="3"
                android:lineSpacingMultiplier="1.2"/>
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="40dp">
                <cn.ginshell.bong.widget.PressProgressView
                    android:id="@+id/press_progress"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="18dp"
                    android:textColor="@color/selector_text_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_press_btn"
                    android:lines="2"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_connect_tip"
            android:background="@color/red_1"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_tip_height"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="13dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_ble_disconnect"
                style="@style/CommonText.White"/>
        </LinearLayout>
    </RelativeLayout>
</io.codetail.widget.RevealFrameLayout>
