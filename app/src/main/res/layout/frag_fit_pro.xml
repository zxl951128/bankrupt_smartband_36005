<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/scroll_view"
        android:background="@color/blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_common">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/part_fit_pro_head"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/white_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="15dp"
                android:text="@string/fit_p_indicator"/>
            <View
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                style="@style/DividerLine"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <android.support.v7.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <include layout="@layout/part_fit_pro_goal"/>
            <include layout="@layout/part_fit_pro_bottom"/>
        </LinearLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/select_contain"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ll_common"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_common"
        android:background="@color/blue"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title_left"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_height"
            android:layout_height="match_parent"
            android:text="@string/icon_back"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/account_img"
                android:background="@drawable/circle_red_bg"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginRight="5dp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="120dp"
                android:text="--"
                android:lines="1"
                style="@style/CommonText"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:id="@+id/icon_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/icon_down"/>
        </LinearLayout>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="22dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/icon_share"
            android:layout_width="@dimen/common_title_height"
            android:layout_height="match_parent"
            android:text="@string/icon_plane"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/selector_text_normal"
            android:gravity="center"
            android:id="@+id/title_right"
            android:background="@drawable/selector_btn_normal"
            android:visibility="gone"
            android:layout_width="@dimen/common_title_height"
            android:layout_height="match_parent"
            android:text="@string/fit_edit"/>
    </LinearLayout>
</RelativeLayout>
