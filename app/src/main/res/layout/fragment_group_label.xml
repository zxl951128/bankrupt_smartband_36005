<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/fragment_group_label_0"
    android:background="@color/white_f2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:tag="binding_1"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/group_label"
            android:lines="1"
            android:layout_centerInParent="true"
            style="@style/CommonText"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/finish"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_finish"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <View style="@style/DividerLine"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/group_label"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/label_contain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <cn.ginshell.bong.group.view.TagListView
            android:id="@+id/tag_view"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            xmlns:ns1="http://schemas.android.com/apk/res-auto" 
            ns1:horizontalSpacing="15dp"
            xmlns:ns2="http://schemas.android.com/apk/res-auto" 
            ns2:orientation="horizontal"
            xmlns:ns3="http://schemas.android.com/apk/res-auto" 
            ns3:verticalSpacing="10dp"/>
        <View style="@style/DividerLine"/>
    </LinearLayout>
</LinearLayout>
