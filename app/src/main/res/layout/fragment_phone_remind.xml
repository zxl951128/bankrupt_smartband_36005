<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/fragment_phone_remind_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/action_bar_common"
            style="@style/CommonTitle.Green">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/title_left"
                android:tag="binding_1"
                style="@style/TitleLeft"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/title_right"
                style="@style/TitleRight"/>
            <TextView
                android:id="@+id/title_center"
                android:text="@string/phone_remind"
                style="@style/TitleCenter"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/DividerLine"/>
        </RelativeLayout>
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/reminder_icon"
                android:background="@drawable/bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/b3_setting_remind"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/reminder_icon"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/black_bg_80"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/phone_remind_desc"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="25dp"
                android:text="@string/bong4_phone_reminds"
                style="@style/SetItemTipText"/>
        </LinearLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:background="@color/white"
            android:paddingRight="0dp"
            android:clickable="false"
            style="@style/SetItem.Padding">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_remind"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="20dp"
                android:textColor="@color/green_1"
                android:gravity="center"
                android:id="@+id/phone_prompt"
                android:background="@drawable/selector_btn_normal"
                android:paddingTop="3dp"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="@string/icon_info_circle"
                android:layout_alignParentRight="true"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/tel_notification_switch"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="8dp"
                android:paddingBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/phone_prompt"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/black_bg_60"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="15dp"
        android:text="@string/phone_remindText"/>
</LinearLayout>
