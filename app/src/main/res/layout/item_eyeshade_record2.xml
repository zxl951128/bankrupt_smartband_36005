<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/eyeshade_detail"
    android:tag="layout/item_eyeshade_record2_0"
    android:layout_width="match_parent"
    android:layout_height="120dp">
    <View xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_gravity="center_horizontal"
        android:background="#e4e4e4"
        android:layout_width="3dp"
        android:layout_height="10dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@color/purple_bg"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="4.5">
            <RelativeLayout
                android:id="@+id/relative_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/bong_content_margin_left"
                android:layout_centerVertical="true">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="50dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/icon_mask"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:text="@string/icon_goggle"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/eyeshade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/eyeshade"
                    android:layout_below="@+id/icon_mask"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:background="@color/purple_bg"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="6.5">
            <cn.ginshell.bong.widget.EyeShadeRecordView
                android:id="@+id/record_view"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginRight="30dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7.5">
            <TextView
                android:textSize="16dp"
                android:id="@+id/sleep_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_centerHorizontal="true"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="18dp"
                android:textColor="@color/sleep_bg_top"
                android:id="@+id/rating_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="7dp"
                android:layout_below="@+id/sleep_quality"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="16dp"
                android:id="@+id/go"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_page_right"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
