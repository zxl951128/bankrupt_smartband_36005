<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/share_dragon_honor_0"
    android:background="@color/dragon_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:paddingTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_horizontal_margin"
        android:layout_marginRight="@dimen/common_horizontal_margin">
        <ImageView
            android:id="@+id/user_img"
            android:layout_width="@dimen/share_head_image_size"
            android:layout_height="@dimen/share_head_image_size"
            android:src="@drawable/user_img_default"
            android:scaleType="fitXY"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="24dp"
            android:textColor="@color/white"
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="4dp"
            android:text="bong"
            android:layout_toRightOf="@+id/user_img"
            android:layout_alignTop="@+id/user_img"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white"
            android:id="@+id/describe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/share_describe"
            android:layout_below="@+id/user_name"
            android:layout_alignLeft="@+id/user_name"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="540dp"
        android:layout_marginLeft="@dimen/common_horizontal_margin"
        android:layout_marginTop="15dp"
        android:layout_marginRight="@dimen/common_horizontal_margin"
        android:layout_marginBottom="20dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/dragon_honor"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/dragon"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="45dp"
                android:src="@drawable/win_cat4"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_name"
                android:background="@drawable/bg_dragon_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="hahaha"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp">
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_pk_total"
                    android:background="@drawable/bg_dragon_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="18dp"
                    android:text="@string/dragon_pk_total"
                    android:lines="2"
                    android:lineSpacingMultiplier="1.2"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_pk_rate"
                    android:background="@drawable/bg_dragon_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:text="@string/dragon_pk_rate"
                    android:lines="2"
                    android:lineSpacingMultiplier="1.2"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp">
                <ImageView
                    android:id="@+id/iv_honor_1"
                    android:layout_width="@dimen/dragon_honor_size"
                    android:layout_height="@dimen/dragon_honor_size"
                    android:src="@drawable/dragon_honor_1"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_honor_2"
                    android:layout_width="@dimen/dragon_honor_size"
                    android:layout_height="@dimen/dragon_honor_size"
                    android:src="@drawable/dragon_honor_2"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_honor_3"
                    android:layout_width="@dimen/dragon_honor_size"
                    android:layout_height="@dimen/dragon_honor_size"
                    android:src="@drawable/dragon_honor_3"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="60dp"
                android:layout_marginTop="-10dp"
                android:layout_marginRight="60dp">
                <ImageView
                    android:id="@+id/iv_honor_4"
                    android:layout_width="@dimen/dragon_honor_size"
                    android:layout_height="@dimen/dragon_honor_size"
                    android:src="@drawable/dragon_honor_4"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/iv_honor_5"
                    android:layout_width="@dimen/dragon_honor_size"
                    android:layout_height="@dimen/dragon_honor_size"
                    android:src="@drawable/dragon_honor_5"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <include layout="@layout/share_footer"/>
</LinearLayout>
