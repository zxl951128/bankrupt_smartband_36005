<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/item_train_record_ing_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/rl_train"
        android:background="#f2f2f2"
        android:layout_width="match_parent"
        android:layout_height="120dp">
        <cn.ginshell.bong.ui.view.RunTrainningDisplayView
            android:id="@+id/icon_arrow"
            android:layout_width="10dp"
            android:layout_height="match_parent"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentTop="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_grade_lock"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_grade"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="LV1"
                android:layout_toRightOf="@+id/icon_arrow"/>
        </LinearLayout>
        <View
            android:id="@+id/grade_line_one"
            android:background="@color/white_c"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/ll_grade_lock"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/warn_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="10dp"
            android:text="@string/warn_body_name"
            android:layout_toRightOf="@+id/grade_line_one"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/one_circle"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/grade_line_one"
            android:layout_below="@+id/warn_body"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/warn_body_circle"
                android:background="@drawable/run_train_gray_circle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="5\10min"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/warn_body_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fast_walk_name"/>
        </LinearLayout>
        <View
            android:id="@+id/grade_line_two"
            android:background="@color/white_c"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/one_circle"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/official_train"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="10dp"
            android:text="@string/official_train_name"
            android:layout_toRightOf="@+id/grade_line_two"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_official_circle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="-500dp"
            android:layout_toRightOf="@+id/grade_line_two"
            android:layout_below="@+id/official_train"
            android:layout_alignParentBottom="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/icon_forward"
            android:background="@drawable/run_train_arrow_bg_gradient"
            android:paddingLeft="15dp"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_forward"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</LinearLayout>
