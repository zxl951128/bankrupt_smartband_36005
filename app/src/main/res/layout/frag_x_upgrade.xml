<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center"
        android:background="@color/green_1"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <TextView
            android:textSize="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_title"
            style="@style/CommonText.White"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <cn.ginshell.bong.ui.view.CircleWaveLoadView
                android:id="@+id/circle_wave_load_view"
                android:layout_width="@dimen/upgrade_view_size"
                android:layout_height="@dimen/upgrade_view_size"
                android:layout_marginTop="20dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/green_4"
                android:id="@+id/update_status"
                android:layout_marginTop="10dp"
                android:text="升级中...30%"
                style="@style/CommonText.Black"/>
        </LinearLayout>
        <ScrollView
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="150dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_update_contain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:id="@+id/tv_update_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="15dp"
        android:text="@string/update_bong2s_tip"
        android:singleLine="false"
        android:lineSpacingMultiplier="1.2"
        style="@style/CommonText.BlackTip"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp">
        <TextView
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:padding="0dp"
            android:layout_width="0dp"
            android:layout_marginLeft="15dp"
            android:text="@string/next_try"
            android:singleLine="true"
            android:layout_weight="1.7"
            style="@style/BorderButtonGreenLight"/>
        <TextView
            android:gravity="center"
            android:id="@+id/btn_complete"
            android:layout_width="0dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:text="@string/repeat_upgrade"
            android:layout_weight="3.2"
            style="@style/BorderButtonGreen"/>
    </LinearLayout>
</LinearLayout>
