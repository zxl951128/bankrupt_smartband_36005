<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/parent"
    android:tag="layout/frag_respiting_pro_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/bong_pro_title"
            android:background="@color/pro_sport_state_bar_color"
            style="@style/CommonTitle">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="@dimen/icon_size"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/back"
                android:tag="binding_1"
                android:paddingLeft="@dimen/bong_pro_common_padding"
                android:paddingRight="@dimen/bong_pro_common_padding"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/icon_back"
                android:layout_alignParentLeft="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="@dimen/bong_pro_title_size"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/pro_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sleep"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/default_time_period_value"/>
            </LinearLayout>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="@dimen/icon_size"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/more_action"
                android:tag="binding_2"
                android:paddingLeft="@dimen/bong_pro_common_padding"
                android:paddingTop="7dp"
                android:paddingRight="@dimen/bong_pro_common_padding"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/icon_h_share"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <cn.ginshell.bong.ui.view.ProScrollView
            android:id="@+id/pro_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_share"
                    android:background="@color/pro_respite_top_color"
                    android:layout_width="match_parent"
                    android:layout_height="160dp">
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/sleep_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:layout_marginBottom="10dp"
                            android:layout_centerHorizontal="true">
                            <cn.ginshell.bong.ui.view.IconTextView
                                android:textSize="45dp"
                                android:textColor="@color/white"
                                android:gravity="top"
                                android:id="@+id/total_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/icon_7"
                                android:includeFontPadding="false"/>
                            <TextView
                                android:textSize="@dimen/pro_data_name_size"
                                android:textColor="@color/white_60"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/total_score"
                                style="@style/CommonText.Tip"/>
                        </LinearLayout>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingBottom="8dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <TextView
                                    android:textSize="@dimen/pro_data_number_size"
                                    android:textColor="@color/white"
                                    android:gravity="bottom"
                                    android:id="@+id/sleep_time_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                                <TextView
                                    android:textSize="@dimen/pro_data_name_size"
                                    android:textColor="@color/white_60"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/respite_relax_sleep"
                                    style="@style/CommonText.Tip"/>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="bottom|center_horizontal"
                                android:paddingBottom="8dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <cn.ginshell.bong.ui.view.IconTextView
                                    android:textSize="18dp"
                                    android:textColor="@color/white"
                                    android:id="@+id/rating_bar"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="2dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <include
                    android:id="@+id/part_respite_data"
                    layout="@layout/part_respite_pro_data"/>
                <RelativeLayout
                    android:id="@+id/rl_respite"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:id="@+id/ll_respite_tip"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="15dp">
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textSize="20dp"
                            android:textColor="@color/pro_respite_state_color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:layout_marginTop="5dp"
                            android:text="@string/icon_mask"/>
                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="7dp"
                            android:text="@string/respite_state"/>
                    </LinearLayout>
                    <cn.ginshell.bong.widget.EyeshadeSleepChartView
                        android:id="@+id/sleep_chart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginLeft="@dimen/bong_pro_common_padding"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="@dimen/bong_pro_common_padding"
                        android:layout_below="@+id/ll_respite_data"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/ll_respite_data"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="3"
                        android:layout_below="@+id/ll_respite_tip">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="22dp"
                                android:textColor="@color/black"
                                android:id="@+id/sober_duration_data"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/default_value"/>
                            <TextView
                                android:textSize="12dp"
                                android:textColor="@color/gray"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/respite_wake_up_length"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="22dp"
                                android:textColor="@color/black"
                                android:id="@+id/light_sleep_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/default_value"/>
                            <TextView
                                android:textSize="12dp"
                                android:textColor="@color/gray"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/respite_misted_length"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="22dp"
                                android:textColor="@color/black"
                                android:id="@+id/deep_sleep_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/default_value"/>
                            <TextView
                                android:textSize="12dp"
                                android:textColor="@color/gray"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/respite_deep_sleep_length"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/respite_tip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="50dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginRight="50dp"
                        android:weightSum="3"
                        android:layout_below="@+id/sleep_chart">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <View
                                android:id="@+id/view_sleep_tip"
                                android:background="@drawable/bg_corner_heart_chart"
                                android:layout_width="@dimen/sleep_pro_indicator_wide"
                                android:layout_height="@dimen/sleep_pro_indicator_size"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="@string/sleep_type_light"
                                style="@style/CommonText.Tip"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <View
                                android:id="@+id/view_misted_tip"
                                android:background="@drawable/bg_corner_heart_chart"
                                android:layout_width="@dimen/sleep_pro_indicator_wide"
                                android:layout_height="@dimen/sleep_pro_indicator_size"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="@string/respite_misted"
                                style="@style/CommonText.Tip"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <View
                                android:id="@+id/view_wake_tip"
                                android:background="@drawable/bg_corner_heart_chart"
                                android:layout_width="@dimen/sleep_pro_indicator_wide"
                                android:layout_height="@dimen/sleep_pro_indicator_size"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="@string/sleep_type_awake"
                                style="@style/CommonText.Tip"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:id="@+id/respite_line"
                        android:background="#80cccccc"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="1px"
                        android:layout_marginTop="40dp"
                        android:layout_below="@+id/respite_tip"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_music_download"
                    android:background="@color/white"
                    android:paddingLeft="20dp"
                    android:paddingTop="30dp"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:weightSum="2">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textSize="20dp"
                            android:textColor="@color/pro_respite_state_color"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/icon_media"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="@string/icon_music"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="@color/black"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/music"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="end|center_vertical"
                        android:id="@+id/music_download"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginRight="20dp"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="@color/gray"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/respite_more_music"/>
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textSize="13dp"
                            android:textColor="@color/gray"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:text="@string/icon_forward"/>
                    </LinearLayout>
                </LinearLayout>
                <include
                    android:id="@+id/bong_pro_tip"
                    layout="@layout/bongpro_tip_new"/>
            </LinearLayout>
        </cn.ginshell.bong.ui.view.ProScrollView>
    </LinearLayout>
</FrameLayout>
