<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/item_home_heart_0"
    android:background="@color/red_11"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="@dimen/item_margin_top"
                android:layout_marginBottom="12dp">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="@dimen/item_icon_size"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_h_hr"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/heart_rate"/>
            </LinearLayout>
            <cn.ginshell.bong.ui.home.StageResultView
                android:id="@+id/result_view"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginLeft="15dp"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.75">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_history"
                android:background="@drawable/round_stroke_white_bg"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="10dp"
                android:text="@string/home_heart_history"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="16dp"
            android:gravity="center"
            android:background="@color/white"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            android:text="@string/icon_forward"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/home_heart_range"
            android:layout_centerHorizontal="true"/>
        <cn.ginshell.bong.ui.home.RHRView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</LinearLayout>
