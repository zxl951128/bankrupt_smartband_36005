<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/activity_group_scan_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <cn.bingoogolapple.qrcode.zxing.ZXingView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/zxingview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:ns1="http://schemas.android.com/apk/res-auto" 
        ns1:qrcv_animTime="1000"
        xmlns:ns2="http://schemas.android.com/apk/res-auto" 
        ns2:qrcv_barcodeRectHeight="140dp"
        xmlns:ns3="http://schemas.android.com/apk/res-auto" 
        ns3:qrcv_borderColor="@android:color/transparent"
        xmlns:ns4="http://schemas.android.com/apk/res-auto" 
        ns4:qrcv_borderSize="1dp"
        xmlns:ns5="http://schemas.android.com/apk/res-auto" 
        ns5:qrcv_cornerColor="@android:color/white"
        xmlns:ns6="http://schemas.android.com/apk/res-auto" 
        ns6:qrcv_cornerLength="30dp"
        xmlns:ns7="http://schemas.android.com/apk/res-auto" 
        ns7:qrcv_cornerSize="4dp"
        xmlns:ns8="http://schemas.android.com/apk/res-auto" 
        ns8:qrcv_customScanLineDrawable="@drawable/group_scanning_bar"
        xmlns:ns9="http://schemas.android.com/apk/res-auto" 
        ns9:qrcv_isBarcode="false"
        xmlns:ns10="http://schemas.android.com/apk/res-auto" 
        ns10:qrcv_isCenterVertical="false"
        xmlns:ns11="http://schemas.android.com/apk/res-auto" 
        ns11:qrcv_isOnlyDecodeScanBoxArea="true"
        xmlns:ns12="http://schemas.android.com/apk/res-auto" 
        ns12:qrcv_isScanLineReverse="true"
        xmlns:ns13="http://schemas.android.com/apk/res-auto" 
        ns13:qrcv_isShowDefaultGridScanLineDrawable="false"
        xmlns:ns14="http://schemas.android.com/apk/res-auto" 
        ns14:qrcv_isShowDefaultScanLineDrawable="true"
        xmlns:ns15="http://schemas.android.com/apk/res-auto" 
        ns15:qrcv_isShowTipBackground="false"
        xmlns:ns16="http://schemas.android.com/apk/res-auto" 
        ns16:qrcv_isShowTipTextAsSingleLine="false"
        xmlns:ns17="http://schemas.android.com/apk/res-auto" 
        ns17:qrcv_isTipTextBelowRect="false"
        xmlns:ns18="http://schemas.android.com/apk/res-auto" 
        ns18:qrcv_maskColor="#33ffffff"
        xmlns:ns19="http://schemas.android.com/apk/res-auto" 
        ns19:qrcv_qrCodeTipText="@string/qr_scan_desc"
        xmlns:ns20="http://schemas.android.com/apk/res-auto" 
        ns20:qrcv_rectWidth="200dp"
        xmlns:ns21="http://schemas.android.com/apk/res-auto" 
        ns21:qrcv_scanLineMargin="0dp"
        xmlns:ns22="http://schemas.android.com/apk/res-auto" 
        ns22:qrcv_scanLineSize="0.5dp"
        xmlns:ns23="http://schemas.android.com/apk/res-auto" 
        ns23:qrcv_tipTextColor="@android:color/white"
        xmlns:ns24="http://schemas.android.com/apk/res-auto" 
        ns24:qrcv_tipTextMargin="30dp"
        xmlns:ns25="http://schemas.android.com/apk/res-auto" 
        ns25:qrcv_tipTextSize="12dp"
        xmlns:ns26="http://schemas.android.com/apk/res-auto" 
        ns26:qrcv_toolbarHeight="56dp"
        xmlns:ns27="http://schemas.android.com/apk/res-auto" 
        ns27:qrcv_topOffset="90dp"/>
    <RelativeLayout
        android:id="@+id/action_bar_common"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_title_height"
        android:layout_marginTop="@dimen/status_height"
        android:layout_alignParentStart="true">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/left"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/icon_album"
            android:background="@drawable/selector_btn_normal"
            android:visibility="visible"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_album"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/wait_camera"
        android:background="@color/gray"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ProgressBar
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?android:attr/progressBarStyle"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qr_scan_load"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
