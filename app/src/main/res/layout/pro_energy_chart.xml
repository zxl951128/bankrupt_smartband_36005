<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/rl_energy"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="35dp">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/ll_energy_tip"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="15dp">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/pro_energy_bar_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            android:text="@string/icon_h_energy"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:text="@string/energy_change"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="(kcal)"/>
    </LinearLayout>
    <cn.ginshell.bong.ui.view.pro.ProBarChart
        android:id="@+id/energy_chart"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:layout_marginLeft="@dimen/pro_chart_common_padding"
        android:layout_below="@+id/energy_data"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/energy_data"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_energy_tip"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="22dp"
            android:textColor="@color/black"
            android:id="@+id/avg_energy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_value"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/avg_energy"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/time_span"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5dp"
        android:layout_below="@+id/energy_chart">
        <TextView
            android:textSize="9dp"
            android:textColor="@color/pro_xaxis_text_color"
            android:id="@+id/start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:text="@string/default_time_value"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="9dp"
            android:textColor="@color/pro_xaxis_text_color"
            android:id="@+id/end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="@string/default_time_value"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <View
        android:background="#80cccccc"
        android:layout_width="wrap_content"
        android:layout_height="1px"
        android:layout_marginTop="40dp"
        android:layout_below="@+id/time_span"/>
</RelativeLayout>
