<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/frag_back_music_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/SetItem"/>
    <ImageView
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <RelativeLayout
        android:background="@color/white"
        android:clickable="true"
        style="@style/SetItem.TransportClick">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textColor="@color/purple_action_bar_bg"
            android:gravity="center"
            android:id="@+id/back_music_img"
            android:text="@string/icon_bgm"
            style="@style/ItemIcon"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/background_music"
            android:layout_toRightOf="@+id/back_music_img"
            android:layout_centerVertical="true"
            style="@style/CommonText.ItemPurple"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/back_music_switch"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/MaterialDesignStyle2"/>
    </RelativeLayout>
    <ImageView
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <TextView
        android:textSize="12sp"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="10dp"
        android:text="@string/back_music_tips"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_back_music_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <android.support.v7.widget.RecyclerView
            android:id="@+id/back_music_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ImageView
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
