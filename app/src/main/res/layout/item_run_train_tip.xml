<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/ll_parent"
    android:tag="layout/item_run_train_tip_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@+id/ll_run_train">
    <View xmlns:android="http://schemas.android.com/apk/res/android"
        android:background="@color/pro_run_train_item_color"
        android:layout_width="match_parent"
        android:layout_height="30dp"/>
    <LinearLayout
        android:id="@+id/ll_run_train_tip"
        android:background="@color/white"
        android:paddingLeft="20dp"
        android:paddingTop="30dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="#"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/run_train_name"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/advise_speed_km"
            android:layout_weight="2"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/actual_speed_km"
            android:layout_weight="2"/>
    </LinearLayout>
    <View
        android:id="@+id/line"
        android:background="@color/white_9"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"/>
</LinearLayout>
