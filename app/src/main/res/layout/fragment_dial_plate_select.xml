<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/set_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/rl_title_bar"
        android:background="@color/black_bg"
        style="@style/CommonTitle">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/left"
            android:background="@drawable/selector_set_item_bg"
            android:clickable="true"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="@dimen/common_title_height"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:id="@+id/icon_left"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_back"/>
        </LinearLayout>
        <TextView
            android:textSize="20dp"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bong"
            android:layout_centerInParent="true"
            style="@style/CommonText.White"/>
        <View
            android:background="@color/split_line"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/black_bg"
        android:padding="@dimen/card_top_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/message_tip"
            style="@style/CommonText.Tip"/>
        <ImageView
            android:background="@color/btn_bg_yellow"
            android:padding="1px"
            android:layout_width="@dimen/card_img_width"
            android:layout_height="@dimen/card_img_height"
            android:src="@drawable/card_img_time"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="#5a5a5a"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <RelativeLayout
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/clock_bg"
            android:layout_width="396px"
            android:layout_height="654px"
            android:src="@drawable/bg_clock"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/dial_plate"
            android:background="@color/black"
            android:layout_width="276px"
            android:layout_height="276px"
            android:layout_marginLeft="57px"
            android:layout_marginTop="173px"
            android:src="@drawable/x2_clock_3"
            android:layout_alignLeft="@+id/clock_bg"
            android:layout_alignTop="@+id/clock_bg"/>
        <LinearLayout
            android:id="@+id/loading"
            android:background="@color/black_bg_80"
            android:padding="80px"
            android:visibility="invisible"
            android:layout_width="276px"
            android:layout_height="276px"
            android:layout_marginLeft="57px"
            android:layout_marginTop="173px"
            android:layout_alignLeft="@+id/clock_bg"
            android:layout_alignTop="@+id/clock_bg">
            <cn.ginshell.bong.ui.view.PullToRefreshLoadingView
                android:id="@+id/loading_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </RelativeLayout>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/clock_recycler_view"
        android:background="@color/black_bg"
        android:layout_width="match_parent"
        android:layout_height="252px"/>
</LinearLayout>
