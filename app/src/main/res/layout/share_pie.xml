<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:background="@color/share_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="247dp"
        android:src="@drawable/bg_share"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/share_head"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/date_text"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="38dp"/>
        <cn.ginshell.bong.ui.view.piechart.BongDayPieChart
            android:id="@+id/pie_chart"
            android:layout_width="234dp"
            android:layout_height="234dp"
            android:layout_marginTop="21dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="28dp"
            android:baselineAligned="false"
            android:weightSum="2">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RelativeLayout
                    android:orientation="horizontal"
                    android:layout_width="@dimen/share_pie_progress_len"
                    android:layout_height="wrap_content">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textSize="28dp"
                        android:textColor="@color/bong_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_energy_fill"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/bong_color"
                        android:id="@+id/bong_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <cn.ginshell.bong.ui.view.TabProgressBar
                    android:id="@+id/bong_progress_bar"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:layout_width="@dimen/share_pie_progress_len"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>
                <TextView
                    android:textSize="@dimen/share_big_text_size"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/cal_value_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RelativeLayout
                    android:orientation="horizontal"
                    android:layout_width="@dimen/share_pie_progress_len"
                    android:layout_height="wrap_content">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textSize="28dp"
                        android:textColor="@color/sleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_sleep"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="@color/sleep"
                        android:id="@+id/sleep_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <cn.ginshell.bong.ui.view.TabProgressBar
                    android:id="@+id/sleep_progress_bar"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:layout_width="@dimen/share_pie_progress_len"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"/>
                <TextView
                    android:textSize="@dimen/share_big_text_size"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/sleep_time_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/share_footer"/>
    </LinearLayout>
</FrameLayout>
