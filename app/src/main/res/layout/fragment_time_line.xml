<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:id="@+id/date_bar"
        android:background="@color/green_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_title_height">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="28dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/manual_sports"
            android:paddingLeft="@dimen/common_padding"
            android:paddingRight="@dimen/common_padding"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/icon_out_run"
            android:layout_centerVertical="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/icon_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/date_bar_left"
            android:paddingLeft="30dp"
            android:paddingRight="25dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="55dp"
            android:text="@string/icon_page_left"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/icon_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/date_bar_right"
            android:paddingLeft="25dp"
            android:paddingRight="30dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="55dp"
            android:text="@string/icon_page_right"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/date_bar_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/date_bar_right"
            android:layout_toRightOf="@+id/date_bar_left"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/common_action_bar_text_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/today"
            android:paddingLeft="10dp"
            android:paddingRight="15dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/today"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <cn.ginshell.bong.ui.view.BongDayLayout
        android:id="@+id/bong_day_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/date_bar">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/bong_day_refresh"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/refresh_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/pull_refresh_text"
                android:layout_centerInParent="true"/>
            <cn.ginshell.bong.ui.view.PullToRefreshLoadingView
                android:id="@+id/refresh_progress"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_toLeftOf="@+id/refresh_text"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/bong_day_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <cn.ginshell.bong.ui.view.HoloCircularProgressBar
                android:gravity="top|left"
                android:layout_gravity="center"
                android:id="@+id/bong_day_circle_progress"
                android:padding="25dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="60dp"
                android:layout_marginRight="60dp"
                xmlns:ns1="http://schemas.android.com/apk/res-auto" 
                ns1:progress="0"
                xmlns:ns2="http://schemas.android.com/apk/res-auto" 
                ns2:progress_background_color="@color/black_bg_50"
                xmlns:ns3="http://schemas.android.com/apk/res-auto" 
                ns3:progress_color="@color/bong_color"/>
            <cn.ginshell.bong.ui.component.BongFitComponent
                android:layout_gravity="center"
                android:id="@+id/bong_fit_component"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="17dp"
                android:textColor="@color/black"
                android:id="@+id/share"
                android:padding="15dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_share"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bong_day_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <cn.ginshell.bong.ui.view.TableBarLayout
                android:gravity="center_vertical"
                android:id="@+id/tab_bar"
                android:background="@color/green_1"
                android:paddingLeft="@dimen/tab_bong_day_padding"
                android:paddingRight="@dimen/tab_bong_day_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <cn.ginshell.bong.ui.view.ContainerViewPager
                android:id="@+id/viewpager"
                android:background="@color/common_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <cn.ginshell.bong.ui.view.ContainerViewPager
                android:id="@+id/fit_viewpager"
                android:background="@color/common_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </cn.ginshell.bong.ui.view.BongDayLayout>
</RelativeLayout>
