<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/item_member_new_0"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginLeft="20dp">
    <com.facebook.drawee.view.SimpleDraweeView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_centerVertical="true"
        xmlns:ns1="http://schemas.android.com/apk/res-auto" 
        ns1:placeholderImage="@drawable/user_img_default"
        xmlns:ns2="http://schemas.android.com/apk/res-auto" 
        ns2:roundAsCircle="true"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="6dp"
        android:text="我叫金3顺"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/accept"
        android:layout_toRightOf="@+id/icon"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:id="@+id/accept"
        android:background="@drawable/round_green_bg"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="13dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:text="@string/member_accept"
        android:layout_toLeftOf="@+id/reject"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:id="@+id/reject"
        android:background="@drawable/round_light_red_bg"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="13dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="15dp"
        android:text="@string/member_reject"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <View
        android:id="@+id/line"
        android:layout_alignParentBottom="true"
        style="@style/DividerLine"/>
</RelativeLayout>
