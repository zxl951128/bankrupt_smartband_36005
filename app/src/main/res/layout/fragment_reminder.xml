<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/actionbar_green"/>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="200dp">
        <ImageView
            android:background="@drawable/b3_setting_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <ImageView
            android:background="@drawable/b3_setting_walk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <TextView
        android:textColor="@color/black_bg_80"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/reminder_desc"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="30dp"
        android:text="@string/reminder_desc"
        style="@style/SetItemTipText"/>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <RelativeLayout style="@style/ReminderItem">
        <TextView
            android:textSize="18dp"
            android:text="@string/exercise_reminder"
            android:layout_centerVertical="true"
            style="@style/CommonText"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/on_off"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/MaterialDesignStyle"/>
    </RelativeLayout>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_time_setting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="20dp"/>
        <RelativeLayout
            android:id="@+id/valid_time_pan"
            style="@style/ReminderItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/valid_period"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="@dimen/item_icon_text_size"
                android:textColor="@color/black"
                android:id="@+id/reminder_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:id="@+id/valid_time"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@+id/reminder_icon"
                android:layout_centerVertical="true"
                style="@style/CommonText.Green"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="@dimen/item_margin_left"
            android:layout_alignParentBottom="true"/>
        <RelativeLayout
            android:id="@+id/week_pan"
            style="@style/ReminderItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_repeat_day"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="@dimen/item_icon_text_size"
                android:textColor="@color/black"
                android:id="@+id/week_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/week"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@+id/week_next"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
