<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/fragment_sports_run_train_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/sport_bg_running"
        android:scaleType="centerCrop"/>
    <RelativeLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/action_bar_common"
            style="@style/CommonTitle.Transparent">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/title_left"
                android:tag="binding_1"
                android:background="@drawable/selector_btn_normal"
                android:layout_width="@dimen/common_title_width"
                android:layout_height="match_parent"
                android:text="@string/icon_back"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="健身"
                android:lines="1"
                android:layout_centerInParent="true"
                style="@style/CommonText"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/pyramid_train_dialog"
                android:background="@drawable/selector_btn_normal"
                android:layout_width="@dimen/common_title_width"
                android:layout_height="match_parent"
                android:text="@string/icon_info_circle"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_run_train_data"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="60dp"
            android:layout_marginRight="32dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_centerVertical="true">
                <cn.ginshell.bong.widget.AutofitTextView
                    android:textSize="@dimen/fit_cal_size"
                    android:gravity="center"
                    android:id="@+id/tv_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/value_null"
                    style="@style/CommonText.Black"/>
                <TextView
                    android:id="@+id/tv_top_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/all_distance"
                    style="@style/CommonText.SumTip"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:baselineAligned="false"
                android:weightSum="2">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/fit_mid_size"
                        android:id="@+id/left_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fit_mid_line_margin"
                        android:text="@string/value_null"
                        style="@style/CommonText.Black"/>
                    <TextView
                        android:id="@+id/left_tip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fit_mid_line_margin"
                        android:text="@string/all_energy"
                        style="@style/CommonText.SumTip"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/fit_mid_size"
                        android:id="@+id/right_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fit_mid_line_margin"
                        android:text="@string/time_null"
                        style="@style/CommonText.Black"/>
                    <TextView
                        android:id="@+id/right_tip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fit_mid_line_margin"
                        android:text="@string/all_time_len"
                        style="@style/CommonText.SumTip"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/run_train_progress_bar"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="#cccccc"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="20dp"/>
                <cn.ginshell.bong.ui.view.RunTrainProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/progress_bar"
                    android:layout_width="280dp"
                    android:layout_height="60dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/run_train_achieve"/>
                    <TextView
                        android:textSize="20dp"
                        android:textColor="@color/train_achieve"
                        android:id="@+id/tv_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginBottom="1dp"
                        android:text="LV3"/>
                    <TextView
                        android:textSize="16dp"
                        android:id="@+id/tv_go_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="@string/run_train_come_on"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/start_sport"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="32dp"
                android:layout_marginBottom="25dp"
                android:text="@string/start"
                style="@style/BorderButtonGreen.Black"/>
            <TextView
                android:textSize="13dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/running_train_tips"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
