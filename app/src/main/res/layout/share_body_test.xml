<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:background="@color/physical_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/share_head"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="18dp"
                android:text="@string/physical_result"
                style="@style/CommonText.White"/>
            <TextView
                android:textSize="50dp"
                android:id="@+id/year_old"
                android:text="24"
                style="@style/CommonText.White"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white_tip2"
                android:text="@string/physical_body_year"
                style="@style/CommonText.Tip"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@color/rest_bg"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <TextView
                android:textSize="13dp"
                android:id="@+id/tv_year_tip"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="15dp"
                android:text="@string/physical_more_now"
                android:singleLine="false"
                style="@style/CommonText.White"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <cn.ginshell.bong.ui.view.BalanceView
                        android:id="@+id/balance_view"
                        android:layout_width="290dp"
                        android:layout_height="290dp"/>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-25dp">
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="15dp">
                            <cn.ginshell.bong.ui.view.IconTextView
                                android:textSize="30dp"
                                android:textColor="@color/average_one"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_status"/>
                            <TextView
                                android:textSize="13dp"
                                android:textColor="@color/average_one"
                                android:layout_marginTop="5dp"
                                android:text="@string/physical_average"
                                android:singleLine="false"
                                style="@style/CommonText.White"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp">
                            <cn.ginshell.bong.ui.view.IconTextView
                                android:textSize="30dp"
                                android:textColor="@color/white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_status"/>
                            <TextView
                                android:textSize="13dp"
                                android:textColor="@color/white"
                                android:layout_marginTop="5dp"
                                android:text="@string/physical_personal"
                                android:singleLine="false"
                                style="@style/CommonText.White"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <include layout="@layout/share_footer"/>
    </LinearLayout>
</FrameLayout>
