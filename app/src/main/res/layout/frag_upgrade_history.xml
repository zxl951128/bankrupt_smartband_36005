<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_vertical"
        android:background="@color/green_1"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/icon_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/back"
            android:paddingLeft="@dimen/bong_pro_common_padding"
            android:paddingRight="@dimen/bong_pro_common_padding"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_report"
            android:layout_centerInParent="true"
            style="@style/CommonText.White"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.v7.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include layout="@layout/part_no_data"/>
    </FrameLayout>
</LinearLayout>
