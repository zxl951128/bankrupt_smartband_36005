<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    android:layout_marginBottom="10dp"
    xmlns:ns1="http://schemas.android.com/apk/res-auto" 
    ns1:cardBackgroundColor="@color/white"
    xmlns:ns2="http://schemas.android.com/apk/res-auto" 
    ns2:cardCornerRadius="5dp">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/selector_set_item_light_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="10dp">
            <TextView
                android:id="@+id/tv_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                style="@style/CommonText.Black"/>
            <ImageView
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/cardflow_move_img"
                android:scaleType="center"
                android:layout_centerHorizontal="true"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/switch_button"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="10dp"
            android:src="@color/black_light"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_card_img"
                android:layout_width="@dimen/card_img_size"
                android:layout_height="@dimen/card_img_size"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:src="@drawable/card_next"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/text_black_normal"
                android:gravity="left"
                android:id="@+id/tv_describe"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:maxLines="2"
                android:layout_toLeftOf="@+id/iv_left_more"
                android:layout_toRightOf="@+id/iv_card_img"
                android:layout_centerInParent="true"
                android:lineSpacingMultiplier="1.3"/>
            <ImageView
                android:id="@+id/iv_left_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:src="@drawable/go_forward_black"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
</android.support.v7.widget.CardView>
