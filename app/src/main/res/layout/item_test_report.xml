<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/item"
    android:background="@color/white"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="16dp"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginRight="15dp"
        android:text="@string/icon_forward"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/selector_set_item_light_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/SetItem.TransportClick">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:maxEms="14"
            android:singleLine="true"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white_3"
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="5dp"
            android:lines="1"/>
        <ImageView
            android:id="@+id/image"
            android:background="@color/white_c"
            android:padding="1px"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:src="@drawable/default_discover_banner"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white_6"
            android:ellipsize="end"
            android:id="@+id/describe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="15dp"
            android:maxLines="2"
            android:lineSpacingMultiplier="1.3"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</RelativeLayout>
