<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/item_train_record_lock_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/rl_lock"
        android:layout_width="match_parent"
        android:layout_height="120dp">
        <TextView
            android:textSize="20dp"
            android:textColor="@color/gray_light_9"
            android:gravity="center"
            android:id="@+id/icon_arrow"
            android:layout_width="10dp"
            android:layout_height="match_parent"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentTop="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_grade_lock"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/run_train_icon_lock"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/gray_light_9"
                android:gravity="center"
                android:id="@+id/tv_grade"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="LV1"
                android:layout_toRightOf="@+id/icon_arrow"/>
        </LinearLayout>
        <View
            android:id="@+id/grade_line"
            android:background="@color/white_c"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/ll_grade_lock"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/one_circle"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/grade_line">
            <TextView
                android:id="@+id/circle_one"
                android:background="@drawable/run_train_gray_circle"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
        </LinearLayout>
        <View
            android:id="@+id/grade_line_two"
            android:background="@color/white_c"
            android:visibility="invisible"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/one_circle"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_lock_circle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="-500dp"
            android:layout_toRightOf="@+id/grade_line_two"/>
    </RelativeLayout>
</LinearLayout>
