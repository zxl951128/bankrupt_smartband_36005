<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/item_rela"
    android:tag="layout/item_back_music_0"
    android:background="@color/white"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/common_item_height">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textColor="@color/purple_action_bar_bg"
        android:gravity="center"
        android:id="@+id/back_music_img"
        android:text="@string/icon_wakeup"
        style="@style/ItemIcon"/>
    <TextView
        android:id="@+id/back_music_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/back_music_img"
        android:layout_centerVertical="true"
        style="@style/CommonText.ItemPurple"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textSize="22dp"
        android:textColor="@color/green_2"
        android:gravity="center"
        android:id="@+id/back_music_finish"
        android:text="@string/icon_finish"
        android:layout_alignParentRight="true"
        style="@style/ItemIcon"/>
    <ImageView
        android:id="@+id/bottom_line"
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="18dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
