<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/user_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/user_item_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_model_margin">
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <RelativeLayout
                android:id="@+id/rl_balance_goal"
                android:clickable="true"
                style="@style/SetItem.TransportClick">
                <ImageView
                    android:id="@+id/iv_balance_goal"
                    android:src="@drawable/icon_user_aim"
                    style="@style/ItemIcon"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_balance_goal"
                    android:layout_toRightOf="@+id/iv_balance_goal"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_weight_goal"
                android:visibility="gone"
                android:clickable="true"
                style="@style/SetItem.TransportClick">
                <ImageView
                    android:id="@+id/iv_weight_goal"
                    android:src="@drawable/icon_weight_aim"
                    style="@style/ItemIcon"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_weight_goal"
                    android:layout_toRightOf="@+id/iv_weight_goal"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
            </RelativeLayout>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/health_plat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/user_item_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="@dimen/item_model_margin"
                android:layout_marginBottom="8dp"
                android:text="@string/user_bind_health_platform"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/user_item_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:background="@color/user_item_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <RelativeLayout
                    android:id="@+id/rl_qq_health"
                    android:clickable="true"
                    style="@style/SetItem.TransportClick">
                    <ImageView
                        android:id="@+id/iv_qq_health"
                        android:src="@drawable/qq"
                        style="@style/ItemIcon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_qq_health"
                        android:layout_toRightOf="@+id/iv_qq_health"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.ItemBlack"/>
                    <com.kyleduo.switchbutton.SwitchButton
                        android:id="@+id/qq_switch"
                        android:padding="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/MaterialDesignStyle"/>
                    <ImageView
                        android:background="@color/user_item_line"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_toRightOf="@+id/iv_qq_health"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_wx_rank"
                    android:clickable="true"
                    style="@style/SetItem.TransportClick">
                    <ImageView
                        android:id="@+id/iv_wx_rank"
                        android:src="@drawable/wechart"
                        style="@style/ItemIcon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_wx_rank"
                        android:layout_toRightOf="@+id/iv_wx_rank"
                        android:layout_centerVertical="true"
                        style="@style/CommonText.ItemBlack"/>
                    <com.kyleduo.switchbutton.SwitchButton
                        android:id="@+id/wx_switch"
                        android:padding="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/MaterialDesignStyle"/>
                </RelativeLayout>
                <ImageView
                    android:background="@color/user_item_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/user_item_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_model_margin">
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <RelativeLayout
                android:id="@+id/rl_bong_plus"
                android:clickable="true"
                style="@style/SetItem.TransportClick">
                <ImageView
                    android:id="@+id/iv_bong_plus"
                    android:src="@drawable/icon_weight_aim"
                    style="@style/ItemIcon"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_bong_plus"
                    android:layout_toRightOf="@+id/iv_bong_plus"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
            </RelativeLayout>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/user_item_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <RelativeLayout
                android:id="@+id/rl_setup"
                android:clickable="true"
                style="@style/SetItem.TransportClick">
                <ImageView
                    android:id="@+id/iv_setup"
                    android:src="@drawable/setting_setting"
                    style="@style/ItemIcon"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_set_up"
                    android:layout_toRightOf="@+id/iv_setup"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
            </RelativeLayout>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/user_item_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="@dimen/item_model_margin">
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <RelativeLayout
                android:id="@+id/rl_feedback"
                android:clickable="true"
                style="@style/SetItem.TransportClick">
                <ImageView
                    android:id="@+id/iv_fb"
                    android:src="@drawable/icon_feedback"
                    style="@style/ItemIcon"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_feedback"
                    android:layout_toRightOf="@+id/iv_fb"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
            </RelativeLayout>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/debug"
            android:background="@color/user_item_bg"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_item_height"
            android:layout_marginBottom="@dimen/item_model_margin">
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <TextView
                android:textColor="@color/green_1"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="DEBUG"
                android:layout_toRightOf="@+id/iv_setup2"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/debug2"
            android:background="@color/user_item_bg"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_item_height"
            android:layout_marginBottom="@dimen/item_model_margin">
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <TextView
                android:textColor="@color/green_1"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="DEBUG2"
                android:layout_toRightOf="@+id/iv_setup2"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ImageView
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
