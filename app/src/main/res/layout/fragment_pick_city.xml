<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/fragment_pick_city_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_left"
            android:tag="binding_1"
            style="@style/TitleLeft"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textColor="@color/white"
            android:id="@+id/title_right"
            android:tag="binding_2"
            android:visibility="visible"
            android:text="@string/icon_search"
            style="@style/TitleRight"/>
        <TextView
            android:id="@+id/title_center"
            android:text="@string/choose_city"
            style="@style/TitleCenter"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
        <android.support.v7.widget.CardView
            android:id="@+id/card_search"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_centerInParent="true"
            xmlns:ns1="http://schemas.android.com/apk/res-auto" 
            ns1:cardBackgroundColor="@color/white"
            xmlns:ns2="http://schemas.android.com/apk/res-auto" 
            ns2:cardCornerRadius="2dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/search_bar"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="@dimen/icon_size"
                    android:textColor="@color/green_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/common_horizontal_margin"
                    android:text="@string/icon_search"/>
                <EditText
                    android:textSize="@dimen/common_text_size"
                    android:textColor="@color/black"
                    android:textColorHint="@color/white_c"
                    android:id="@+id/search_editor"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:hint="@string/city_search_hint"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:imeOptions="actionSearch"/>
                <TextView
                    android:gravity="center"
                    android:tag="binding_3"
                    android:paddingLeft="@dimen/common_horizontal_margin"
                    android:paddingRight="@dimen/common_horizontal_margin"
                    android:layout_height="match_parent"
                    android:text="@string/cancel"
                    style="@style/CommonText.Green"/>
            </LinearLayout>
        </android.support.v7.widget.CardView>
    </RelativeLayout>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
