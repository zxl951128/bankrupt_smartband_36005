<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1">
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:isScrollContainer="false">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/iv_close"
                style="@style/CloseButton"/>
            <RelativeLayout
                android:id="@+id/line1"
                android:layout_marginTop="30dp"
                android:layout_below="@+id/iv_close"
                style="@style/CommonItem">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/tl_area"
                        android:background="@drawable/selector_item_bg"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:ellipsize="marquee"
                            android:id="@+id/tv_country"
                            android:layout_marginLeft="5dp"
                            android:text="@string/country_china_default"
                            android:layout_toLeftOf="@+id/itv_drop_down"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            style="@style/CommonText.White"/>
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textSize="10dp"
                            android:textColor="@color/gray_light_f1"
                            android:id="@+id/itv_drop_down"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="6dp"
                            android:text="@string/icon_down"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                    <View
                        android:background="@color/gray_light_f1"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp"/>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2">
                        <EditText
                            android:id="@+id/et_phone"
                            android:paddingLeft="10dp"
                            android:hint="@string/register_phone_number"
                            android:layout_toLeftOf="@+id/btn_sendcode"
                            android:layout_centerVertical="true"
                            android:inputType="number"
                            style="@style/CommonEditText"/>
                        <Button
                            android:textSize="16dp"
                            android:id="@+id/btn_sendcode"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="2dp"
                            android:layout_marginBottom="5dp"
                            android:text="@string/register_verification"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:textAllCaps="false"
                            style="@style/CommonButton"/>
                    </RelativeLayout>
                </LinearLayout>
                <View
                    android:background="@color/gray_light_f1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/line2"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/line1"
                style="@style/CommonItem">
                <TextView
                    android:ellipsize="marquee"
                    android:id="@+id/tv_yzm"
                    android:layout_marginLeft="5dp"
                    android:text="@string/register_verification_code"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.White"/>
                <View
                    android:id="@+id/view"
                    android:background="@color/gray_light_f1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_alignParentBottom="true"/>
                <EditText
                    android:id="@+id/et_yzm"
                    android:paddingLeft="5dp"
                    android:layout_marginLeft="10dp"
                    android:hint="@string/register_verification_code_input"
                    android:maxLength="6"
                    android:layout_toRightOf="@+id/tv_yzm"
                    android:layout_above="@+id/view"
                    android:inputType="number"
                    style="@style/CommonEditText"/>
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
    <Button
        android:id="@+id/btn_register_next"
        android:text="@string/register_step_next"
        style="@style/StyleButtonYellow"/>
</LinearLayout>
