<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/frag_bong_sportsdata_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_left"
            style="@style/TitleLeft"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_right"
            style="@style/TitleRight"/>
        <TextView
            android:id="@+id/title_center"
            android:text="@string/sports_data"
            style="@style/TitleCenter"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </RelativeLayout>
    <RelativeLayout
        android:clickable="false"
        style="@style/SetItem.Padding">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/icon_step"
            android:text="@string/icon_step"
            style="@style/ItemIconText.Green"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/number_of_steps"
            android:layout_toRightOf="@+id/icon_step"
            android:layout_centerVertical="true"
            style="@style/CommonText.ItemBlack"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/step_switch"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/MaterialDesignStyle"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:clickable="false"
        style="@style/SetItem.Padding">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/distance"
            android:text="@string/icon_step"
            style="@style/ItemIconText.Green"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/distance"
            android:layout_toRightOf="@+id/distance"
            android:layout_centerVertical="true"
            style="@style/CommonText.ItemBlack"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/distance_switch"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/MaterialDesignStyle"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:clickable="false"
        style="@style/SetItem.Padding">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/cal_value_text"
            android:text="@string/icon_card"
            style="@style/ItemIconText.Green"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calorie"
            android:layout_toRightOf="@+id/cal_value_text"
            android:layout_centerVertical="true"
            style="@style/CommonText.ItemBlack"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/cal_switch"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/MaterialDesignStyle"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
