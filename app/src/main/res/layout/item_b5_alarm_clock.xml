<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp">
    <View xmlns:android="http://schemas.android.com/apk/res/android" style="@style/DividerLine"/>
    <RelativeLayout
        android:id="@+id/alarm_item"
        android:background="@drawable/selector_btn_white"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/alarm_time_size"
            android:id="@+id/tv_alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="8dp"
            android:text="@string/default_time_value"
            android:layout_alignParentLeft="true"
            style="@style/CommonText"/>
        <TextView
            android:textSize="15dp"
            android:id="@+id/tv_alarm_name"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:text="闹钟"
            android:layout_below="@+id/tv_alarm_time"
            android:layout_alignParentLeft="true"
            style="@style/CommonText"/>
        <TextView
            android:id="@+id/tv_alarm_day7"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:text="@string/week_sun"
            android:layout_toRightOf="@+id/tv_alarm_name"
            android:layout_below="@+id/tv_alarm_time"
            style="@style/Special"/>
        <TextView
            android:id="@+id/tv_alarm_day1"
            android:layout_marginTop="10dp"
            android:text="@string/week_mon"
            android:layout_toRightOf="@+id/tv_alarm_day7"
            android:layout_below="@+id/tv_alarm_time"
            style="@style/Special"/>
        <TextView
            android:id="@+id/tv_alarm_day2"
            android:layout_marginTop="10dp"
            android:text="@string/week_tue"
            android:layout_toRightOf="@+id/tv_alarm_day1"
            android:layout_below="@+id/tv_alarm_time"
            style="@style/Special"/>
        <TextView
            android:id="@+id/tv_alarm_day3"
            android:layout_marginTop="10dp"
            android:text="@string/week_wed"
            android:layout_toRightOf="@+id/tv_alarm_day2"
            android:layout_below="@+id/tv_alarm_time"
            style="@style/Special"/>
        <TextView
            android:id="@+id/tv_alarm_day4"
            android:layout_marginTop="10dp"
            android:text="@string/week_thu"
            android:layout_toRightOf="@+id/tv_alarm_day3"
            android:layout_below="@+id/tv_alarm_time"
            style="@style/Special"/>
        <TextView
            android:id="@+id/tv_alarm_day5"
            android:layout_marginTop="10dp"
            android:text="@string/week_fri"
            android:layout_toRightOf="@+id/tv_alarm_day4"
            android:layout_below="@+id/tv_alarm_time"
            style="@style/Special"/>
        <TextView
            android:id="@+id/tv_alarm_day6"
            android:layout_marginTop="10dp"
            android:text="@string/week_sat"
            android:layout_toRightOf="@+id/tv_alarm_day5"
            android:layout_below="@+id/tv_alarm_time"
            style="@style/Special"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/btn_switch"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/MaterialDesignStyle"/>
        <ImageView
            android:id="@+id/iv_delete"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:src="@drawable/selector_delete_img"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View style="@style/DividerLine"/>
</LinearLayout>
