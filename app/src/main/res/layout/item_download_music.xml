<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/rl_content"
    android:tag="layout/item_download_music_0"
    android:background="@drawable/selector_btn_purple"
    android:layout_width="match_parent"
    android:layout_height="@dimen/common_item_height">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:ellipsize="end"
        android:id="@+id/tv_music_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:maxEms="11"
        android:singleLine="true"
        android:layout_centerVertical="true"
        style="@style/CommonText.ItemPurple"/>
    <View
        android:id="@+id/line"
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="18dp"
        android:layout_alignParentBottom="true"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textSize="22dp"
        android:textColor="@color/green_2"
        android:gravity="center"
        android:id="@+id/icon_alarm_selected"
        android:visibility="gone"
        android:text="@string/icon_audition"
        android:layout_alignParentRight="true"
        style="@style/ItemIcon"/>
</RelativeLayout>
