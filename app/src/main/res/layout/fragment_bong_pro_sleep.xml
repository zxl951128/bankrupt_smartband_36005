<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="1">
            <include layout="@layout/bongpro_title"/>
            <cn.ginshell.bong.ui.view.ProScrollView
                android:id="@+id/pro_scrollview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_share"
                        android:background="@color/pro_sleep_time_color"
                        android:layout_width="match_parent"
                        android:layout_height="160dp">
                        <RelativeLayout
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="vertical"
                                android:id="@+id/sleep_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="15dp"
                                android:layout_marginBottom="10dp"
                                android:layout_below="@+id/time_text"
                                android:layout_centerHorizontal="true">
                                <cn.ginshell.bong.ui.view.IconTextView
                                    android:textSize="45dp"
                                    android:textColor="@color/white"
                                    android:gravity="top"
                                    android:id="@+id/sleep_time_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/icon_7"
                                    android:includeFontPadding="false"/>
                                <TextView
                                    android:textSize="@dimen/pro_data_name_size"
                                    android:textColor="@color/white_60"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="@string/sleep_length"
                                    style="@style/CommonText.Tip"/>
                            </LinearLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:weightSum="2">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:paddingBottom="8dp"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">
                                    <TextView
                                        android:textSize="@dimen/pro_data_number_size"
                                        android:textColor="@color/white"
                                        android:gravity="bottom"
                                        android:id="@+id/deep_sleep_time"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"/>
                                    <TextView
                                        android:textSize="@dimen/pro_data_name_size"
                                        android:textColor="@color/white_60"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/deep_sleep"
                                        style="@style/CommonText.Tip"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:gravity="bottom|center_horizontal"
                                    android:paddingBottom="8dp"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">
                                    <cn.ginshell.bong.ui.view.IconTextView
                                        android:textSize="18dp"
                                        android:textColor="@color/white"
                                        android:id="@+id/sleep_quality"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="2dp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <include layout="@layout/part_sleep_pro_data"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_share_chart"
                        android:background="@color/white"
                        android:paddingTop="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="bottom"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="30dp">
                            <cn.ginshell.bong.ui.view.IconTextView
                                android:textSize="20dp"
                                android:textColor="@color/purple_bg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="15dp"
                                android:layout_marginTop="5dp"
                                android:text="@string/icon_h_sleep"/>
                            <TextView
                                android:textSize="15dp"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="7dp"
                                android:text="@string/sleep"/>
                        </LinearLayout>
                        <cn.ginshell.bong.ui.view.sleepchart.SleepChart
                            android:id="@+id/sleep_chart"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginLeft="@dimen/bong_pro_common_padding"
                            android:layout_marginRight="@dimen/bong_pro_common_padding"/>
                        <RelativeLayout
                            android:orientation="horizontal"
                            android:paddingLeft="@dimen/bong_content_margin_left"
                            android:paddingRight="@dimen/bong_content_margin_left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:layout_marginBottom="32dp">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="28dp"
                                android:layout_toLeftOf="@+id/ll_center">
                                <View
                                    android:background="@drawable/bg_corner_sleep_deep"
                                    android:layout_width="@dimen/sleep_pro_indicator_wide"
                                    android:layout_height="@dimen/sleep_pro_indicator_size"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="5dp"
                                    android:text="@string/sleep_type_deep"
                                    style="@style/CommonText.Tip"/>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:id="@+id/ll_center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true">
                                <View
                                    android:background="@drawable/bg_corner_sleep_light"
                                    android:layout_width="@dimen/sleep_pro_indicator_wide"
                                    android:layout_height="@dimen/sleep_pro_indicator_size"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="5dp"
                                    android:text="@string/sleep_type_light"
                                    style="@style/CommonText.Tip"/>
                            </LinearLayout>
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="28dp"
                                android:layout_toRightOf="@+id/ll_center">
                                <View
                                    android:background="@drawable/bg_corner_sleep_awake"
                                    android:layout_width="@dimen/sleep_pro_indicator_wide"
                                    android:layout_height="@dimen/sleep_pro_indicator_size"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="5dp"
                                    android:text="@string/wake_up"
                                    style="@style/CommonText.Tip"/>
                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>
                    <include layout="@layout/bongpro_tip_new"/>
                </LinearLayout>
            </cn.ginshell.bong.ui.view.ProScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
