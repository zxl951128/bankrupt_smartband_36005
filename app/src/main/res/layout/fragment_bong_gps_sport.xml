<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/parent"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/bongpro_title"/>
        <cn.ginshell.bong.ui.view.ProScrollView
            android:id="@+id/scroll_pro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/part_gps_sport_top"
                    layout="@layout/part_gps_sport_top"/>
                <include
                    android:id="@+id/gps_layout_map"
                    layout="@layout/bongpro_gps_map"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_data"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/gps_layout_map">
                    <include
                        android:id="@+id/part_sport_data"
                        layout="@layout/part_sport_pro_data"/>
                    <include
                        android:id="@+id/gps_layout_bottom"
                        layout="@layout/bongpro_gps_bottom"/>
                </LinearLayout>
                <include
                    android:id="@+id/bong_pro_failed"
                    android:visibility="gone"
                    layout="@layout/bongpro_gps_error"/>
            </RelativeLayout>
        </cn.ginshell.bong.ui.view.ProScrollView>
    </LinearLayout>
</LinearLayout>
