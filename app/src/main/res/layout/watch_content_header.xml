<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/device"
    android:background="@drawable/selector_btn_white"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/common_title_height">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="18dp"
        android:id="@+id/bong_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:text="@string/bong_watch_me"
        android:layout_centerVertical="true"
        style="@style/CommonText.Black"/>
    <View
        android:layout_marginLeft="5dp"
        android:layout_toRightOf="@+id/bong_title"
        android:layout_centerVertical="true"
        style="@style/RedPoint"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textSize="@dimen/item_icon_text_size"
        android:textColor="@color/black"
        android:id="@+id/forward_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:text="@string/icon_forward"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textSize="14dp"
        android:textColor="@color/black"
        android:id="@+id/charging"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:text="@string/icon_charging"
        android:layout_toLeftOf="@+id/forward_img"
        android:layout_centerVertical="true"/>
    <cn.ginshell.bong.ui.view.BatteryView
        android:id="@+id/battery_view"
        android:layout_width="20dp"
        android:layout_height="14dp"
        android:layout_toLeftOf="@+id/charging"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/black"
        android:id="@+id/battery_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:layout_toLeftOf="@+id/battery_view"
        android:layout_centerVertical="true"/>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
