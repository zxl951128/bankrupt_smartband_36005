<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/main_content"
    android:tag="layout/frag_bong3_screen_0"
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_left"
            android:tag="binding_1"
            style="@style/TitleLeft"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_right"
            style="@style/TitleRight"/>
        <TextView
            android:id="@+id/title_center"
            android:text="@string/screen_content"
            style="@style/TitleCenter"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_margin_height">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:clickable="false"
            style="@style/SetItem.Padding">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/icon_step"
                android:text="@string/icon_step"
                style="@style/ItemIconText.Green"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_number"
                android:layout_toRightOf="@+id/icon_step"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/step_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_toRightOf="@+id/icon_step"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:clickable="false"
            style="@style/SetItem.Padding">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/icon_distance"
                android:text="@string/icon_distance_a"
                style="@style/ItemIconText.Green"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/distance"
                android:layout_toRightOf="@+id/icon_distance"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/distance_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_toRightOf="@+id/icon_distance"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:clickable="false"
            style="@style/SetItem.Padding">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/icon_cal"
                android:text="@string/icon_energy_fill"
                style="@style/ItemIconText.Green"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calorie"
                android:layout_toRightOf="@+id/icon_cal"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/cal_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_toRightOf="@+id/icon_cal"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:clickable="false"
            style="@style/SetItem.Padding">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/icon_heart"
                android:text="@string/icon_cracked_heart"
                style="@style/ItemIconText.Green"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_rate"
                android:layout_toRightOf="@+id/icon_heart"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/heart_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_weather"
        android:tag="binding_2"
        android:background="@drawable/selector_btn_white"
        android:visibility="visible"
        android:clickable="true"
        android:layout_marginTop="@dimen/item_margin_height"
        style="@style/SetItem">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentTop="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/icon_weather"
            android:layout_marginLeft="24dp"
            android:text="@string/icon_weather"
            style="@style/ItemIconText.Green"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_title"
            android:layout_toRightOf="@+id/icon_weather"
            android:layout_centerVertical="true"
            style="@style/CommonText.ItemBlack"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textColor="@color/black"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="27dp"
            android:text="@string/icon_forward"
            android:layout_alignParentRight="true"
            style="@style/ItemIconTextRight"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
