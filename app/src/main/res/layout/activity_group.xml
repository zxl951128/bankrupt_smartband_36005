<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/web_view_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/part_no_data"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/group_linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_group_title"
            android:background="@color/black_bg_30"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_title_height"
            android:layout_marginTop="@dimen/status_height">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/left"
                android:layout_width="@dimen/common_title_width"
                android:layout_height="match_parent"
                android:text="@string/icon_back"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/group_home"
                android:lines="1"
                android:layout_centerInParent="true"
                style="@style/CommonText"/>
            <ImageView
                android:textSize="20dp"
                android:gravity="center"
                android:id="@+id/group_setting"
                android:background="@drawable/group_setting"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginRight="10dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
