<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/rl_content"
    android:tag="layout/item_sport_chooser_0"
    android:background="@drawable/bg_corner_blue"
    android:layout_width="150dp"
    android:layout_height="46dp"
    android:layout_marginLeft="15dp"
    android:layout_marginTop="20dp">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="@dimen/sports_icon_size"
        android:textColor="@color/white"
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:text="@string/icon_testing"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/sports_text_size"
        android:textColor="@color/white"
        android:id="@+id/tv_sport_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:text="@string/out_run"
        android:layout_toRightOf="@+id/icon"
        android:layout_centerVertical="true"/>
    <ImageView
        android:id="@+id/img_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_sport_new"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
