<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/frag_eyeshade_sleep_record_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_title_height">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:gravity="center"
            android:id="@+id/title_left"
            android:tag="binding_1"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/purple_action_bar_bg"
            android:gravity="center"
            android:id="@+id/title_right"
            android:tag="binding_2"
            android:background="@drawable/selector_btn_normal"
            android:clickable="true"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_respite_calendar"
            android:layout_alignParentRight="true"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/eyeshade_sleep_record"
            android:lines="1"
            android:layout_toLeftOf="@+id/title_right"
            android:layout_toRightOf="@+id/title_left"
            android:layout_centerInParent="true"
            style="@style/CommonText"/>
    </RelativeLayout>
    <TextView
        android:textSize="25dp"
        android:layout_gravity="center"
        android:id="@+id/no_data"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_respite_data"
        android:layout_centerInParent="true"/>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/sleep_record_recycler_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/action_bar_common"/>
</RelativeLayout>
