<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/physical_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="@dimen/physical_result_top_height">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/physical_result_top_height">
            <TextView
                android:textSize="18dp"
                android:text="@string/physical_result"
                style="@style/CommonText.White"/>
            <TextView
                android:textSize="55dp"
                android:id="@+id/year_old"
                android:text="24"
                style="@style/CommonText.White"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white_tip2"
                android:text="@string/physical_body_year"
                style="@style/CommonText.Tip"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/right"
            android:background="@drawable/selector_set_item_bg"
            android:clickable="true"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="@dimen/common_title_height"
            android:layout_alignParentRight="true">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_share"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/rest_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="13dp"
            android:id="@+id/tv_year_tip"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="15dp"
            android:text="@string/physical_more_now"
            android:singleLine="false"
            style="@style/CommonText.White"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">
                    <cn.ginshell.bong.ui.view.BalanceView
                        android:id="@+id/balance_view"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.8"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-20dp">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="15dp">
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textSize="30dp"
                            android:textColor="@color/average_one"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/icon_status"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="@color/average_one"
                            android:text="@string/physical_average"
                            android:singleLine="false"
                            style="@style/CommonText.White"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp">
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textSize="30dp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/icon_status"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="@color/white"
                            android:text="@string/physical_personal"
                            android:singleLine="false"
                            style="@style/CommonText"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <Button
            android:id="@+id/btn_start_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="15dp"
            android:text="@string/physical_test_complete"
            style="@style/StyleButtonWhite"/>
    </LinearLayout>
</LinearLayout>
