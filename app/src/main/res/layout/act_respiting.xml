<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/act_respiting_0"
    android:background="@color/purple_action_bar_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Purple">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title_right"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_eye_wear"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:text="@string/intelligent_wake"
            android:lines="1"
            style="@style/CommonText"/>
        <ImageView
            android:id="@+id/intelligent_wake_rect"
            android:background="@drawable/intelligent_wake_rect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_toRightOf="@+id/title"/>
        <ImageView
            android:id="@+id/intelligent_wake_rect_true2"
            android:background="@drawable/intelligent_wake_true_rect2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="16dp"
            android:layout_toRightOf="@+id/title"/>
        <ImageView
            android:id="@+id/intelligent_wake_false_rect"
            android:background="@drawable/intelligent_wake_false_rect"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="16dp"
            android:layout_toRightOf="@+id/title"/>
        <ImageView
            android:id="@+id/intelligent_wake_false_rect2"
            android:background="@drawable/intelligent_wake_false_rect2"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="24dp"
            android:layout_toRightOf="@+id/title"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/alarm_clock_rela"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/action_bar_common">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:id="@+id/alarm_clock_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:layout_marginRight="7dp"
            android:text="@string/alarm_clock2"
            android:layout_toLeftOf="@+id/alarm_clock_time"/>
        <TextView
            android:textSize="40dp"
            android:textColor="@color/white"
            android:id="@+id/alarm_clock_time"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13:00"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <cn.ginshell.bong.widget.BrainWaveView
        android:id="@+id/brainwave_view"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginBottom="30dp"
        android:layout_above="@+id/circle_linear"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:id="@+id/brain_wave_collect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/brain_wave_collect"
        android:layout_below="@+id/brainwave_view"
        android:layout_centerHorizontal="true"/>
    <cn.ginshell.bong.ui.view.CircleLayout
        android:orientation="vertical"
        android:id="@+id/circle_linear"
        android:background="@drawable/respiting_circle"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="50dp"
        android:layout_above="@+id/linear_press_progress_view"
        android:layout_centerHorizontal="true">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/icon_media"
            android:layout_width="40dp"
            android:layout_height="0dp"
            android:text="@string/icon_music"
            android:layout_weight="2.5"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#80ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/music_type"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1.5"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/music_name"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:maxLines="2"
            android:layout_weight="3"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/next_music"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/icon_respite_next"
            android:layout_weight="4"/>
    </cn.ginshell.bong.ui.view.CircleLayout>
    <RelativeLayout
        android:id="@+id/long_press_rela"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/linear_press_progress_view">
        <TextView
            android:textSize="60dp"
            android:textColor="@color/white"
            android:id="@+id/alarm_clock_time_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="13:00"
            android:layout_above="@+id/alarm_wake_tips"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:id="@+id/alarm_wake_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="100dp"
            android:text="@string/alarm_wake"
            android:layout_above="@+id/long_press"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="30dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/long_press"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/long_press"
            android:layout_above="@+id/countdown"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="80dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="46dp"
            android:text="3"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <cn.ginshell.bong.widget.LinearPressProgressView
        android:id="@+id/linear_press_progress_view"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
