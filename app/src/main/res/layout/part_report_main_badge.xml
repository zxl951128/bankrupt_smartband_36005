<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:paddingLeft="5dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/iv_badge_img"
        android:layout_width="@dimen/badge_width_main"
        android:layout_height="@dimen/badge_width_main"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_custom"
        android:visibility="gone"
        android:layout_width="@dimen/badge_width_main"
        android:layout_height="@dimen/badge_width_main">
        <TextView
            android:textSize="6dp"
            android:textColor="@color/physical_start_color"
            android:id="@+id/tv_custom_keep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/badge_custom_keep"
            android:maxLines="1"/>
        <TextView
            android:textSize="6dp"
            android:textColor="@color/white"
            android:id="@+id/tv_custom_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/badge_custom_sleep"
            android:maxLines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/physical_start_color"
            android:id="@+id/tv_custom_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:maxLines="1"/>
    </LinearLayout>
</RelativeLayout>
