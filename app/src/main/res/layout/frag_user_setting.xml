<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/user_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/actionbar_green"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/rl_account"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_account"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                style="@style/ItemIconTextRight"/>
        </RelativeLayout>
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:clickable="false"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/show_running_tip"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/notify_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/user_help"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/rl_help"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_help"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                style="@style/ItemIconTextRight"/>
            <View
                android:background="@color/user_item_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_new_guide"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_new_guide"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                style="@style/ItemIconTextRight"/>
        </RelativeLayout>
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/rl_about"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/user_about"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                style="@style/ItemIconTextRight"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/DividerLine"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/user_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/btn_exit_account"
            android:clickable="true"
            style="@style/SetItem.TransportClick">
            <TextView
                android:layout_marginLeft="15dp"
                android:text="@string/exit_account"
                android:layout_centerInParent="true"
                style="@style/CommonText.Green"/>
        </RelativeLayout>
        <View
            android:background="@color/user_item_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
