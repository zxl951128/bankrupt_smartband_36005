<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/frag_run_train_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/rl_top"
        android:background="@color/train_record_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/im_finish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-30dp"
            android:layout_marginRight="-25dp"
            android:src="@drawable/icon_run_train_finish"
            android:layout_alignParentRight="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title_left"
            android:tag="binding_1"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="45dp"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="@string/train_record"
            android:lines="1"
            android:layout_centerHorizontal="true"
            style="@style/CommonText"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="45dp">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_complete_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2017/02/15 12:00:00"
                android:layout_below="@+id/title"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="30dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tv_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="35dp"
                    android:text="LV2"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="35dp"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/tv_finish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginBottom="3dp"
                    android:layout_toRightOf="@+id/tv_level"
                    android:layout_alignBottom="@+id/tv_level"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:textColor="@color/white"
                        android:id="@+id/tv_complete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/train_finish"
                        android:layout_alignBottom="@+id/tv_level_number"/>
                    <TextView
                        android:textSize="20dp"
                        android:textColor="@color/white"
                        android:id="@+id/now_step"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="7"
                        android:layout_toRightOf="@+id/tv_complete"
                        android:layout_alignBaseline="@+id/tv_level"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/"
                        android:layout_toRightOf="@+id/tv_level_number"
                        android:layout_alignBaseline="@+id/tv_level"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/white"
                        android:id="@+id/all_step"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:layout_toRightOf="@+id/tv_level_number"
                        android:layout_alignBaseline="@+id/tv_level"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_no_train"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginBottom="3dp"
                    android:layout_toRightOf="@+id/tv_level"
                    android:layout_alignBottom="@+id/tv_level"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:textColor="@color/white"
                        android:id="@+id/tv_no_train"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_train"
                        android:layout_alignBottom="@+id/tv_level_number"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/btn_next_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="15dp"
                    android:src="@drawable/run_train_btn_next_n"
                    android:layout_alignParentRight="true"/>
                <ImageView
                    android:id="@+id/btn_pre_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/run_train_btn_pre_dis"
                    android:layout_toLeftOf="@+id/btn_next_level"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_complete_message"
        android:background="@color/train_record_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="75dp">
        <View
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="40dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true">
                <TextView
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_null"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sport_time_unit"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/value_null"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true">
                <TextView
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/tv_kcal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/value_null"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_cal"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/train_record_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
