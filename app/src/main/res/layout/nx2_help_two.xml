<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/tip_two"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/tip_pan_21"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tip_text_21"
            android:text="@string/nx2_help_confirm"
            style="@style/Nx2Tip"/>
        <ViewSwitcher
            android:id="@+id/view_switch_21"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:id="@+id/getsture_img_5"
                android:src="@drawable/x2_gesutre_5"
                style="@style/GestureHelpImageView"/>
            <ImageView
                android:id="@+id/getsture_img_6"
                android:src="@drawable/x2_gesutre_6"
                style="@style/GestureHelpImageView"/>
        </ViewSwitcher>
    </LinearLayout>
    <TextView
        android:id="@+id/tip_text_22"
        android:layout_marginTop="20dp"
        android:text="@string/nx2_help_cancel"
        style="@style/Nx2Tip"/>
    <ViewSwitcher
        android:id="@+id/view_switch_22"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <ImageView
            android:id="@+id/getsture_img_7"
            android:src="@drawable/x2_gesutre_7"
            style="@style/GestureHelpImageView"/>
        <ImageView
            android:id="@+id/getsture_img_8"
            android:src="@drawable/x2_gesutre_8"
            style="@style/GestureHelpImageView"/>
    </ViewSwitcher>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <TextView
            android:textSize="@dimen/common_text_size"
            android:textColor="@color/gray"
            android:gravity="center"
            android:id="@+id/previous"
            android:background="@drawable/selector_btn_normal"
            android:padding="10dp"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/set_previous"
            android:layout_weight="1"/>
        <View
            android:background="@color/white_c"
            android:layout_width="1px"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/common_text_size"
            android:textColor="@color/green_1"
            android:gravity="center"
            android:id="@+id/done"
            android:background="@drawable/selector_btn_normal"
            android:padding="10dp"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/set_ok"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
