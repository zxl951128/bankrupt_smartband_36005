<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/rl_title_bar"
            style="@style/CommonTitle.Green">
            <ViewSwitcher
                android:gravity="center"
                android:id="@+id/left"
                android:background="@drawable/selector_set_item_bg"
                android:clickable="true"
                android:layout_width="@dimen/common_title_width"
                android:layout_height="@dimen/common_title_height"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/icon_left"
                    android:paddingRight="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/icon_back"/>
                <TextView
                    android:textSize="@dimen/common_action_bar_text_size"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/give_up"/>
            </ViewSwitcher>
            <TextView
                android:textSize="20dp"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heart_rate_test"
                android:layout_centerInParent="true"
                style="@style/CommonText.White"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/right"
                android:background="@drawable/selector_set_item_bg"
                android:clickable="true"
                android:layout_width="@dimen/common_title_width"
                android:layout_height="@dimen/common_title_height"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:id="@+id/icon_right"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_info"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="60dp">
            <cn.ginshell.bong.ui.view.HoloCircularProgressBar
                android:gravity="top|left"
                android:layout_gravity="center"
                android:id="@+id/heart_test_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                xmlns:ns1="http://schemas.android.com/apk/res-auto" 
                ns1:progress="0"
                xmlns:ns2="http://schemas.android.com/apk/res-auto" 
                ns2:progress_background_color="@color/black_bg_30"
                xmlns:ns3="http://schemas.android.com/apk/res-auto" 
                ns3:progress_color="@color/green_1"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="216px"
                android:textColor="@color/green_1"
                android:id="@+id/bouncing_testing"
                android:paddingBottom="30dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_hole_heart"
                android:layout_centerInParent="true"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_heart_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="70dp"
                        android:textColor="@color/black_bg_60"
                        android:gravity="center_horizontal"
                        android:id="@+id/heart_rate_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_null"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp">
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textSize="40dp"
                            android:textColor="@color/green_1"
                            android:id="@+id/bouncing_heart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/icon_hole_heart"
                            android:scaleX="0.8"
                            android:scaleY="0.8"/>
                        <TextView
                            android:textSize="@dimen/text_small_tip_size"
                            android:textColor="@color/black_bg_60"
                            android:id="@+id/tv_bpm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/heart_rate_unit_e"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/text_small_tip_size"
                    android:textColor="@color/black_bg_60"
                    android:id="@+id/heart_rate_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/last_heart_rate"/>
            </LinearLayout>
        </RelativeLayout>
        <ViewSwitcher
            android:id="@+id/bottom_view_switcher"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="@dimen/common_padding"
                android:paddingRight="@dimen/common_padding"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:id="@+id/start_test"
                    android:background="@color/green_1"
                    android:layout_marginTop="25dp"
                    android:text="@string/start_test"
                    style="@style/StyleButtonDefault"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/to_heart_rate_curve"
                    android:background="@drawable/selector_btn_normal"
                    android:paddingTop="25dp"
                    android:paddingBottom="25dp"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textSize="@dimen/item_icon_large_size"
                        android:textColor="@color/black_bg_60"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_report_n"/>
                    <TextView
                        android:textSize="@dimen/common_text_size"
                        android:textColor="@color/black_bg_60"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="@string/heart_rate_curve"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="bottom"
                android:id="@+id/heart_container"
                android:paddingRight="30dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <cn.ginshell.bong.ui.view.HeartWave
                    android:id="@+id/heart_wave"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </ViewSwitcher>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/rl_counter"
        android:background="@color/green_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="30dp"
            android:layout_weight="1.5">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="110dp"
                android:textColor="@color/white"
                android:id="@+id/icon_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_3"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/rl_wear_tip"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="30dp"
            android:layout_weight="2">
            <ImageView
                android:id="@+id/iv_dial_wear_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/dial_wear_tip"
                android:scaleType="fitCenter"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="25dp"
                android:layout_marginRight="25dp"
                android:layout_below="@+id/iv_dial_wear_tip">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white_80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_rate_test_tip2"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white_80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/heart_rate_test_tip3"/>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white_80"
                android:id="@+id/tv_no_more_tip"
                android:text="@string/no_more_tip"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                style="@style/CommonText.Click"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
