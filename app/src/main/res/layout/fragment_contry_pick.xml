<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/green_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/title_size"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            android:text="@string/country_and_regions"
            android:layout_centerHorizontal="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/title_size"
            android:textColor="@color/white"
            android:id="@+id/close"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_close"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_content_margin_horizontal"
        android:layout_marginRight="@dimen/item_content_margin_horizontal"
        android:layout_marginBottom="3dp"
        android:weightSum="1">
        <EditText
            android:id="@+id/search_edit"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/search"
            android:maxLines="1"
            android:layout_weight="1"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/icon_size"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_search"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="@dimen/item_margin_left"
        android:layout_marginRight="@dimen/item_margin_right"
        android:layout_marginBottom="7dp"
        style="@style/divider"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.v7.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:background="@color/green_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <cn.ginshell.bong.ui.view.IndexBar
            android:id="@+id/sideBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            xmlns:ns1="http://schemas.android.com/apk/res-auto" 
            ns1:alphabetPadding="2dp"
            xmlns:ns2="http://schemas.android.com/apk/res-auto" 
            ns2:alphabetTextColor="@color/black"
            xmlns:ns3="http://schemas.android.com/apk/res-auto" 
            ns3:alphabetTextSize="12sp"
            xmlns:ns4="http://schemas.android.com/apk/res-auto" 
            ns4:indexBarColorNormal="@color/transparent"
            xmlns:ns5="http://schemas.android.com/apk/res-auto" 
            ns5:indexBarColorPressed="#00000000"
            xmlns:ns6="http://schemas.android.com/apk/res-auto" 
            ns6:indexBarRound="5dp"
            xmlns:ns7="http://schemas.android.com/apk/res-auto" 
            ns7:indexBarSides="2dp"
            xmlns:ns8="http://schemas.android.com/apk/res-auto" 
            ns8:withinIndexBar="true"/>
    </RelativeLayout>
</LinearLayout>
