<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/action_bar_common"
    style="@style/CommonTitle.Green">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="20dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/title_right"
        android:background="@drawable/selector_btn_normal"
        android:layout_width="@dimen/common_title_width"
        android:layout_height="match_parent"
        android:text="@string/icon_back"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_title"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:lines="1"
            style="@style/CommonText"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:id="@+id/icon_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/icon_down"/>
    </LinearLayout>
    <View
        android:background="@color/green_1"
        android:layout_alignParentBottom="true"
        style="@style/DividerLine"/>
</RelativeLayout>
