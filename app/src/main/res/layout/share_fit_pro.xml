<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp">
            <ImageView
                android:id="@+id/no_iv_fit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/bong_fit_adv"
                android:layout_centerInParent="true"/>
            <FrameLayout
                android:background="@drawable/bg_circle_blue"
                android:padding="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_toRightOf="@+id/no_iv_fit"
                android:layout_alignBottom="@+id/no_iv_fit">
                <TextView
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/iv_user_img"
                    android:background="@drawable/circle_red_bg"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:text="ll"/>
            </FrameLayout>
        </RelativeLayout>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:id="@+id/tv_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Hackil 的体重"/>
        <TextView
            android:textSize="9dp"
            android:textColor="@color/white"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="今天 08:22"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="65dp"
                android:textColor="@color/white"
                android:id="@+id/tv_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.0"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:gravity="bottom"
                android:paddingBottom="15dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:text="@string/f_kg_unit"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp"
            android:layout_centerHorizontal="true">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true">
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:id="@+id/no_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fit_p_score"/>
                <TextView
                    android:textSize="24dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_score_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="99.3"
                    android:layout_below="@+id/no_score"/>
                <TextView
                    android:textSize="9dp"
                    android:textColor="@color/white_f0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="@string/fit_p_score_unit"
                    android:layout_toRightOf="@+id/tv_score_value"
                    android:layout_alignBaseline="@+id/tv_score_value"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:id="@+id/no_tv_weight_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/f_fit_change"/>
                <TextView
                    android:textSize="24dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_change_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+2"
                    android:layout_below="@+id/no_tv_weight_change"/>
                <TextView
                    android:textSize="9dp"
                    android:textColor="@color/white_f0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="@string/f_kg_unit"
                    android:layout_toRightOf="@+id/tv_change_value"
                    android:layout_alignBaseline="@+id/tv_change_value"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true">
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:id="@+id/no_tv_bmi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="@string/fit_p_bmi_change"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="24dp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_bmi_change_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+1"
                    android:layout_below="@+id/no_tv_bmi"/>
                <TextView
                    android:textSize="9dp"
                    android:textColor="@color/white_f0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="%"
                    android:layout_toRightOf="@+id/tv_bmi_change_value"
                    android:layout_alignBaseline="@+id/tv_bmi_change_value"/>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:background="@drawable/bg_corner_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:layout_marginBottom="25dp">
            <android.support.v7.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <include layout="@layout/share_footer"/>
    </LinearLayout>
</ScrollView>
