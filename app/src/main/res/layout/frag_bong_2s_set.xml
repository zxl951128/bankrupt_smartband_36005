<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:id="@+id/setting_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <RelativeLayout
            android:id="@+id/rl_my_bong2s"
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/common_title_height">
            <ImageView
                android:id="@+id/img_setting_device"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:src="@drawable/b3_setting_device"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toRightOf="@+id/img_setting_device">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:id="@+id/bong_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的 bong3"
                    style="@style/CommonText"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/system_update_reminder"
                    android:background="@drawable/update_version_bg"
                    android:padding="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/system_update_reminder"/>
            </LinearLayout>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="@dimen/item_icon_text_size"
                android:textColor="@color/black"
                android:id="@+id/forward_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="14dp"
                android:textColor="@color/black"
                android:id="@+id/charging"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/icon_charging"
                android:layout_toLeftOf="@+id/forward_img"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/charging">
                <cn.ginshell.bong.ui.view.BatteryView
                    android:id="@+id/battery_view"
                    android:layout_width="12dp"
                    android:layout_height="26dp"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    android:id="@+id/battery_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_margin_height">
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <RelativeLayout
                android:id="@+id/bong3_plate"
                android:background="@drawable/selector_btn_white"
                android:clickable="false"
                style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/icon_bong3_plate"
                    android:text="@string/icon_plate"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_plate"
                    android:layout_toRightOf="@+id/icon_bong3_plate"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/icon_bong3_plate"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/bong3_screen"
                android:background="@drawable/selector_btn_white"
                android:clickable="false"
                style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/icon_bong3_screen"
                    android:text="@string/icon_fitbit"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong3_screen_display"
                    android:layout_toRightOf="@+id/icon_bong3_screen"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/icon_bong3_screen"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_screen"
                android:background="@drawable/selector_btn_white"
                android:visibility="visible"
                android:clickable="true"
                style="@style/SetItem">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/icon_screen"
                    android:layout_marginLeft="24dp"
                    android:text="@string/icon_screen"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_display"
                    android:layout_toRightOf="@+id/icon_screen"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="27dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
            </RelativeLayout>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_heart_all"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_margin_height">
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <RelativeLayout
                android:id="@+id/sb_smart_heart"
                android:clickable="false"
                style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_smart_heart"
                    android:text="@string/icon_cracked_heart"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_smart_heart"
                    android:layout_toRightOf="@+id/no_icon_smart_heart"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_heart_monitor"
                android:clickable="true"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_heart"
                    android:text="@string/icon_measure"
                    style="@style/ItemIconText.Green"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/no_icon_heart"
                    android:layout_alignParentTop="true"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_heart"
                    android:layout_toRightOf="@+id/no_icon_heart"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="@dimen/item_margin_height"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_sit_remind"
                android:clickable="false"
                style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_sit"
                    android:text="@string/icon_sedentary"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_sit_remind"
                    android:layout_toRightOf="@+id/no_icon_sit"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/sb_sit_remind"
                    android:padding="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/MaterialDesignStyle"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/no_icon_sit"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_exercise_remind"
                android:clickable="false"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_exercise"
                    android:text="@string/icon_sedentary"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_sit_remind"
                    android:layout_toRightOf="@+id/no_icon_exercise"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/no_icon_exercise"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_alarm"
                android:clickable="true"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_alarm"
                    android:text="@string/icon_alarm"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_alarm"
                    android:layout_toRightOf="@+id/no_icon_alarm"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/no_icon_alarm"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_message"
                android:visibility="visible"
                android:clickable="true"
                style="@style/SetItem.Padding.Click">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_message"
                    android:text="@string/icon_notification"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/message_title"
                    android:layout_toRightOf="@+id/no_icon_message"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/no_icon_message"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_tel"
                    android:text="@string/icon_phone_call"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_2s_tel"
                    android:layout_toRightOf="@+id/no_icon_tel"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/sb_tel"
                    android:padding="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_toLeftOf="@+id/icon_info"
                    android:layout_centerVertical="true"
                    style="@style/MaterialDesignStyle"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="20dp"
                    android:textColor="@color/step_bottom"
                    android:id="@+id/icon_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="@string/icon_info"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:textSize="13dp"
            android:id="@+id/tv_shake_tip"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="@dimen/card_describe_margin"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="6dp"
            android:text="@string/my_bong_shake_tip"
            android:singleLine="false"
            style="@style/CommonText.Tip"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="@dimen/item_margin_height"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SetItem">
            <RelativeLayout
                android:background="@color/white"
                android:clickable="true"
                style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/icon_no_disturb"
                    android:text="@string/icon_no_disturb"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_set_no_disturb"
                    android:layout_toRightOf="@+id/icon_no_disturb"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/no_disturb_switch"
                    android:padding="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/MaterialDesignStyle"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_disturb"
                android:clickable="true"
                style="@style/SetItem.Padding.Click">
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginLeft="35dp"/>
                <TextView
                    android:id="@+id/tv_no_disturb_time"
                    android:layout_marginLeft="43dp"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/bong_2s_no_disturb_time"
                    android:layout_toRightOf="@+id/tv_no_disturb_time"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:textSize="13dp"
            android:id="@+id/disturb_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="@dimen/card_describe_margin"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="6dp"
            android:text="@string/my_bong_disturb_tip"
            android:singleLine="false"
            style="@style/CommonText.Tip"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="@dimen/item_margin_height"/>
        <RelativeLayout
            android:id="@+id/rl_search"
            android:clickable="true"
            style="@style/SetItem.Padding.Click">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/no_icon_search"
                android:text="@string/icon_find_bong"
                style="@style/ItemIconText.Green"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bong_2s_search"
                android:layout_toRightOf="@+id/no_icon_search"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textColor="@color/black"
                android:layout_marginLeft="5dp"
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                style="@style/ItemIconTextRight"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginBottom="@dimen/item_margin_height"/>
    </LinearLayout>
</ScrollView>
