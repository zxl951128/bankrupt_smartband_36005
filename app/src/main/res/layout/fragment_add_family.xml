<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/fragment_add_family_0"
    android:background="@drawable/round_white_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textColor="@color/blue"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/family_care"
        style="@style/TitleTextView"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/black_bg_90"
        android:gravity="center"
        android:id="@+id/family_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/bind_family_tip"
        style="@style/TextViewTip"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textSize="13dp"
        android:textColor="@color/black"
        android:id="@+id/bong_id_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/bongid_tip"/>
    <ImageView
        android:id="@+id/bind_family_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_horizontal_margin"
        android:layout_marginTop="15dp"
        android:layout_marginRight="@dimen/common_horizontal_margin"
        android:src="@drawable/bind_family"/>
    <EditText
        android:id="@+id/bong_id"
        android:background="@drawable/input_homecare_1"
        android:hint="@string/bong_id_hint"
        android:inputType="text"
        android:imeOptions="actionNext"
        style="@style/FamilyEditor">
        <requestFocus/>
    </EditText>
    <EditText
        android:id="@+id/phone_4"
        android:background="@drawable/input_homecare_2"
        android:layout_height="57dp"
        android:hint="@string/phone_number_last_4"
        android:digits="0123456789"
        android:inputType="phone"
        android:imeOptions="actionDone"
        style="@style/FamilyEditor"/>
    <TextView
        android:textColor="@color/red_1"
        android:id="@+id/error_tip"
        style="@style/TextViewTip"/>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="10dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <TextView
            android:textSize="18dp"
            android:textColor="@color/white_6"
            android:gravity="center"
            android:id="@+id/cancel"
            android:tag="binding_1"
            android:background="@drawable/selector_btn_normal"
            android:padding="10dp"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/not_for_now"
            android:layout_weight="1"/>
        <View
            android:background="@color/white_c"
            android:layout_width="1px"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/green_1"
            android:gravity="center"
            android:id="@+id/confirm"
            android:tag="binding_2"
            android:background="@drawable/selector_btn_normal"
            android:padding="10dp"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/add_family"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
