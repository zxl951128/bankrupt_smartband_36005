<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/item_run_train_detail_official_complete_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/rl_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/official_time"
                android:background="@drawable/run_train_gray_circle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="5\10min"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/black"
                android:id="@+id/official_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/fast_walk_name"
                android:layout_toRightOf="@+id/official_time"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white_3"
                android:id="@+id/official_speed_relax"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/relax_speed"
                android:layout_alignBottom="@+id/official_type"
                android:layout_centerInParent="true"/>
            <LinearLayout
                android:id="@+id/ll_number"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <TextView
                    android:textSize="25dp"
                    android:textColor="@color/white_3"
                    android:layout_gravity="center"
                    android:id="@+id/official_speed_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/value_null"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/white_3"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text=" km/h"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:visibility="visible"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="25dp"
                    android:textColor="@color/white_3"
                    android:layout_gravity="center"
                    android:id="@+id/actual_speed_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/value_null"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white_3"
                    android:layout_gravity="center"
                    android:id="@+id/tv_km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text=" km/h"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <TextView
        android:id="@+id/small_circle"
        android:background="@drawable/run_train_gray_small_circle"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/rl_top"/>
    <View
        android:id="@+id/speed_bg"
        android:background="@color/train_actual_speed"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_alignBottom="@+id/small_circle"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <cn.ginshell.bong.ui.view.RunSpeedDashedLine
        android:layout_width="1dp"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/speed_bg"
        android:layout_alignBottom="@+id/small_circle"
        android:layout_alignParentTop="true"/>
    <cn.ginshell.bong.ui.view.RunSpeedDashedLine
        android:layout_width="1dp"
        android:layout_height="wrap_content"
        android:layout_alignRight="@+id/speed_bg"
        android:layout_alignBottom="@+id/small_circle"
        android:layout_alignParentTop="true"/>
</RelativeLayout>
