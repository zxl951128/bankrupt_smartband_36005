<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/item"
    android:background="@color/white_f0"
    android:layout_width="match_parent"
    android:layout_height="85dp">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="60dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/tv_measure_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:lines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/black"
            android:gravity="bottom"
            android:id="@+id/tv_measure_type"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/fit_item_manual"/>
    </LinearLayout>
    <View
        android:background="@color/blue"
        android:layout_width="5dp"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/icon_right">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="15dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fit_item_weight"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="22dp"
                        android:textColor="@color/blue"
                        android:id="@+id/tv_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/white_6"
                        android:gravity="bottom"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="3dp"
                        android:text="@string/f_kg_unit"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="15dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fit_fat"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="22dp"
                        android:textColor="@color/blue"
                        android:id="@+id/tv_fat_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/white_6"
                        android:gravity="bottom"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="3dp"
                        android:text="@string/unit_percent"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="15dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BMI"/>
                <TextView
                    android:textSize="22dp"
                    android:textColor="@color/blue"
                    android:id="@+id/tv_bmi_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"/>
            </LinearLayout>
        </LinearLayout>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textColor="@color/black"
            android:id="@+id/icon_right"
            android:visibility="visible"
            android:layout_marginLeft="5dp"
            android:text="@string/icon_forward"
            style="@style/ItemIconTextRight"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </RelativeLayout>
</LinearLayout>
