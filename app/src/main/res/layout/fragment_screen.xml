<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/main_content"
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/actionbar_green"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_arrange_pan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="8dp">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            style="@style/SetItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/arrange_style"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <com.rqg.common.view.SideView
                android:id="@+id/sideview_arrange"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                xmlns:ns1="http://schemas.android.com/apk/res-auto" 
                ns1:focusColor="@color/green_1"
                xmlns:ns2="http://schemas.android.com/apk/res-auto" 
                ns2:leftText="@string/screen_horizontal"
                xmlns:ns3="http://schemas.android.com/apk/res-auto" 
                ns3:radius="2dp"
                xmlns:ns4="http://schemas.android.com/apk/res-auto" 
                ns4:rightText="@string/screen_vertical"
                xmlns:ns5="http://schemas.android.com/apk/res-auto" 
                ns5:strokeWidth="1dp"
                xmlns:ns6="http://schemas.android.com/apk/res-auto" 
                ns6:textPaddingHorizontal="6dp"
                xmlns:ns7="http://schemas.android.com/apk/res-auto" 
                ns7:textPaddingVertical="6dp"
                xmlns:ns8="http://schemas.android.com/apk/res-auto" 
                ns8:textSize="15dp"
                xmlns:ns9="http://schemas.android.com/apk/res-auto" 
                ns9:unfocusColor="@color/white"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/hand_pan"
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            style="@style/SetItem">
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="15dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/card_set_wear_choose"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <com.rqg.common.view.SideView
                android:id="@+id/sideview_hand"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                xmlns:ns10="http://schemas.android.com/apk/res-auto" 
                ns10:focusColor="@color/green_1"
                xmlns:ns11="http://schemas.android.com/apk/res-auto" 
                ns11:leftText="@string/set_left_hand"
                xmlns:ns12="http://schemas.android.com/apk/res-auto" 
                ns12:radius="2dp"
                xmlns:ns13="http://schemas.android.com/apk/res-auto" 
                ns13:rightText="@string/set_right_hand"
                xmlns:ns14="http://schemas.android.com/apk/res-auto" 
                ns14:strokeWidth="1dp"
                xmlns:ns15="http://schemas.android.com/apk/res-auto" 
                ns15:textPaddingHorizontal="6dp"
                xmlns:ns16="http://schemas.android.com/apk/res-auto" 
                ns16:textPaddingVertical="6dp"
                xmlns:ns17="http://schemas.android.com/apk/res-auto" 
                ns17:textSize="15dp"
                xmlns:ns18="http://schemas.android.com/apk/res-auto" 
                ns18:unfocusColor="@color/white"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="8dp">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            style="@style/SetItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/switch_style"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <com.rqg.common.view.SideView
                android:id="@+id/sideview_switch"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                xmlns:ns19="http://schemas.android.com/apk/res-auto" 
                ns19:focusColor="@color/green_1"
                xmlns:ns20="http://schemas.android.com/apk/res-auto" 
                ns20:leftText="@string/screen_manual"
                xmlns:ns21="http://schemas.android.com/apk/res-auto" 
                ns21:radius="2dp"
                xmlns:ns22="http://schemas.android.com/apk/res-auto" 
                ns22:rightText="@string/screen_auto"
                xmlns:ns23="http://schemas.android.com/apk/res-auto" 
                ns23:strokeWidth="1dp"
                xmlns:ns24="http://schemas.android.com/apk/res-auto" 
                ns24:textPaddingHorizontal="6dp"
                xmlns:ns25="http://schemas.android.com/apk/res-auto" 
                ns25:textPaddingVertical="6dp"
                xmlns:ns26="http://schemas.android.com/apk/res-auto" 
                ns26:textSize="15dp"
                xmlns:ns27="http://schemas.android.com/apk/res-auto" 
                ns27:unfocusColor="@color/white"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            style="@style/SetItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/highlight"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <com.rqg.common.view.SideView
                android:id="@+id/sideview_highlight"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                xmlns:ns28="http://schemas.android.com/apk/res-auto" 
                ns28:focusColor="@color/green_1"
                xmlns:ns29="http://schemas.android.com/apk/res-auto" 
                ns29:leftText="@string/screen_normal"
                xmlns:ns30="http://schemas.android.com/apk/res-auto" 
                ns30:radius="2dp"
                xmlns:ns31="http://schemas.android.com/apk/res-auto" 
                ns31:rightText="@string/screen_highlight"
                xmlns:ns32="http://schemas.android.com/apk/res-auto" 
                ns32:strokeWidth="1dp"
                xmlns:ns33="http://schemas.android.com/apk/res-auto" 
                ns33:textPaddingHorizontal="6dp"
                xmlns:ns34="http://schemas.android.com/apk/res-auto" 
                ns34:textPaddingVertical="6dp"
                xmlns:ns35="http://schemas.android.com/apk/res-auto" 
                ns35:textSize="15dp"
                xmlns:ns36="http://schemas.android.com/apk/res-auto" 
                ns36:unfocusColor="@color/white"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="8dp"
        android:text="@string/screen_highlight_battery"
        style="@style/SetItemTipText"/>
</LinearLayout>
