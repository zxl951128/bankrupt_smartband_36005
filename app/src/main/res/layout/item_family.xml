<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/item_family_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/family_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="@dimen/family_view_width"
            android:layout_height="@dimen/family_view_width"
            android:layout_marginTop="15dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/family_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                xmlns:ns1="http://schemas.android.com/apk/res-auto" 
                ns1:placeholderImage="@mipmap/appicon"
                xmlns:ns2="http://schemas.android.com/apk/res-auto" 
                ns2:roundAsCircle="true"/>
            <ImageView
                android:layout_gravity="bottom|right"
                android:id="@+id/select_indicator"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/family_checked"/>
        </FrameLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:ellipsize="start"
            android:id="@+id/family_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Friend"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <Button
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/del_btn"
        android:background="@drawable/selector_red"
        android:layout_width="@dimen/family_view_width"
        android:layout_height="25dp"
        android:layout_marginTop="5dp"
        android:text="@string/delete"/>
</LinearLayout>
