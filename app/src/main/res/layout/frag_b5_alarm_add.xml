<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/actionbar_green"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"/>
            <RelativeLayout
                android:id="@+id/rl_set_alarm_name"
                style="@style/ReminderItem">
                <TextView
                    android:text="@string/alarm_clock_setting_name"
                    android:layout_centerVertical="true"
                    style="@style/CommonText"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:id="@+id/alarm_clock_name"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    style="@style/ItemIconTextRight"/>
                <EditText
                    android:gravity="center"
                    android:id="@+id/et_set_alarm_name"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/alarm_input_alarm_name_def"
                    android:hint="@string/alarm_input_alarm_name_hint"
                    android:layout_toLeftOf="@+id/alarm_clock_name"
                    style="@style/CommonEditText.Black"/>
            </RelativeLayout>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"/>
            <RelativeLayout
                android:id="@+id/rl_set_time"
                style="@style/ReminderItem">
                <TextView
                    android:text="@string/alarm_clock_setting_time"
                    android:layout_centerVertical="true"
                    style="@style/CommonText"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:id="@+id/alarm_clock_setting_time"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    style="@style/ItemIconTextRight"/>
                <TextView
                    android:id="@+id/tv_set_time"
                    android:text="@string/alarm_select_time_def"
                    android:layout_toLeftOf="@+id/alarm_clock_setting_time"
                    android:layout_centerVertical="true"
                    style="@style/CommonText"/>
            </RelativeLayout>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"/>
            <RelativeLayout
                android:id="@+id/week_pan"
                style="@style/ReminderItem">
                <TextView
                    android:text="@string/alarm_repeat_day"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    style="@style/CommonText"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:id="@+id/alarm_repeat_day"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <TextView
                    android:id="@+id/tv_week"
                    android:layout_toLeftOf="@+id/alarm_repeat_day"
                    android:layout_centerVertical="true"
                    style="@style/CommonText"/>
            </RelativeLayout>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/actionbar_green"/>
    <include layout="@layout/actionbar_green"/>
</LinearLayout>
