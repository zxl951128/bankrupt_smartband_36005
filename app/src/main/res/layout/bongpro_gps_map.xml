<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="290dp"
    android:layout_below="@+id/part_gps_sport_top">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/rl_map_parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <cn.ginshell.bong.ui.fragment.pro.view.MapContainer
            android:id="@+id/map_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.amap.api.maps.TextureMapView
                android:id="@+id/map_view"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.google.android.gms.maps.MapView
                android:id="@+id/google_map_view"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </cn.ginshell.bong.ui.fragment.pro.view.MapContainer>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/pro_gps_map_icon_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/map_view_control"
            android:background="@drawable/bg_map_icon"
            android:paddingTop="2dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="24dp"
            android:text="@string/icon_see_map"
            android:layout_above="@+id/km_tip"
            android:layout_alignParentRight="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/pro_gps_map_icon_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/km_tip"
            android:background="@drawable/bg_map_icon"
            android:paddingTop="2dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="24dp"
            android:text="@string/icon_pro_km"
            android:layout_above="@+id/map_state_indicator"
            android:layout_alignLeft="@+id/map_state_indicator"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/pro_gps_map_icon_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/map_state_indicator"
            android:background="@drawable/bg_map_icon"
            android:paddingTop="2dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="45dp"
            android:text="@string/icon_full_screen"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/pro_gps_map_icon_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/map_location"
            android:background="@drawable/bg_map_icon"
            android:paddingTop="2dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="15dp"
            android:layout_marginBottom="15dp"
            android:text="@string/icon_location"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_speed_color_tip"
            android:layout_width="110dp"
            android:layout_height="35dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="5dp">
                <TextView
                    android:textColor="@color/black"
                    android:id="@+id/tv_speed_slow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pro_sport_gps_tip_slow"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tv_slow_data"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="2"
                    android:layout_toRightOf="@+id/tv_speed_slow"/>
                <TextView
                    android:textColor="@color/black"
                    android:id="@+id/tv_speed_fast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pro_sport_gps_tip_fast"
                    android:layout_alignParentRight="true"/>
                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/tv_fast_data"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="1"
                    android:layout_toLeftOf="@+id/tv_speed_fast"/>
            </RelativeLayout>
            <View
                android:background="@drawable/bg_speed_slow_fast"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="10dp"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
