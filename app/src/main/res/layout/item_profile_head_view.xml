<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/rl_user_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/user_img_part_height"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:id="@+id/rl_user_img"
            android:background="@drawable/user_bg"
            android:padding="1dp"
            android:layout_width="@dimen/user_img_size"
            android:layout_height="@dimen/user_img_size"
            android:layout_marginLeft="@dimen/user_img_margin_left"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/iv_user_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/user_img_default"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:id="@+id/tv_user_nick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_toRightOf="@+id/rl_user_img"
            android:layout_centerVertical="true"
            style="@style/CommonText.White"/>
        <ImageView
            android:id="@+id/iv_left_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="@dimen/user_img_margin_left"
            android:src="@drawable/selector_user_profiles"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</RelativeLayout>
