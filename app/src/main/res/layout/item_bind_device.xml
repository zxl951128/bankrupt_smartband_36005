<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    style="@style/SetItem.TransportClick">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_left"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_device_img"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/bind_icon_2p"
            android:layout_centerVertical="true"/>
        <com.rqg.common.view.SingleView
            android:id="@+id/rssi_single"
            android:layout_width="24dp"
            android:layout_height="16dp"
            xmlns:ns1="http://schemas.android.com/apk/res-auto" 
            ns1:active_color="@color/green_1"
            xmlns:ns2="http://schemas.android.com/apk/res-auto" 
            ns2:negative_color="@color/white_9"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/green_4"
            android:id="@+id/rssi_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-64"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/ll_right"
        android:layout_toRightOf="@+id/ll_left">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/green_4"
                android:id="@+id/tv_ble_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="bong X2"
                style="@style/CommonText.Black"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/white"
                android:id="@+id/tv_bind_result"
                android:background="@color/red_1"
                android:paddingLeft="8dp"
                android:paddingTop="5dp"
                android:paddingRight="8dp"
                android:paddingBottom="5dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="绑定失败,请重试"
                style="@style/CommonText.Black"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/green_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="MAC"
                style="@style/CommonText.ItemBlack"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white_6"
                android:id="@+id/tv_mac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CA:C0:FE:E9:87:E9"
                style="@style/CommonText.ItemBlack"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_right"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="15dp"
        android:minWidth="60dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white_6"
            android:gravity="center"
            android:id="@+id/tv_bound"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bond"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/selector_green_text"
            android:gravity="center"
            android:id="@+id/tv_action"
            android:background="@drawable/selector_btn_border_green"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:text="@string/setting_bind"/>
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="25dp"
            android:layout_height="25dp"
            style="?android:attr/progressBarStyle"/>
    </LinearLayout>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="15dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
