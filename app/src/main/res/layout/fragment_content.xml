<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/fragment_content_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:id="@+id/main_content"
        android:background="@color/common_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/action_bar_common"
            style="@style/CommonTitle.Green">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/title_left"
                android:tag="binding_1"
                style="@style/TitleLeft"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/title_right"
                style="@style/TitleRight"/>
            <TextView
                android:id="@+id/title_center"
                android:text="@string/screen_content"
                style="@style/TitleCenter"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/DividerLine"/>
        </RelativeLayout>
        <RelativeLayout
            android:background="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1sp"/>
            <ImageView
                android:background="@drawable/b3_setting_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/screen_show_image"
                android:background="@drawable/anim_b4_screen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="11dp"
                android:textColor="@color/black_bg_80"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:text="@string/screen_show_setting"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <RelativeLayout
                android:id="@+id/bong4_plate"
                android:background="@drawable/selector_btn_white"
                android:clickable="false"
                style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/icon_bong3_plate"
                    android:text="@string/icon_plate"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_plate"
                    android:layout_toRightOf="@+id/icon_bong3_plate"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/icon_bong3_plate"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:clickable="false"
                style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/no_icon_sport_goto"
                    android:text="@string/icon_run"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_sports"
                    android:layout_toRightOf="@+id/no_icon_sport_goto"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/sport_start_switch"
                    android:padding="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/MaterialDesignStyle"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/no_icon_sport_goto"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_weather"
                android:background="@drawable/selector_btn_white"
                android:visibility="visible"
                android:clickable="true"
                style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/icon_weather"
                    android:text="@string/icon_weather"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weather_title"
                    android:layout_toRightOf="@+id/icon_weather"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textColor="@color/black"
                    android:layout_marginLeft="5dp"
                    android:text="@string/icon_forward"
                    android:layout_alignParentRight="true"
                    style="@style/ItemIconTextRight"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_toRightOf="@+id/icon_weather"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:clickable="false"
                style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/icon_heart"
                    android:text="@string/icon_cracked_heart"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_rate"
                    android:layout_toRightOf="@+id/icon_heart"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/heart_switchbtn"
                    android:padding="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/MaterialDesignStyle"/>
            </RelativeLayout>
            <RelativeLayout
                android:visibility="gone"
                android:clickable="false"
                style="@style/SetItem.Padding">
                <cn.ginshell.bong.ui.view.IconTextView
                    android:id="@+id/icon_bong3_screen"
                    android:text="@string/icon_step"
                    style="@style/ItemIconText.Green"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bong_pets"
                    android:layout_toRightOf="@+id/icon_bong3_screen"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/bong_pets_switch"
                    android:padding="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    style="@style/MaterialDesignStyle"/>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </LinearLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
</ScrollView>
