<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/item_run_train_detail_warn_complete_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="25dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/warn_body_name"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/advice_speed"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white_3"
                android:gravity="center"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="@string/actual_speed"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/warn_time"
                android:background="@drawable/run_train_gray_circle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="5\10min"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/black"
                android:id="@+id/warn_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/fast_walk_name"
                android:layout_toRightOf="@+id/warn_time"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white_3"
                android:id="@+id/warn_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/relax_speed"
                android:layout_alignBottom="@+id/warn_type"
                android:layout_centerInParent="true"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_alignParentRight="true">
                <TextView
                    android:textSize="25dp"
                    android:textColor="@color/white_3"
                    android:id="@+id/actual_speed_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/value_null"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/white_3"
                    android:id="@+id/tv_km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text=" km/h"/>
            </LinearLayout>
        </RelativeLayout>
        <View
            android:background="#cccccc"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="20dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:id="@+id/official_train"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="15dp"
            android:text="@string/official_train_name"/>
    </LinearLayout>
    <View
        android:id="@+id/speed_bg"
        android:background="@color/train_actual_speed"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_alignTop="@+id/ll_top"
        android:layout_alignBottom="@+id/ll_top"
        android:layout_alignParentRight="true"/>
    <cn.ginshell.bong.ui.view.RunSpeedDashedLine
        android:layout_width="1dp"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/speed_bg"
        android:layout_alignBottom="@+id/ll_top"
        android:layout_alignParentTop="true"/>
    <cn.ginshell.bong.ui.view.RunSpeedDashedLine
        android:layout_width="1dp"
        android:layout_height="wrap_content"
        android:layout_alignRight="@+id/speed_bg"
        android:layout_alignBottom="@+id/ll_top"
        android:layout_alignParentTop="true"/>
</RelativeLayout>
