<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/pro_sport_top_color"
    android:layout_width="match_parent"
    android:layout_height="160dp">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/time_text"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="50dp"
                android:textColor="@color/white"
                android:gravity="top"
                android:id="@+id/top_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="V1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="@dimen/pro_data_name_size"
                android:textColor="@color/white_60"
                android:id="@+id/top_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_length"
                style="@style/CommonText.Tip"/>
        </LinearLayout>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:id="@+id/tv_run_train_state"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="43dp"
            android:layout_toRightOf="@+id/ll_top"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="25dp"
            android:textColor="@color/white"
            android:gravity="top"
            android:id="@+id/icon_run_train_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="37dp"
            android:text="@string/icon_train_grade_tip"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/tv_run_train_state"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/pro_data_number_size"
                    android:textColor="@color/white"
                    android:gravity="bottom"
                    android:id="@+id/left_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/pro_data_name_size"
                    android:textColor="@color/white_60"
                    android:id="@+id/left_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/deep_sleep"
                    style="@style/CommonText.Tip"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_part_center"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/pro_data_number_size"
                    android:textColor="@color/white"
                    android:gravity="bottom"
                    android:id="@+id/center_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/pro_data_name_size"
                    android:textColor="@color/white_60"
                    android:id="@+id/center_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kilometer_distance"
                    style="@style/CommonText.Tip"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_part_right"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/pro_data_number_size"
                    android:textColor="@color/white"
                    android:gravity="bottom"
                    android:id="@+id/right_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/pro_data_name_size"
                    android:textColor="@color/white_60"
                    android:id="@+id/right_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/deep_sleep"
                    style="@style/CommonText.Tip"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
