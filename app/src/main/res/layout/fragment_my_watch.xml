<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/actionbar_green"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_model_margin"
                android:layout_marginBottom="@dimen/item_model_margin">
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <RelativeLayout
                    android:id="@+id/rl_firmware_update"
                    android:clickable="true"
                    style="@style/SetItem.Padding.Click">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/iv_firmware_update"
                        android:text="@string/icon_upgrade"
                        android:includeFontPadding="false"
                        style="@style/ItemIconText"/>
                    <TextView
                        android:id="@+id/tv_sys_update"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_bong_firmware_update"
                        android:layout_toRightOf="@+id/iv_firmware_update"
                        android:layout_centerVertical="true"
                        style="@style/CommonText"/>
                    <View
                        android:layout_marginLeft="5dp"
                        android:layout_toRightOf="@+id/tv_sys_update"
                        android:layout_centerVertical="true"
                        style="@style/RedPoint"/>
                    <TextView
                        android:textSize="15dp"
                        android:id="@+id/tv_sys_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toLeftOf="@+id/iv_left_more"
                        android:layout_centerVertical="true"
                        style="@style/CommonText"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/black"
                        android:id="@+id/iv_left_more"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        style="@style/ItemIconTextRight"/>
                    <View
                        android:background="@color/white_c"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_toRightOf="@+id/iv_firmware_update"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_restart"
                    android:clickable="true"
                    style="@style/SetItem.Padding.Click">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/iv_restart"
                        android:text="@string/icon_restart"
                        style="@style/ItemIconText"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_bong_restart"
                        android:layout_toRightOf="@+id/iv_restart"
                        android:layout_centerVertical="true"
                        style="@style/CommonText"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/white"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                    <View
                        android:background="@color/white_c"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_toRightOf="@+id/iv_restart"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_unbind"
                    android:clickable="true"
                    style="@style/SetItem.Padding.Click">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/iv_unbind_img"
                        android:text="@string/icon_unbind"
                        style="@style/ItemIconText"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_bong_unbind"
                        android:layout_toRightOf="@+id/iv_unbind_img"
                        android:layout_centerVertical="true"
                        style="@style/CommonText"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/white"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                </RelativeLayout>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
                <RelativeLayout
                    android:id="@+id/nx2_gesture_pan"
                    android:clickable="true"
                    style="@style/SetItem.Padding.Click">
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:id="@+id/nx2_gesture"
                        android:text="@string/icon_gesture"
                        style="@style/ItemIconText"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nx2_gesture_guide"
                        android:layout_toRightOf="@+id/nx2_gesture"
                        android:layout_centerVertical="true"
                        style="@style/CommonText"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/white"
                        android:layout_marginLeft="5dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                </RelativeLayout>
                <View
                    android:background="@color/white_c"
                    android:layout_width="match_parent"
                    android:layout_height="1px"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
