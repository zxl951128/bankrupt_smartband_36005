<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_left"
            style="@style/TitleLeft"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_right"
            style="@style/TitleRight"/>
        <TextView
            android:id="@+id/title"
            android:text="@string/message_title"
            style="@style/TitleCenter"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="200dp">
        <ImageView
            android:background="@drawable/b3_setting_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <ImageView
            android:background="@drawable/b3_setting_msg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
    <TextView
        android:textColor="@color/black_bg_80"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="25dp"
        android:text="@string/msg_notification_desc"
        style="@style/SetItemTipText"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:id="@+id/rl_wechat"
            android:background="@drawable/selector_btn_white"
            style="@style/SetItem">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/iv_firmware_update"
                android:text="@string/icon_wechart"
                android:includeFontPadding="false"
                style="@style/ItemIconText"/>
            <TextView
                android:id="@+id/tv_sys_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wechat"
                android:layout_toRightOf="@+id/iv_firmware_update"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <View
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@+id/tv_sys_update"
                android:layout_centerVertical="true"
                style="@style/RedPoint"/>
            <TextView
                android:textSize="15dp"
                android:id="@+id/tv_sys_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/iv_left_more"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/switch_button_wechat"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_toRightOf="@+id/iv_firmware_update"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_qq"
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            style="@style/SetItem">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/iv_restart"
                android:text="@string/icon_qq"
                style="@style/ItemIconText"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qq"
                android:layout_toRightOf="@+id/iv_restart"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/switch_button_qq"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_toRightOf="@+id/iv_restart"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_sms"
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            style="@style/SetItem">
            <cn.ginshell.bong.ui.view.IconTextView
                android:id="@+id/iv_unbind_img"
                android:text="@string/icon_sms"
                style="@style/ItemIconText"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sms"
                android:layout_toRightOf="@+id/iv_unbind_img"
                android:layout_centerVertical="true"
                style="@style/CommonText"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/switch_button_sms"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
</LinearLayout>
