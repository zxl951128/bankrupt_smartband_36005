<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/tip_one"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="1">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/tip_text_11"
        android:text="@string/nx2_unlock"
        style="@style/Nx2Tip"/>
    <ViewSwitcher
        android:id="@+id/view_switch_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <ImageView
            android:id="@+id/getsture_img_1"
            android:src="@drawable/x2_gesutre_1"
            style="@style/GestureHelpImageView"/>
        <ImageView
            android:id="@+id/getsture_img_2"
            android:src="@drawable/x2_gesutre_2"
            style="@style/GestureHelpImageView"/>
    </ViewSwitcher>
    <TextView
        android:layout_marginTop="20dp"
        android:text="@string/nx2_switch"
        style="@style/Nx2Tip"/>
    <ViewSwitcher
        android:id="@+id/view_switch_12"
        android:padding="22dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <ImageView
            android:id="@+id/getsture_img_3"
            android:src="@drawable/x2_gesutre_3"
            style="@style/GestureHelpImageView"/>
        <ImageView
            android:id="@+id/getsture_img_4"
            android:src="@drawable/x2_gesutre_4"
            style="@style/GestureHelpImageView"/>
    </ViewSwitcher>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="20dp"/>
    <TextView
        android:textSize="@dimen/common_text_size"
        android:textColor="@color/green_1"
        android:gravity="center"
        android:id="@+id/next_step"
        android:background="@drawable/selector_btn_normal"
        android:padding="10dp"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_next"/>
</LinearLayout>
