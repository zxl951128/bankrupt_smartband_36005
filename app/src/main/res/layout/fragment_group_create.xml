<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/fragment_group_create_0"
    android:background="@color/white_f2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View xmlns:android="http://schemas.android.com/apk/res/android"
        android:background="@color/green_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_height"/>
    <RelativeLayout
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:tag="binding_1"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/group_create_title"
            android:lines="1"
            android:layout_centerInParent="true"
            style="@style/CommonText"/>
    </RelativeLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        android:text="@string/group_pos_intro"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_position"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <View style="@style/DividerLine"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            style="@style/SetItem.TransportClick">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:text="@string/group_pos"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_position"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="海创园"
                android:hint="15字以内"
                android:lines="1"
                android:layout_weight="1"/>
            <com.wang.avi.AVLoadingIndicatorView
                android:id="@+id/loadingView"
                android:layout_width="24dp"
                android:layout_height="24dp"
                xmlns:ns1="http://schemas.android.com/apk/res-auto" 
                ns1:indicatorColor="@color/green_1"
                xmlns:ns2="http://schemas.android.com/apk/res-auto" 
                ns2:indicatorName="BallSpinFadeLoaderIndicator"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textColor="@color/black"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="15dp"
                android:text="@string/icon_forward"
                style="@style/ItemIconTextRight"/>
        </LinearLayout>
        <View style="@style/DividerLine"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        android:text="@string/group_label_intro"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <View style="@style/DividerLine"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/group_label"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/label_contain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <cn.ginshell.bong.group.view.TagListView
            android:id="@+id/tag_view"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            xmlns:ns3="http://schemas.android.com/apk/res-auto" 
            ns3:horizontalSpacing="15dp"
            xmlns:ns4="http://schemas.android.com/apk/res-auto" 
            ns4:orientation="horizontal"
            xmlns:ns5="http://schemas.android.com/apk/res-auto" 
            ns5:verticalSpacing="10dp"/>
        <View style="@style/DividerLine"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp">
        <View style="@style/DividerLine"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:text="@string/group_add_auth"
                android:layout_weight="1"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/auth_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                style="@style/MaterialDesignStyle"/>
        </LinearLayout>
        <View style="@style/DividerLine"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="0.2"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_create"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="20dp"
        android:text="@string/group_create"
        style="@style/StyledButtonGreen"/>
</LinearLayout>
