<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="2">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/bong_pro_icon_size"
            android:textColor="@color/white"
            android:id="@+id/left_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/icon_time"/>
        <TextView
            android:textSize="@dimen/bong_pro_text_size"
            android:textColor="@color/white"
            android:id="@+id/left_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/time_count"/>
        <TextView
            android:textSize="@dimen/bong_pro_title_size"
            android:textColor="@color/white"
            android:id="@+id/left_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@drawable/gradient_white_transparent"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/bong_pro_icon_size"
            android:textColor="@color/white"
            android:id="@+id/right_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_energy"/>
        <TextView
            android:textSize="@dimen/bong_pro_text_size"
            android:textColor="@color/white"
            android:id="@+id/right_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/energy_coast"/>
        <TextView
            android:textSize="@dimen/bong_pro_title_size"
            android:textColor="@color/white"
            android:id="@+id/right_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"/>
    </LinearLayout>
</LinearLayout>
