<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/item_choose_channel_0"
    android:background="@drawable/bg_with_shadow"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp"
    android:layout_marginBottom="8dp">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/intelligent_music_rela"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="150dp">
        <FrameLayout
            android:id="@+id/fl_bg"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="90dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/music_detail"
                android:layout_width="match_parent"
                android:layout_height="90dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fl_net_bg"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="90dp">
            <View
                android:background="@color/black_bg_30"
                android:layout_width="match_parent"
                android:layout_height="90dp"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/sd_bg"
                android:layout_width="match_parent"
                android:layout_height="90dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/music_net_detail"
                android:layout_width="match_parent"
                android:layout_height="90dp"/>
        </FrameLayout>
        <TextView
            android:textSize="14dp"
            android:id="@+id/songs_num"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nt_music_count"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/purple_action_bar_bg"
            android:gravity="center"
            android:id="@+id/intelligent_music_txt"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/intelligent_music"
            android:layout_above="@+id/songs_num"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/back_img"
        android:background="@drawable/intelligent_music_rect2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="150dp"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/finish_img"
        android:background="@drawable/intelligent_music_rect3"
        android:visibility="invisible"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:text="@string/icon_finish"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
