<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/table_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/bong_pro_common_padding"
        android:paddingTop="20dp"
        android:paddingRight="@dimen/bong_pro_common_padding"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:weightSum="2">
        <LinearLayout
            android:paddingRight="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="10dp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_energy"/>
            <TextView
                android:textSize="@dimen/bong_pro_text_size"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="@string/energy_coast"/>
            <TextView
                android:textSize="@dimen/bong_pro_title_size"
                android:textColor="@color/black"
                android:gravity="right"
                android:id="@+id/energy_coast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/heart_pan"
            android:paddingLeft="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="10dp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_heart"/>
            <TextView
                android:textSize="@dimen/bong_pro_text_size"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="@string/average_heart_rate"/>
            <TextView
                android:textSize="@dimen/bong_pro_title_size"
                android:textColor="@color/black"
                android:gravity="right"
                android:id="@+id/average_heart_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
