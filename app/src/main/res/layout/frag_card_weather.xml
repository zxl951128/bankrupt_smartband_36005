<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/black_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/part_actionbar"/>
    <RelativeLayout
        android:padding="@dimen/card_top_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@color/btn_bg_yellow"
            android:padding="1px"
            android:layout_width="@dimen/card_img_width"
            android:layout_height="@dimen/card_img_height"
            android:src="@drawable/card_next"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/set_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_model_margin">
        <ImageView
            android:background="@color/set_split_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:background="@color/set_bg"
            style="@style/SetItem">
            <TextView
                android:id="@+id/auto_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_margin_left"
                android:text="@string/weather_auto_location"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.White"/>
            <TextView
                android:id="@+id/tv_auto_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_margin_left"
                android:text="@string/locating"
                android:layout_toRightOf="@+id/auto_name"
                android:layout_centerVertical="true"
                style="@style/CommonText.Yellow"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/city_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_select_city"
            android:clickable="true"
            style="@style/SetItem.Click">
            <ImageView
                android:background="@color/set_split_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="@dimen/item_margin_left"
                android:layout_alignParentTop="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_margin_left"
                android:text="@string/weather_city"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.White"/>
            <TextView
                android:id="@+id/tv_select_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/item_margin_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.White"/>
            <ProgressBar
                android:id="@+id/progress_update_city"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="@dimen/item_margin_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/set_split_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="@dimen/card_describe_margin"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="6dp"
        android:text="@string/weather_tip_one"
        android:singleLine="false"
        style="@style/CommonText.Tip"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_item_margin">
        <ImageView
            android:background="@color/set_split_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <RelativeLayout
            android:background="@color/set_bg"
            style="@style/SetItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/weather_smart_push"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                style="@style/CommonText.White"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/smart_push_switch"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <ImageView
            android:background="@color/set_split_line"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="@dimen/card_describe_margin"
        android:layout_marginRight="15dp"
        android:text="@string/weather_tip_two"
        android:singleLine="false"
        style="@style/CommonText.Tip"/>
</LinearLayout>
