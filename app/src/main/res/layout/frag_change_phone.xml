<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:background="@color/user_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1">
    <include xmlns:android="http://schemas.android.com/apk/res/android" layout="@layout/part_actionbar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:isScrollContainer="false">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/line1"
                android:layout_marginTop="30dp"
                style="@style/CommonItem">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/tl_area"
                        android:background="@drawable/selector_set_item_light_bg"
                        android:paddingLeft="10dp"
                        android:paddingRight="15dp"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <TextView
                            android:ellipsize="end"
                            android:id="@+id/tv_country"
                            android:layout_marginLeft="5dp"
                            android:text="@string/country_china_default"
                            android:maxLength="9"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"
                            style="@style/CommonText.ItemBlack"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <EditText
                            android:id="@+id/et_phone"
                            android:paddingLeft="10dp"
                            android:layout_width="match_parent"
                            android:layout_toLeftOf="@+id/btn_sendcode"
                            android:layout_centerVertical="true"
                            android:inputType="number"
                            style="@style/CommonEditText.White"/>
                        <Button
                            android:textSize="16dp"
                            android:id="@+id/btn_sendcode"
                            android:layout_width="45dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="2dp"
                            android:layout_marginBottom="5dp"
                            android:text="@string/register_verification"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            style="@style/CommonButton"/>
                    </RelativeLayout>
                </LinearLayout>
                <View
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/line2"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/line1"
                style="@style/CommonItem">
                <TextView
                    android:ellipsize="marquee"
                    android:id="@+id/tv_yzm"
                    android:layout_marginLeft="5dp"
                    android:text="@string/register_verification_code"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <EditText
                    android:id="@+id/et_yzm"
                    android:paddingLeft="5dp"
                    android:layout_width="match_parent"
                    android:layout_marginLeft="10dp"
                    android:maxLength="6"
                    android:layout_toRightOf="@+id/tv_yzm"
                    android:layout_centerVertical="true"
                    android:inputType="number"
                    style="@style/CommonEditText.White"/>
                <View
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/line3"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/line2"
                style="@style/CommonItem">
                <TextView
                    android:ellipsize="marquee"
                    android:id="@+id/tv_password"
                    android:layout_marginLeft="5dp"
                    android:text="@string/password"
                    android:layout_centerVertical="true"
                    style="@style/CommonText.ItemBlack"/>
                <EditText
                    android:id="@+id/et_password"
                    android:paddingLeft="5dp"
                    android:layout_width="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_toRightOf="@+id/tv_password"
                    android:layout_centerVertical="true"
                    android:inputType="textPassword"
                    style="@style/CommonEditText.White"/>
                <View
                    android:background="@color/set_split_line"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
    <Button
        android:id="@+id/btn_register_next"
        android:text="@string/set_complete"
        style="@style/StyleButtonYellow"/>
</LinearLayout>
