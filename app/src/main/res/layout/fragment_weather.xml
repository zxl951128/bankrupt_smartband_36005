<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/fragment_weather_0"
    android:background="@color/common_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_left"
            android:tag="binding_1"
            style="@style/TitleLeft"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:id="@+id/title_right"
            style="@style/TitleRight"/>
        <TextView
            android:id="@+id/title_center"
            android:text="@string/weather_title"
            style="@style/TitleCenter"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </RelativeLayout>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="25dp"/>
    <RelativeLayout
        android:background="@color/white"
        android:clickable="false"
        style="@style/SetItem.Padding">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:text="@string/show_weather"
            android:layout_toRightOf="@+id/icon_heart"
            android:layout_centerVertical="true"
            style="@style/CommonText.ItemBlack"/>
        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/show_weather_switch"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="@style/MaterialDesignStyle"/>
    </RelativeLayout>
    <View
        android:background="@color/white_c"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="25dp"/>
        <RelativeLayout
            android:background="@color/white"
            android:clickable="false"
            style="@style/SetItem.Padding">
            <TextView
                android:id="@+id/auto_location_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:text="@string/weather_auto_location"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/auto_location"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/MaterialDesignStyle"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_current_city"
            android:tag="binding_2"
            android:background="@drawable/selector_btn_white"
            android:clickable="true"
            style="@style/SetItem">
            <TextView
                android:id="@+id/current_city_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="12dp"
                android:text="@string/current_city"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <View
                android:background="@color/white_c"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignLeft="@+id/current_city_tip"
                android:layout_alignParentTop="true"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textColor="@color/selector_black_text"
                android:id="@+id/next"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="27dp"
                android:text="@string/icon_forward"
                android:layout_alignParentRight="true"
                style="@style/ItemIconTextRight"/>
            <TextView
                android:id="@+id/current_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/current_city_tip"
                android:layout_centerVertical="true"
                style="@style/CommonText.ItemBlack"/>
            <ProgressBar
                android:id="@+id/progress_view"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminate="true"
                android:layout_toRightOf="@+id/current_city_tip"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
</LinearLayout>
