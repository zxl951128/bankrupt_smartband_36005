<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/SetItem.Click">
    <View xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/divider"
        android:background="@color/set_split_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="@dimen/item_margin_right"
        android:layout_marginRight="@dimen/item_margin_left"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="@dimen/item_content_margin_horizontal"
        android:paddingTop="@dimen/item_content_margin_vertical"
        android:paddingRight="@dimen/item_content_margin_horizontal"
        android:paddingBottom="@dimen/item_content_margin_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/common_text_size"
            android:textColor="@color/white"
            android:id="@+id/province"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"/>
        <TextView
            android:textSize="@dimen/common_text_size"
            android:textColor="@color/white"
            android:id="@+id/area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"/>
        <TextView
            android:textSize="@dimen/common_text_size"
            android:textColor="@color/white"
            android:id="@+id/city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
