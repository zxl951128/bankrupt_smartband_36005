<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:background="@color/black_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1">
        <RelativeLayout
            android:background="@color/transparent"
            style="@style/CommonTitle">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="@dimen/common_action_bar_text_size"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/title_left"
                android:background="@drawable/selector_btn_normal"
                android:layout_width="@dimen/common_title_width"
                android:layout_height="match_parent"
                android:text="@string/icon_back"
                android:layout_alignParentLeft="true"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="@dimen/common_action_bar_text_size"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/title_right"
                android:background="@drawable/selector_btn_normal"
                android:layout_width="@dimen/common_title_width"
                android:layout_height="match_parent"
                android:text="@string/icon_back"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:lines="1"
                android:layout_toLeftOf="@+id/title_right"
                android:layout_toRightOf="@+id/title_left"
                android:layout_centerInParent="true"
                style="@style/CommonText.White"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_burn_heart"
            android:background="@color/signal_green"
            android:paddingLeft="20dp"
            android:paddingTop="7dp"
            android:paddingRight="20dp"
            android:paddingBottom="7dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <cn.ginshell.bong.ui.view.IconTextView
                android:padding="4dp"
                android:text="@string/icon_tips"
                style="@style/ItemIconText"/>
            <TextView
                android:textSize="@dimen/fit_tip_size"
                android:id="@+id/tv_burn_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/burn_heart"
                android:singleLine="false"
                style="@style/CommonText.White"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/map_view_pan"
            android:background="@color/white"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_weight="0.1">
            <com.amap.api.maps.MapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <cn.ginshell.bong.ui.view.GpsVew
                android:id="@+id/gps_signal"
                android:layout_width="50dp"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_no_connect_tip"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <cn.ginshell.bong.ui.view.IconTextView
                android:text="@string/icon_warn"
                style="@style/ItemIconText"/>
            <TextView
                android:textSize="@dimen/fit_tip_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sport_no_connect_tip"
                style="@style/CommonText.White"/>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.2"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_heart_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="42dp"
                    android:gravity="center"
                    android:id="@+id/tv_heart_rate"
                    android:layout_width="wrap_content"
                    android:minWidth="80dp"
                    android:text="@string/value_null"
                    android:layout_centerInParent="true"
                    style="@style/CommonText.White"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="30dp"
                    android:textColor="@color/red"
                    android:id="@+id/icon_heart_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_hole_heart"
                    android:layout_toLeftOf="@+id/tv_heart_rate"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="15dp"
                    android:id="@+id/bmp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_rate_unit_e"
                    android:layout_toRightOf="@+id/tv_heart_rate"
                    android:layout_alignBaseline="@+id/tv_heart_rate"
                    style="@style/CommonText.White"/>
                <cn.ginshell.bong.ui.view.IconTextView
                    android:textSize="23dp"
                    android:textColor="@color/gray"
                    android:id="@+id/icon_bmp_info"
                    android:padding="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_info"
                    android:layout_toRightOf="@+id/bmp"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <cn.ginshell.bong.ui.view.TimerTextView
                    android:textSize="@dimen/fit_large_size"
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/default_time_value"
                    style="@style/CommonText.White"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0.7"/>
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <Button
                android:id="@+id/stop_record"
                android:layout_width="60dp"
                android:layout_height="60dp"/>
            <TextView
                android:textSize="14dp"
                android:id="@+id/tv_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/press_long"
                style="@style/CommonText.White"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_click_bg"
        android:background="@color/black_bg_80"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <cn.ginshell.bong.ui.view.PieProgressView
            android:id="@+id/pie_progress"
            android:layout_width="@dimen/fit_pie_progress_size"
            android:layout_height="@dimen/fit_pie_progress_size"
            android:layout_marginTop="100dp"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_counter"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="130dp"
            android:textColor="@color/white"
            android:id="@+id/icon_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_3"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</FrameLayout>
