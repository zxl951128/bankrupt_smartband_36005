<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_corner_white"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:weightSum="2">
        <ImageView
            android:id="@+id/iv_badge_bg"
            android:layout_width="match_parent"
            android:layout_height="157dp"
            android:src="@drawable/bg_badge"
            android:scaleType="fitXY"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/iv_badge_img"
            android:layout_width="@dimen/badge_detail_width"
            android:layout_height="@dimen/badge_detail_width"
            android:layout_alignBottom="@+id/iv_badge_bg"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_custom"
            android:background="@color/average_three"
            android:visibility="gone"
            android:layout_width="@dimen/badge_detail_width"
            android:layout_height="@dimen/badge_detail_width"
            android:layout_alignBottom="@+id/iv_badge_bg"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/physical_start_color"
                android:id="@+id/tv_custom_keep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/badge_custom_keep"
                android:maxLines="1"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:id="@+id/tv_custom_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/badge_custom_sleep"
                android:maxLines="1"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/physical_start_color"
                android:id="@+id/tv_custom_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="99"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/iv_badge_bg">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/report_heart_bar_color"
                android:id="@+id/tv_badge_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:id="@+id/tv_badge_describe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:maxLines="3"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
