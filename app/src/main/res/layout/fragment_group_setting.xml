<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/fragment_group_setting_0"
    android:background="@color/white_f2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        style="@style/CommonTitle.Green">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:tag="binding_1"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/group_setting"
            android:lines="1"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            style="@style/CommonText"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:id="@+id/group_master"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <View style="@style/DividerLine"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/rl_group_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        style="@style/SetItem.TransportClick">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="@color/black"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_group_avatar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp"
                            android:text="@string/group_avatar"
                            android:layout_weight="1"/>
                        <com.facebook.drawee.view.SimpleDraweeView
                            android:id="@+id/group_avatar"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            xmlns:ns1="http://schemas.android.com/apk/res-auto" 
                            ns1:placeholderImage="@drawable/group_add_user"
                            xmlns:ns2="http://schemas.android.com/apk/res-auto" 
                            ns2:roundAsCircle="true"/>
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textColor="@color/black"
                            android:id="@+id/icon_group_avatar"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="15dp"
                            android:text="@string/icon_forward"
                            style="@style/ItemIconTextRight"/>
                    </LinearLayout>
                    <View
                        android:layout_marginLeft="15dp"
                        style="@style/DividerLine"/>
                    <RelativeLayout
                        android:id="@+id/rl_group_name"
                        android:layout_width="match_parent"
                        style="@style/SetItem.TransportClick">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_group_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp"
                            android:text="@string/group_name"
                            android:layout_centerVertical="true"/>
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textColor="@color/black"
                            android:id="@+id/icon_group_name"
                            android:visibility="invisible"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="15dp"
                            android:text="@string/icon_forward"
                            android:layout_alignParentRight="true"
                            style="@style/ItemIconTextRight"/>
                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/group_name"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:lines="1"
                            android:maxEms="12"
                            android:layout_toLeftOf="@+id/icon_group_name"/>
                        <View
                            android:layout_alignLeft="@+id/tv_group_name"
                            android:layout_alignParentBottom="true"
                            style="@style/DividerLine"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/rl_group_introduce"
                        android:layout_width="match_parent"
                        style="@style/SetItem.TransportClick">
                        <TextView
                            android:textSize="16dp"
                            android:textColor="@color/black"
                            android:id="@+id/tv_group_introduce"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp"
                            android:text="@string/group_introduce"
                            android:layout_centerVertical="true"/>
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textColor="@color/black"
                            android:id="@+id/icon_group_introduce"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="15dp"
                            android:text="@string/icon_forward"
                            android:layout_alignParentRight="true"
                            style="@style/ItemIconTextRight"/>
                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/group_introduce"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:hint="@string/no_setting"
                            android:lines="1"
                            android:maxEms="8"
                            android:layout_toLeftOf="@+id/icon_group_introduce"/>
                    </RelativeLayout>
                    <View style="@style/DividerLine"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp">
                    <View style="@style/DividerLine"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <RelativeLayout
                            android:id="@+id/rl_group_label"
                            android:layout_width="wrap_content"
                            style="@style/SetItem.TransportClick">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="@color/black"
                                android:id="@+id/tv_group_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="15dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/group_label"
                                android:layout_centerVertical="true"/>
                            <cn.ginshell.bong.ui.view.IconTextView
                                android:textColor="@color/black"
                                android:id="@+id/icon_group_label"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/icon_forward"
                                android:layout_alignParentRight="true"
                                style="@style/ItemIconTextRight"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/label_contain"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toLeftOf="@+id/icon_group_label"
                                android:layout_centerVertical="true"/>
                            <View
                                android:layout_alignLeft="@+id/tv_group_label"
                                android:layout_alignParentBottom="true"
                                style="@style/DividerLine"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/rl_group_notice"
                            android:layout_width="match_parent"
                            style="@style/SetItem.TransportClick">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="@color/black"
                                android:id="@+id/tv_group_notice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="15dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/group_notice"
                                android:layout_centerVertical="true"/>
                            <cn.ginshell.bong.ui.view.IconTextView
                                android:textColor="@color/black"
                                android:id="@+id/icon_group_notice"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/icon_forward"
                                android:layout_alignParentRight="true"
                                style="@style/ItemIconTextRight"/>
                            <TextView
                                android:textSize="15dp"
                                android:textColor="@color/black"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:id="@+id/group_notice"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:hint="@string/no_setting"
                                android:lines="1"
                                android:maxEms="12"
                                android:layout_toLeftOf="@+id/icon_group_notice"/>
                            <View
                                android:layout_alignLeft="@+id/tv_group_notice"
                                android:layout_alignParentBottom="true"
                                style="@style/DividerLine"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/rl_group_address"
                            android:layout_width="match_parent"
                            style="@style/SetItem.TransportClick">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="@color/black"
                                android:id="@+id/tv_group_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="15dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/group_address"
                                android:layout_centerVertical="true"/>
                            <cn.ginshell.bong.ui.view.IconTextView
                                android:textColor="@color/black"
                                android:id="@+id/icon_group_address"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/icon_forward"
                                android:layout_alignParentRight="true"
                                style="@style/ItemIconTextRight"/>
                            <TextView
                                android:textSize="15dp"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:id="@+id/group_address"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:lines="1"
                                android:layout_toLeftOf="@+id/icon_group_address"/>
                            <View
                                android:layout_alignLeft="@+id/tv_group_address"
                                android:layout_alignParentBottom="true"
                                style="@style/DividerLine"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            style="@style/SetItem.TransportClick">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="@color/black"
                                android:id="@+id/tv_group_add_auth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="15dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/group_add_auth"
                                android:layout_centerVertical="true"/>
                            <com.kyleduo.switchbutton.SwitchButton
                                android:id="@+id/add_group_auth"
                                android:padding="16px"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginRight="10dp"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                style="@style/MaterialDesignStyle"/>
                        </RelativeLayout>
                        <View
                            android:layout_alignParentBottom="true"
                            style="@style/DividerLine"/>
                    </LinearLayout>
                    <View style="@style/DividerLine"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="70dp">
                    <View style="@style/DividerLine"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/rl_group_nickname"
                            android:layout_width="match_parent"
                            style="@style/SetItem.TransportClick">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="@color/black"
                                android:id="@+id/tv_group_nickname"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="15dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/group_nickname"
                                android:layout_centerVertical="true"/>
                            <cn.ginshell.bong.ui.view.IconTextView
                                android:textColor="@color/black"
                                android:id="@+id/icon_group_nickname"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/icon_forward"
                                android:layout_alignParentRight="true"
                                style="@style/ItemIconTextRight"/>
                            <TextView
                                android:textSize="15dp"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:id="@+id/group_nickname"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:lines="1"
                                android:layout_toLeftOf="@+id/icon_group_nickname"/>
                            <View
                                android:layout_alignLeft="@+id/tv_group_nickname"
                                android:layout_alignParentBottom="true"
                                style="@style/DividerLine"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/rl_members_manage"
                            android:layout_width="match_parent"
                            style="@style/SetItem.TransportClick">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="@color/black"
                                android:id="@+id/tv_group_members_manage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="15dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/group_members_manage"
                                android:layout_centerVertical="true"/>
                            <cn.ginshell.bong.ui.view.IconTextView
                                android:textColor="@color/black"
                                android:id="@+id/icon_group_members_manage"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/icon_forward"
                                android:layout_alignParentRight="true"
                                style="@style/ItemIconTextRight"/>
                            <TextView
                                android:textSize="12dp"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:id="@+id/group_members_manage"
                                android:background="@drawable/group_members_manage_circle"
                                android:visibility="gone"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:maxEms="3"
                                android:layout_centerVertical="true"
                                android:layout_toStartOf="@+id/icon_group_members_manage"/>
                            <View
                                android:layout_alignLeft="@+id/tv_group_members_manage"
                                android:layout_alignParentBottom="true"
                                style="@style/DividerLine"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/rl_transfer_group"
                            android:layout_width="match_parent"
                            style="@style/SetItem.TransportClick">
                            <TextView
                                android:textSize="16dp"
                                android:textColor="@color/black"
                                android:id="@+id/tv_transfer_group"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="15dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/transfer_group"
                                android:layout_centerVertical="true"/>
                            <cn.ginshell.bong.ui.view.IconTextView
                                android:textColor="@color/black"
                                android:id="@+id/icon_transfer_group"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="15dp"
                                android:text="@string/icon_forward"
                                android:layout_alignParentRight="true"
                                style="@style/ItemIconTextRight"/>
                        </RelativeLayout>
                        <View
                            android:layout_alignParentBottom="true"
                            style="@style/DividerLine"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_exit_group"
            android:visibility="gone"
            android:text="@string/exit_group"
            android:layout_weight="1"
            android:layout_alignParentBottom="true"
            style="@style/StyledButtonGreen"/>
        <RelativeLayout
            android:id="@+id/member_setting"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true">
            <View
                android:id="@+id/line_one"
                android:layout_marginTop="20dp"
                android:layout_alignParentTop="true"
                style="@style/DividerLine"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_group"
                android:background="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/line_one">
                <RelativeLayout
                    android:id="@+id/rl_member_nickname"
                    android:layout_width="match_parent"
                    style="@style/SetItem.TransportClick">
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_member_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="15dp"
                        android:text="@string/group_nickname"
                        android:layout_centerVertical="true"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/black"
                        android:id="@+id/icon_member_nickname"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="15dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/member_nickname"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:hint="@string/group_name_limit"
                        android:lines="1"
                        android:layout_toLeftOf="@+id/icon_member_nickname"/>
                    <View
                        android:layout_alignLeft="@+id/tv_member_nickname"
                        android:layout_alignParentBottom="true"
                        style="@style/DividerLine"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_member_list"
                    android:layout_width="match_parent"
                    style="@style/SetItem.TransportClick">
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/black"
                        android:id="@+id/tv_member_list"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="15dp"
                        android:text="@string/members_list"
                        android:layout_centerVertical="true"/>
                    <cn.ginshell.bong.ui.view.IconTextView
                        android:textColor="@color/black"
                        android:id="@+id/icon_member_list"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="15dp"
                        android:text="@string/icon_forward"
                        android:layout_alignParentRight="true"
                        style="@style/ItemIconTextRight"/>
                </RelativeLayout>
            </LinearLayout>
            <View
                android:id="@+id/line_two"
                android:layout_below="@+id/ll_group"
                style="@style/DividerLine"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/line_two"
                android:layout_alignParentStart="true">
                <View style="@style/DividerLine"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="15dp"
                    android:text="@string/group_introduce"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/white_3"
                    android:textColorHint="@color/white_6"
                    android:ellipsize="end"
                    android:gravity="top|left"
                    android:id="@+id/edit_member_introduce"
                    android:background="@null"
                    android:paddingLeft="15dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:lineSpacingMultiplier="1.4"/>
                <View style="@style/DividerLine"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_fail"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/img_fail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:src="@drawable/nodata"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:id="@+id/error_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/group_setting_fail"
                android:layout_below="@+id/img_fail"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
