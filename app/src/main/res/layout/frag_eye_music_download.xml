<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/frag_eye_music_download_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        android:background="@color/white"
        style="@style/CommonTitle">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:gravity="center"
            android:id="@+id/title_left"
            android:tag="binding_1"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="20dp"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/relax_music_list"
            android:lines="1"
            android:layout_toLeftOf="@+id/icon_setting"
            android:layout_centerInParent="true"
            style="@style/CommonText"/>
        <View
            android:id="@+id/line2"
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="67dp"
            android:layout_marginBottom="10dp"
            android:text="@string/music_name"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="45dp"
            android:layout_marginBottom="10dp"
            android:text="@string/music_manager"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/line"
        android:background="@color/user_item_line"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_alignParentBottom="true"/>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/rl_music_list"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
