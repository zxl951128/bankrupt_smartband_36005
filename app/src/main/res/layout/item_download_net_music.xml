<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:id="@+id/rl_content"
    android:tag="layout/item_download_net_music_0"
    android:background="@drawable/selector_btn_purple"
    android:layout_width="match_parent"
    android:layout_height="@dimen/common_item_height"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp">
    <cn.ginshell.bong.ui.view.IconTextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="20dp"
        android:gravity="center"
        android:id="@+id/icon_music"
        android:background="@drawable/selector_btn_normal"
        android:layout_width="@dimen/common_title_width"
        android:layout_height="match_parent"
        android:text="@string/icon_song"
        android:layout_alignParentLeft="true"/>
    <TextView
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tv_music_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxEms="11"
        android:singleLine="true"
        android:layout_toRightOf="@+id/icon_music"
        android:layout_centerVertical="true"
        style="@style/CommonText.ItemPurple"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textSize="20dp"
        android:gravity="center"
        android:id="@+id/icon_download"
        android:background="@drawable/selector_btn_normal"
        android:visibility="visible"
        android:layout_width="@dimen/common_title_width"
        android:layout_height="match_parent"
        android:layout_marginRight="18dp"
        android:text="@string/icon_download"
        android:layout_alignParentRight="true"/>
    <cn.ginshell.bong.widget.CircleProgressView
        android:id="@+id/pb_music_download"
        android:visibility="visible"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginRight="30dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        style="@android:style/Widget.ProgressBar.Large"/>
    <cn.ginshell.bong.ui.view.IconTextView
        android:textSize="20dp"
        android:textColor="@color/purple_bg"
        android:gravity="center"
        android:id="@+id/icon_downloaded"
        android:background="@drawable/selector_btn_normal"
        android:layout_width="@dimen/common_title_width"
        android:layout_height="match_parent"
        android:layout_marginRight="18dp"
        android:text="@string/icon_h_success"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
