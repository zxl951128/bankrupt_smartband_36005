<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_physical_test"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_title_height">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/left"
            android:background="@drawable/selector_set_item_bg"
            android:clickable="true"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="@dimen/common_title_height"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_back"/>
        </LinearLayout>
        <TextView
            android:textSize="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/physical_test_str"
            android:layout_centerInParent="true"
            style="@style/CommonText.White"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/right"
            android:background="@drawable/selector_set_item_bg"
            android:clickable="true"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="@dimen/common_title_height"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="20dp"
                android:textColor="@color/white"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_share"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_no_user_data"
        android:paddingLeft="25dp"
        android:paddingRight="25dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/physical_test_ad1"
            style="@style/CommonText.White"/>
        <TextView
            android:textSize="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/physical_test_ad2"
            android:singleLine="false"
            style="@style/CommonText.White"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_have_data"
        android:paddingLeft="25dp"
        android:paddingRight="25dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="55dp"
            android:id="@+id/user_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24"
            style="@style/CommonText.White"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white_tip2"
            android:text="@string/physical_body_year"
            style="@style/CommonText.Tip"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/physical_test_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="1">
                    <cn.ginshell.bong.ui.view.BalanceView
                        android:id="@+id/balance_view"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.8"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-20dp">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="15dp">
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textSize="30dp"
                            android:textColor="@color/average_one"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/icon_status"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="@color/average_one"
                            android:text="@string/physical_average"
                            android:singleLine="false"
                            style="@style/CommonText.White"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:id="@+id/ll_personal_tip"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp">
                        <cn.ginshell.bong.ui.view.IconTextView
                            android:textSize="30dp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/icon_status"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="@color/white"
                            android:text="@string/physical_personal"
                            android:singleLine="false"
                            style="@style/CommonText.White"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <Button
            android:id="@+id/btn_start_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="15dp"
            android:text="@string/physical_start_test"
            style="@style/StyleButtonWhite"/>
    </LinearLayout>
</LinearLayout>
