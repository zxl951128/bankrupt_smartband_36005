<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:tag="layout/act_choose_music_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/action_bar_common"
        android:background="@color/white"
        style="@style/CommonTitle">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:gravity="center"
            android:id="@+id/title_left"
            android:background="@drawable/selector_btn_normal"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_back"
            android:layout_alignParentLeft="true"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="20dp"
            android:gravity="center"
            android:id="@+id/icon_setting"
            android:background="@drawable/selector_btn_normal"
            android:visibility="visible"
            android:layout_width="@dimen/common_title_width"
            android:layout_height="match_parent"
            android:text="@string/icon_setting"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="20dp"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/music"
            android:lines="1"
            android:layout_toLeftOf="@+id/icon_setting"
            android:layout_toRightOf="@+id/title_left"
            android:layout_centerInParent="true"
            style="@style/CommonText"/>
        <View
            android:id="@+id/line2"
            android:layout_alignParentBottom="true"
            style="@style/DividerLine"/>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/linear_layout"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_item_height"
        android:layout_below="@+id/action_bar_common">
        <RelativeLayout
            android:id="@+id/relax_tab_rela"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="15dp"
                android:textColor="@color/purple_bg"
                android:gravity="center"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="@string/icon_music"
                android:layout_toLeftOf="@+id/relax_music_tab"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/purple_bg"
                android:gravity="center"
                android:id="@+id/relax_music_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/relax_music"
                android:layout_centerInParent="true"/>
            <TextView
                android:id="@+id/divide_line_relax"
                android:background="@drawable/choose_music_rect"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/back_tab_rela"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="15dp"
                android:textColor="@color/purple_bg"
                android:gravity="center"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="@string/icon_bgm"
                android:layout_toLeftOf="@+id/back_music_tab"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/purple_bg"
                android:gravity="center"
                android:id="@+id/back_music_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/background_music"
                android:layout_centerInParent="true"/>
            <TextView
                android:id="@+id/divide_line_back"
                android:background="@drawable/choose_music_rect"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/relative_layout"
        android:layout_below="@+id/linear_layout"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:id="@+id/relative_layout"
        android:background="@color/purple_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_item_height"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="18dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/relax_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="@dimen/item_margin_left"
                android:text="@string/icon_music"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/relax_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="@string/relax_music"
                android:layout_toRightOf="@+id/relax_icon"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <cn.ginshell.bong.ui.view.IconTextView
                android:textSize="18dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/icon_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="45dp"
                android:text="@string/icon_bgm"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/back_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="@string/back_close"
                android:layout_toRightOf="@+id/icon_back"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:background="@drawable/music_controller_circle"
            android:layout_width="60dp"
            android:layout_height="60dp"/>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/music_controller"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="@string/icon_btn_play"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
