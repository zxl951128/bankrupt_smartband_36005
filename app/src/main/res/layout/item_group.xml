<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/item_group_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/group_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="15dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/group_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                xmlns:ns1="http://schemas.android.com/apk/res-auto" 
                ns1:placeholderImage="@drawable/img_group_official"
                xmlns:ns2="http://schemas.android.com/apk/res-auto" 
                ns2:roundAsCircle="true"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="bottom|right"
                android:id="@+id/select_indicator"
                android:background="@drawable/round_green_small_cover_bg"
                android:paddingLeft="2dp"
                android:paddingTop="1dp"
                android:paddingRight="2dp"
                android:paddingBottom="1dp"
                android:layout_width="33dp"
                android:layout_height="15dp"
                android:text="@string/group_official"/>
        </FrameLayout>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/group_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="华东跑渣群"
            android:maxLines="1"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white_9"
            android:ellipsize="start"
            android:id="@+id/group_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="1223人"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
