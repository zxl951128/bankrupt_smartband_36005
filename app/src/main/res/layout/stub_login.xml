<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical"
    android:tag="layout/stub_login_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textSize="@dimen/fit_tip_size"
        android:textColor="@color/white"
        android:id="@+id/phone_num_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_horizontal_margin"
        android:text="@string/phone_number"
        xmlns:ns1="http://schemas.android.com/apk/res-auto" 
        ns1:layout_constraintLeft_toLeftOf="@+id/country_code"
        xmlns:ns2="http://schemas.android.com/apk/res-auto" 
        ns2:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/common_text_size"
        android:textColor="@color/green_1"
        android:gravity="center"
        android:id="@+id/country_code"
        android:tag="binding_1"
        android:background="@color/white"
        android:paddingLeft="15dp"
        android:paddingTop="10dp"
        android:paddingRight="15dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_horizontal_margin"
        android:layout_marginTop="8dp"
        android:minWidth="60dp"
        android:text="+86"
        android:layout_marginStart="@dimen/common_horizontal_margin"
        xmlns:ns3="http://schemas.android.com/apk/res-auto" 
        ns3:layout_constraintLeft_toLeftOf="parent"
        xmlns:ns4="http://schemas.android.com/apk/res-auto" 
        ns4:layout_constraintTop_toBottomOf="@+id/phone_num_tip"/>
    <android.support.v7.widget.AppCompatEditText
        android:id="@+id/login_name"
        android:inputType="phone"
        android:imeOptions="actionNext"
        android:nextFocusForward="@+id/password"
        xmlns:ns5="http://schemas.android.com/apk/res-auto" 
        ns5:layout_constraintBaseline_toBaselineOf="@+id/country_code"
        xmlns:ns6="http://schemas.android.com/apk/res-auto" 
        ns6:layout_constraintLeft_toRightOf="@+id/country_code"
        xmlns:ns7="http://schemas.android.com/apk/res-auto" 
        ns7:layout_constraintRight_toRightOf="parent"
        style="@style/AccountEditor.Phone"/>
    <android.support.v7.widget.AppCompatEditText
        android:id="@+id/password"
        android:paddingLeft="@dimen/common_horizontal_margin"
        android:paddingRight="80dp"
        android:layout_marginTop="30dp"
        android:inputType="textPassword"
        android:imeOptions="actionDone"
        xmlns:ns8="http://schemas.android.com/apk/res-auto" 
        ns8:layout_constraintLeft_toLeftOf="parent"
        xmlns:ns9="http://schemas.android.com/apk/res-auto" 
        ns9:layout_constraintRight_toRightOf="parent"
        xmlns:ns10="http://schemas.android.com/apk/res-auto" 
        ns10:layout_constraintTop_toBottomOf="@+id/country_code"
        style="@style/AccountEditor"/>
    <TextView
        android:textSize="@dimen/common_text_size"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_find_password"
        android:tag="binding_2"
        android:paddingLeft="15dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/login_forget_password"
        xmlns:ns11="http://schemas.android.com/apk/res-auto" 
        ns11:layout_constraintBottom_toBottomOf="@+id/password"
        xmlns:ns12="http://schemas.android.com/apk/res-auto" 
        ns12:layout_constraintRight_toRightOf="@+id/password"
        xmlns:ns13="http://schemas.android.com/apk/res-auto" 
        ns13:layout_constraintTop_toTopOf="@+id/password"/>
    <TextView
        android:textSize="@dimen/fit_tip_size"
        android:textColor="@color/white"
        android:id="@+id/password_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_horizontal_margin"
        android:text="@string/password"
        xmlns:ns14="http://schemas.android.com/apk/res-auto" 
        ns14:layout_constraintBottom_toTopOf="@+id/password"
        xmlns:ns15="http://schemas.android.com/apk/res-auto" 
        ns15:layout_constraintLeft_toLeftOf="@+id/password"/>
</android.support.constraint.ConstraintLayout>
