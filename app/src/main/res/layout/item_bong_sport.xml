<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="match_parent"
    android:layout_height="@dimen/bong_day_first_item_height">
    <View xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/left_field"
        android:layout_width="@dimen/bong_day_left_width"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:alpha="@integer/bong_day_left_field_alpha"/>
    <View
        android:id="@+id/wide_divider"
        android:layout_width="@dimen/bong_day_wide_divider_width"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/left_field"/>
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/bong_day_time_margin_right"
        android:layout_toLeftOf="@+id/wide_divider"
        android:layout_alignParentTop="true"
        android:translationY="-10dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/wide_divider">
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/icon_size"
            android:id="@+id/activity_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bong_content_margin_left"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/bong_item_content"
            android:paddingLeft="70dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/drop_down"
            android:layout_alignParentLeft="true">
            <TextView
                android:textSize="@dimen/common_text_size"
                android:textColor="@color/black"
                android:gravity="center_vertical"
                android:id="@+id/bong_activity_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <cn.ginshell.bong.ui.view.IconTextView
                android:textColor="@color/black"
                android:id="@+id/bong_block_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/icon_detail"
                android:layout_toRightOf="@+id/bong_activity_text"
                android:layout_alignBaseline="@+id/bong_activity_text"/>
            <TextView
                android:textSize="@dimen/bong_item_info_text_size"
                android:textColor="@color/bong_item_info_color"
                android:gravity="center_vertical"
                android:id="@+id/info_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_below="@+id/bong_activity_text"
                android:layout_alignLeft="@+id/bong_activity_text"/>
        </RelativeLayout>
        <cn.ginshell.bong.ui.view.IconTextView
            android:textSize="@dimen/icon_size"
            android:textColor="@color/black"
            android:gravity="end|center_vertical"
            android:id="@+id/drop_down"
            android:paddingLeft="10dp"
            android:paddingRight="@dimen/bong_day_item_margin_right"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/icon_unfold"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <View
            android:background="@color/white_c"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginRight="@dimen/bong_day_item_margin_right"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
