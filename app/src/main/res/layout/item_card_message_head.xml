<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:background="@color/black_bg"
    android:padding="@dimen/card_top_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView xmlns:android="http://schemas.android.com/apk/res/android"
        android:textColor="@color/white_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/message_tip"/>
    <ImageView
        android:background="@color/btn_bg_yellow"
        android:padding="1px"
        android:layout_width="@dimen/card_img_width"
        android:layout_height="@dimen/card_img_height"
        android:src="@drawable/card_message"
        android:scaleType="fitXY"
        android:layout_centerInParent="true"/>
</RelativeLayout>
