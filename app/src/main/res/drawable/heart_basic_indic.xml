<?xml version="1.0" encoding="utf-8"?>
<layer-list>
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android"  android:shape="rectangle">
            <solid xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/transparent"/>
            <size
                android:height="15dp"
                android:width="15dp"/>
            <stroke
                android:width="1px"
                android:color="@color/white"/>
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/white"/>
            <size
                android:height="5dp"
                android:width="5dp"/>
        </shape>
    </item>
</layer-list>
