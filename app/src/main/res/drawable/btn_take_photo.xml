<?xml version="1.0" encoding="utf-8"?>
<layer-list>
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android"  android:shape="oval">
            <solid xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/white"/>
        </shape>
    </item>
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/green_1"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/green_1"
                android:dashWidth="0dp"/>
        </shape>
    </item>
</layer-list>
