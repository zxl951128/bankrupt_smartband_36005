<?xml version="1.0" encoding="utf-8"?>
<selector>
    <item xmlns:android="http://schemas.android.com/apk/res/android"  android:state_pressed="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android">
            <stroke
                android:width="2px"
                android:color="@color/btn_yellow_pressed"/>
            <gradient
                android:startColor="@color/gray"
                android:endColor="@color/gray"
                android:angle="270"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <gradient
                android:startColor="@color/gray"
                android:endColor="@color/btn_yellow"
                android:angle="270"/>
            <stroke
                android:width="2px"
                android:color="@color/btn_yellow_pressed"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="@color/red"
                android:endColor="@color/btn_yellow"
                android:angle="270"/>
            <stroke
                android:width="2px"
                android:color="@color/btn_yellow"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
</selector>
