<?xml version="1.0" encoding="utf-8"?>
<selector>
    <item
        xmlns:android="http://schemas.android.com/apk/res/android" 
        android:state_enabled="false"
        android:drawable="@drawable/switch_thumb_disable"/>
    <item xmlns:android="http://schemas.android.com/apk/res/android"
        android:state_checked="true"
        android:state_pressed="true"
        android:drawable="@drawable/switch_thumb_on_pressed"/>
    <item
        android:state_focused="true"
        android:state_checked="true"
        android:drawable="@drawable/switch_thumb_on_pressed"/>
    <item
        android:state_checked="true"
        android:drawable="@drawable/switch_thumb_on_normal"/>
    <item
        android:state_checked="false"
        android:state_pressed="true"
        android:drawable="@drawable/switch_thumb_off_pressed"/>
    <item
        android:state_focused="true"
        android:state_checked="false"
        android:drawable="@drawable/switch_thumb_off_pressed"/>
    <item
        android:state_checked="false"
        android:drawable="@drawable/switch_thumb_off_normal"/>
</selector>
