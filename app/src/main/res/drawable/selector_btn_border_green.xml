<?xml version="1.0" encoding="utf-8"?>
<selector>
    <item xmlns:android="http://schemas.android.com/apk/res/android"  android:state_pressed="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android">
            <gradient
                android:startColor="@color/green_3"
                android:endColor="@color/green_3"
                android:angle="270"/>
            <stroke
                android:width="1dp"
                android:color="@color/green_4"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <gradient
                android:startColor="@color/white_f7"
                android:endColor="@color/white_f7"
                android:angle="270"/>
            <stroke
                android:width="1dp"
                android:color="@color/white_c"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="@color/green_1"
                android:endColor="@color/green_1"
                android:angle="270"/>
            <stroke
                android:width="1dp"
                android:color="@color/green_4"/>
        </shape>
    </item>
</selector>
